// Heirs: upbringing, marriage, disputes, death. An heir's children before his wedding are
// bastards (sim::born_before), so heir_marriage comes often, until 50. Upbringing, marriage and death target a
// random heir of the right age (`{heir}`); disputes address heirs by index: heirs[0] is the
// first heir (the eldest, newborns are appended), heirs[1] the second.
[
    (
        id: "heir_tutor",
        title: "Воспитатель наследника",
        text: "{heir} подрастает: уже читает по складам и рубит деревянным мечом крапиву за конюшней. При дворе спорят, кому доверить воспитание.",
        texts: [
            "Пора учить {heir.вин} всерьёз. Епископ хвалит монастырскую школу, старые рыцари зовут на ристалище, а казначей морщится от одной мысли о заморском учителе.",
            "Няньки больше не справляются с {heir.тв}. Двор ждёт, в чьи руки отдадут ребёнка: от этого зависит, кем {heir} вырастет и кому будет верить.",
        ],
        when: All([]),
        weight: 6,
        once: false,
        cooldown_years: 4,
        importance: 3,
        sign: Good,
        target: Heir(6, 12),
        choices: [
            (
                text: "Отдать в монастырскую школу",
                effects: [HeirOp(TargetStatus(Studying("Монастырь"))), Axis("loyalty_church", 5)],
                cause_tag: "tutor_church",
                hint: "Монахи вырастят книжника, а не воина.",
                told: "{heir} {heir:подрос|подросла}, и {heir:его|её} отдали в монастырскую школу, где учили псалтирь, счёт и смирение.",
                retold: [
                    "{heir.вин} отвезли в обитель за рекой: там {heir:он|она} {heir:вставал|вставала} к заутрене и при свече {heir:переписывал|переписывала} жития.",
                    "Воспитание {heir.род} доверили монахам, и потом при дворе говорили, что {heir:он|она} лучше знает святцы, чем конскую сбрую.",
                ],
            ),
            (
                text: "Поручить старому рыцарю",
                effects: [HeirOp(TargetAbility(5)), Axis("loyalty_nobles", 5)],
                cause_tag: "tutor_knight",
                hint: "Знать увидит в наследнике своего.",
                told: "Воспитание {heir.род} поручили старому рыцарю, и тот начал с того, что выбросил из детской все книжки с картинками.",
                retold: [
                    "{heir} {heir:рос|росла} при старом рыцаре, который учил держать меч, не бояться крови и помнить гербы всех баронских домов.",
                    "Наставником {heir.род} стал седой рубака с ристалища, и скоро {heir} {heir:держался|держалась} в седле лучше иных оруженосцев.",
                ],
            ),
            (
                text: "Пригласить учёного из-за моря",
                effects: [HeirOp(TargetAbility(10)), Axis("treasury", -40), Axis("loyalty_church", -3)],
                cause_tag: "tutor_scholar",
                hint: "Учёный из-за моря научит многому, но не любви к своим.",
                told: "Для {heir.род} пригласили учёного наставника из-за моря, и тот привёз с собой сундук книг и астролябию.",
                retold: [
                    "{heir} {heir:засиживался|засиживалась} с заморским учителем до полуночи над картами чужих земель, и при дворе ворчали, что ребёнок забывает родную речь.",
                    "Учёный чужеземец учил {heir.вин} языкам, счёту и звёздам; клир косился на его книги, а казначей на его жалованье.",
                ],
            ),
        ],
    ),
    (
        id: "heir_marriage",
        title: "Брак наследника",
        text: "{heir} {heir:вошёл|вошла} в года, и сваты уже в пути. Соседние дворы шлют портреты и росписи приданого, а бароны напоминают о своих детях на выданье.",
        texts: [
            "Во дворце пахнет свадьбой: у ворот стоят кони чужих сватов, а в покоях {heir.род} примеряют праздничное платье. Остаётся решить, с кем родниться короне.",
            "{heir:Пора женить|Пора выдавать замуж} {heir.вин}. Канцлер разложил на столе гербы соседних домов, и у каждого герба своя цена.",
        ],
        when: All([]),
        weight: 100,
        once: false,
        cooldown_years: 1,
        importance: 3,
        sign: Good,
        target: UnmarriedHeir(14, 50),
        choices: [
            (
                text: "Искать пару при чужеземном дворе",
                effects: [HeirOp(TargetMarry), Axis("prestige", 10), Axis("loyalty_nobles", -3), Axis("treasury", -20)],
                cause_tag: "heir_married_foreign",
                hint: "Чужеземный брак приводит ко двору чужих советников.",
                told: "{heir} {heir:взял в жёны дочь|вышла замуж за сына} чужеземного государя, и о королевском доме заговорили при дальних дворах.",
                retold: [
                    "{heir:Невеста приехала|Жених приехал} из-за рубежа с обозом сундуков и свитой, говорившей на чужом языке, и {heir} {heir:обвенчался|обвенчалась} в соборе при всех послах.",
                    "Чужеземный брак {heir.род} скрепили договором и обменом подарков, и при дворе появились новые лица, с чужими обычаями и чужими советами.",
                ],
            ),
            (
                text: "Искать пару среди своих баронов",
                effects: [HeirOp(TargetMarry), Axis("loyalty_nobles", 5), HeirOp(TargetClaim(5)), Axis("treasury", -20)],
                cause_tag: "heir_married_noble",
                hint: "Род, породнившийся с короной, захочет большего.",
                told: "{heir} {heir:взял в жёны дочь|вышла замуж за сына} одного из баронов королевства, и знать породнилась с короной.",
                retold: [
                    "{heir} {heir:обвенчался|обвенчалась} с отпрыском старого баронского рода, и три дня в замке новой родни пили за здоровье молодых.",
                    "Корона породнилась со своим бароном: брак {heir.род} обрадовал знать и встревожил тех, кому этот род был не другом.",
                ],
            ),
            (
                text: "Повременить со свадьбой",
                effects: [Axis("prestige", -2)],
                cause_tag: "heir_marriage_delayed",
                hint: "Свадьба, отложенная надолго, может не состояться вовсе.",
                told: "Сваты приезжали к {heir.дат}, но свадьбу отложили, и подарки до поры убрали в сундуки.",
                retold: [
                    "Сватам учтиво отказали до весны, и {heir} ещё год {heir:ходил|ходила} в {heir:женихах|невестах}.",
                    "Брак {heir.род} отложили: при дворе решили, что спешить некуда, а сваты уехали обиженными.",
                ],
            ),
        ],
    ),
    (
        // An unmarried ruler (no heirs.married_flag): mostly a ruler crowned before his
        // heir_marriage came. Without it births are rare (heirs.unmarried).
        id: "ruler_marriage",
        title: "Брак на троне",
        text: "Престол пустует наполовину: у {ruler.род} нет супруга, и колыбели во дворце стоят без дела. {neighbour} присылает сватов, а бароны наперебой предлагают своих.",
        texts: [
            "Епископ напоминает с амвона, что наследник не родится без венчания. В приёмной уже ждут сваты {neighbour.род} с подарками.",
            "{ruler} всё ещё {ruler:холост|не замужем}, и двор считает годы. Сваты из {neighbour.род} привезли портрет в золочёной раме и грамоту о приданом.",
        ],
        when: NotFlag("married"),
        weight: 40,
        once: false,
        cooldown_years: 2,
        importance: 3,
        sign: Good,
        target: Neighbour,
        choices: [
            (
                text: "Принять сватов из-за границы",
                effects: [Marry(
                    then: [Relation(EventTarget, 20), Axis("prestige", 5)],
                    otherwise: [Relation(EventTarget, -5), Axis("prestige", -5), SpawnEvent("marriage_refused", 0)],
                )],
                cause_tag: "ruler_married_foreign",
                hint: "Брак с чужим двором роднит корону с соседом, пока жив супруг и нет войны.",
                told: "{ruler} {ruler:отправил|отправила} ответных сватов ко двору {neighbour.род}, и посольство увезло с собой перстень и обещания.",
                retold: [
                    "Сватовство {neighbour.род} приняли благосклонно, и к соседнему двору снарядили посольство с дарами, договариваться о свадьбе.",
                    "В столицу {neighbour.род} поскакали гонцы с ответом: корона готова родниться, если сойдутся в приданом.",
                ],
            ),
            (
                text: "Породниться с домом своего барона",
                effects: [SetFlag("married"), Axis("loyalty_nobles", 5), Axis("prestige", -3)],
                cause_tag: "ruler_married_noble",
                hint: "Барон, ставший роднёй короны, ждёт милостей.",
                told: "{ruler} {ruler:породнился|породнилась} с домом одного из своих баронов, и вся родня новобрачных съехалась ко двору за милостями.",
                retold: [
                    "{ruler} {ruler:обвенчался|обвенчалась} с отпрыском старого баронского рода, и заморских послов на свадьбу даже не звали.",
                    "Свадьбу {ruler.род} сыграли дома: корона выбрала своих, и баронский род в одночасье стал королевской роднёй.",
                ],
            ),
            (
                text: "Повременить со свадьбой",
                effects: [Axis("prestige", -2)],
                cause_tag: "ruler_marriage_delayed",
                hint: "Без свадьбы у престола мало наследников.",
                told: "Двор ждал королевской свадьбы, но {ruler} {ruler:повременил|повременила} с браком.",
                retold: [
                    "Сватов {neighbour.род} проводили с почётом и без ответа: {ruler} не {ruler:спешил|спешила} под венец.",
                    "{ruler} {ruler:отложил|отложила} свадьбу ещё на год, и епископ снова говорил с амвона о пустых колыбелях.",
                ],
            ),
        ],
    ),
    (
        // After a suit turned down (marry_neighbour, Effect::Marry); its costs are the
        // suit's `otherwise`.
        id: "marriage_refused",
        title: "{neighbour} отверг сватовство",
        text: "Сваты вернулись ни с чем: {neighbour} не отдаёт руки за наш дом. Подарки отосланы назад нераспечатанными, и при соседних дворах уже судачат.",
        texts: [
            "Посольство вернулось раньше срока, с теми же сундуками. {neighbour} {neighbour:ответил|ответила} учтиво, но твёрдо: союза не будет.",
            "В чужой столице сватов продержали в приёмной три дня и отпустили с пустыми руками. Об отказе {neighbour.род} уже поют на ярмарках.",
        ],
        when: All([]),
        weight: 0,
        once: false,
        cooldown_years: 0,
        importance: 4,
        sign: Bad,
        target: None,
        choices: [
            (
                text: "Стерпеть обиду и промолчать",
                effects: [],
                cause_tag: "marriage_refused",
                hint: "Отказ запоминают при всех дворах.",
                told: "Сваты вернулись ни с чем: {neighbour} {neighbour:отказал|отказала} королевскому дому, и при соседних дворах долго об этом судачили.",
                retold: [
                    "{neighbour} {neighbour:отверг|отвергла} сватовство, и корона проглотила обиду молча; подарки так и стояли в сундуках нераспечатанными.",
                    "Отказ {neighbour.род} долго поминали на чужих пирах, и королевские сваты больше не ездили в ту сторону.",
                ],
            ),
        ],
    ),
    (
        // Fires when the claims of the first two heirs are close: rare under primogeniture
        // (the rightful heir's claim 90, the rest 35: after a quarrel won by the younger),
        // frequent without a law.
        id: "heir_dispute",
        title: "Спор наследников",
        text: "Двое королевских детей не уступают друг другу. У каждого своя свита, свои бароны и свой духовник, и на пирах их сажают в разные концы стола.",
        texts: [
            "Спор о праве на престол вышел за двери покоев: на улицах столицы дерутся слуги двух наследников, а бароны выбирают, чью руку целовать.",
            "Один ссылается на закон и первородство, другой на любовь войска и баронов. Двор раскололся надвое, и все ждут, что скажет {ruler}.",
        ],
        when: All([HeirAge(1, 14, 99), ClaimGapBelow(45)]),
        weight: 8,
        once: false,
        cooldown_years: 5,
        importance: 4,
        target: None,
        choices: [
            (
                // Designate costs heirs.designate_penalty when the law names the other.
                text: "Назначить наследником старшего",
                effects: [HeirOp(Designate(0)), HeirOp(Claim(0, 20)), HeirOp(Claim(1, -15)), Axis("loyalty_nobles", 3)],
                cause_tag: "dispute_elder",
                hint: "Обойдённый не забывает обиды.",
                told: "Двое королевских детей спорили о праве на престол, и {ruler} {ruler:назвал|назвала} наследником старшего.",
                retold: [
                    "Спор наследников {ruler} {ruler:решил|решила} по старшинству: перед всем двором старшему поднесли меч, а младшему велели поклониться.",
                    "{ruler} {ruler:встал|встала} на сторону старшего из детей, и сторонники младшего разъехались по замкам, затаив обиду.",
                ],
            ),
            (
                text: "Назначить наследником младшего",
                effects: [HeirOp(Designate(1)), HeirOp(Claim(1, 25))],
                cause_tag: "dispute_younger",
                hint: "Нарушенный обычай отзывается смутой.",
                told: "Двое королевских детей спорили о праве на престол, и {ruler} {ruler:назвал|назвала} наследником младшего в обход старшего.",
                retold: [
                    "Вопреки обычаю {ruler} {ruler:отдал|отдала} право на престол младшему, и в тот же вечер свита обойдённого покинула столицу.",
                    "Младшего назвали наследником в обход старшинства, и летописец записал, что в тот день при дворе многие перестали улыбаться.",
                ],
            ),
            (
                text: "Вынести спор на собор",
                effects: [
                    Axis("treasury", -30),
                    Axis("loyalty_church", 5),
                    Axis("stability", -3),
                    HeirOp(Claim(0, 10)),
                ],
                cause_tag: "dispute_council",
                hint: "Решение собора крепче воли одного человека.",
                told: "Спор королевских детей о престоле вынесли на собор, и тот подтвердил право старшего.",
                retold: [
                    "О праве на престол три дня спорили на соборе прелатов и баронов, и собор постановил: корона пойдёт старшему.",
                    "{ruler} не {ruler:стал решать сам|стала решать сама} и {ruler:созвал|созвала} собор; прелаты долго листали древние хартии и встали за старшего.",
                ],
            ),
        ],
    ),
    (
        id: "heir_death",
        title: "Беда с наследником",
        text: "На охоте под {heir.тв} споткнулся конь, и {heir} {heir:упал|упала} на камни. Третий день горячка, лекари не ручаются за жизнь.",
        texts: [
            "{heir.вин} принесли с охоты на носилках из копий. Нога сломана, лицо серое, к ночи начался бред.",
            "Дурная весть с охоты: конь сбросил {heir.вин} в овраг. Во дворце закрывают ставни, в соборе зажигают свечи.",
        ],
        when: All([]),
        weight: 3,
        once: false,
        cooldown_years: 5,
        importance: 4,
        // From rules.ron sim.heir_death_age on: a hunt is no trouble of a child, whose
        // death is not an heir's (stage 25); children fall ill in heir_fever.
        target: Heir(14, 99),
        choices: [
            (
                text: "Позвать лучших лекарей",
                effects: [
                    Axis("treasury", -40),
                    Chance((percent: 80, then: [HeirOp(TargetAbility(-3))], otherwise: [HeirOp(TargetRemove)])),
                ],
                cause_tag: "heir_doctors",
                hint: "Хорошие лекари дороги, но жизнь наследника дороже.",
                told: "{heir} {heir:упал|упала} с коня на охоте и {heir:слёг|слегла} в горячке, и к {heir:нему|ней} позвали лучших лекарей.",
                retold: [
                    "После падения на охоте {heir.вин} лечили лучшие лекари королевства: вправляли кости, меняли повязки и не отходили ни днём, ни ночью.",
                    "Когда {heir} {heir:слёг|слегла} после падения с коня, корона не пожалела денег, и лекарей везли из трёх городов.",
                    "К постели {heir.род} после падения с коня везли лекарей из университетских городов, и те спорили на латыни, пока больной метался в жару.",
                    "Ради {heir.род} корона опустошила аптекарские лавки трёх городов: кровопускания, припарки и травы сменяли друг друга день и ночь.",
                ],
            ),
            (
                text: "Молиться о спасении",
                effects: [
                    Axis("loyalty_church", 3),
                    Chance((percent: 65, then: [HeirOp(TargetAbility(-3))], otherwise: [HeirOp(TargetRemove)])),
                ],
                cause_tag: "heir_prayer",
                hint: "Церковь запомнит смирение двора, исход в руках Божьих.",
                told: "{heir} {heir:упал|упала} с коня на охоте и {heir:слёг|слегла} в горячке, и за {heir:его|её} жизнь молились во всех храмах.",
                retold: [
                    "У постели {heir.род} день и ночь читали молитвы, а по всем приходам королевства звонили к молебнам о здравии.",
                    "Лекарей не звали: двор уповал на Бога, и епископ сам отслужил всенощную о {heir.пр}.",
                    "После падения {heir.род} с коня двор молился и постился, а в соборе день и ночь горела свеча в рост человека.",
                    "В часовне у опочивальни {heir.род} монахи читали псалтырь посменно, и {ruler} сам{ruler:|а} {ruler:стоял|стояла} на коленях у постели.",
                ],
            ),
            (
                text: "Положиться на крепость юности",
                effects: [
                    Chance((percent: 45, then: [HeirOp(TargetAbility(3))], otherwise: [HeirOp(TargetRemove)])),
                ],
                cause_tag: "heir_left_alone",
                hint: "Наследник, выживший сам, не будет обязан ни лекарям, ни монахам.",
                told: "{heir} {heir:упал|упала} с коня на охоте, но лекарей звать не стали, положившись на крепость юности.",
                retold: [
                    "Сломанную ногу {heir.род} перевязал конюх, а дальше решили: молодое тело справится само.",
                    "Над постелью {heir.род} не толпились ни лекари, ни монахи: при дворе верили, что молодость сильнее горячки.",
                    "После падения {heir.род} с коня при дворе решили, что всё обойдётся само, и в покои никого не звали, кроме старой няньки.",
                    "{heir} {heir:лежал|лежала} в жару, а двор жил своей жизнью: охоты, пиры, приёмы, и о больном вспоминали за ужином.",
                ],
            ),
        ],
    ),
    (
        // After a contested abdication (rules.ron `abdication`); fires in the simulation.
        id: "succession_dispute",
        title: "Спор о короне",
        text: "Корона сложена до срока, и бароны не спешат присягать. В замках называют своих претендентов, а на дорогах к столице видят вооружённых людей.",
        texts: [
