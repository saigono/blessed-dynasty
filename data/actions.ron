// Map actions (stage 3), the war (stage 4) and the stage 2 test action. Stage 9 adds the rest.
[
    // The succession law is a flag; one action per law, since ActionTarget has no law
    // target. Claims follow the law year by year (rules.ron `heirs.laws`).
    (
        id: "change_succession_law_primogeniture",
        description: "Ввести первородство: трон наследует старший ребёнок. Церковь одобряет, знать ворчит.",
        name: "Закон: престол старшему",
        duration_years: 2,
        cost: 30,
        requires: NotFlag("law_primogeniture"),
        min_crown_power: 40,
        target: None,
        on_complete: [ClearFlag("law_elective"), ClearFlag("law_none"), SetFlag("law_primogeniture"), Axis("loyalty_church", 3), Axis("loyalty_nobles", -3)],
        cause_tag: "succession_law_primogeniture",
    ),
    (
        id: "change_succession_law_elective",
        description: "Наследника будет избирать совет из самых способных. Знати нравится, легитимность падает.",
        name: "Закон: наследника избирает совет",
        duration_years: 2,
        cost: 30,
        requires: NotFlag("law_elective"),
        min_crown_power: 40,
        target: None,
        on_complete: [ClearFlag("law_primogeniture"), ClearFlag("law_none"), SetFlag("law_elective"), Axis("loyalty_nobles", 5), Axis("legitimacy", -3)],
        cause_tag: "succession_law_elective",
    ),
    (
        id: "change_succession_law_none",
        description: "Отменить твёрдый закон: наследника назначит государь. Наследники станут соперниками, стабильность падает.",
        name: "Закон: наследник по воле государя",
        duration_years: 2,
        cost: 30,
        requires: NotFlag("law_none"),
        min_crown_power: 40,
        target: None,
        on_complete: [ClearFlag("law_primogeniture"), ClearFlag("law_elective"), SetFlag("law_none"), Axis("stability", -5), Axis("loyalty_nobles", -3)],
        cause_tag: "succession_law_none",
    ),
    (
        id: "build_fort",
        description: "Крепость укрепляет власть короны в провинции и помогает в войне, если стоит на границе с врагом. Гарнизон съедает часть дохода.",
        name: "Построить крепость",
        duration_years: 4,
        cost: 80,
        requires: All([]),
        min_crown_power: 30,
        target: Province((holder: Crown, without_building: "fort")),
        on_complete: [Build(EventTarget, "fort"), Province(EventTarget, Income, -1)],
        cause_tag: "fort_built",
    ),
    (
        id: "build_road",
        description: "Дорога связывает провинцию со столицей: власть короны там крепнет, торговля приносит чуть больше дохода.",
        name: "Проложить дорогу",
        duration_years: 2,
        cost: 40,
        requires: All([]),
        min_crown_power: 20,
        target: Province((holder: Crown, without_building: "road")),
        on_complete: [Build(EventTarget, "road"), Province(EventTarget, Income, 1)],
        cause_tag: "road_built",
    ),
    (
        id: "build_market",
        description: "Рынок даёт провинции доход и радует народ.",
        name: "Открыть рынок",
        duration_years: 3,
        cost: 60,
        requires: All([]),
        min_crown_power: 20,
        target: Province((holder: Crown, without_building: "market")),
        on_complete: [
            Build(EventTarget, "market"),
            Province(EventTarget, Income, 3),
            Axis("loyalty_people", 2),
        ],
        cause_tag: "market_built",
    ),
    (
        // The crown power drop comes from the vassal base in the crown power formula.
        id: "grant_province",
        description: "Отдать провинцию ближайшему вассалу или новому дому. Знать довольна, но власть короны там слабеет, а окрепший вассал однажды может восстать.",
        name: "Пожаловать провинцию",
        duration_years: 1,
        cost: 0,
        requires: All([]),
        min_crown_power: 20,
        target: Province((holder: Crown, capital: false)),
        on_complete: [Grant(EventTarget), Axis("loyalty_nobles", 8)],
        cause_tag: "province_granted",
    ),
    (
        id: "revoke_province",
        description: "Вернуть провинцию вассала короне. Знать и сама провинция будут недовольны.",
        name: "Отобрать провинцию",
        duration_years: 1,
        cost: 20,
        requires: All([]),
        min_crown_power: 20,
        target: Province((holder: Vassal)),
        on_complete: [
            Revoke(EventTarget),
            Axis("loyalty_nobles", -15),
            Province(EventTarget, Loyalty, -10),
        ],
        cause_tag: "province_revoked",
    ),
    (
        id: "marry_neighbour",
        description: "Брак правящего дома с соседним двором: отношения с ним сразу растут. Друг (отношения выше 30) торгует, не нападает, через его земли легче дотянуться власти короны. Брак заключают один раз.",
        bond: "брачный союз",
        name: "Заключить брачный союз",
        duration_years: 1,
        cost: 50,
        requires: NotFlag("royal_marriage"),
        min_crown_power: 0,
        target: Neighbour,
        on_complete: [Relation(EventTarget, 30), SetFlag("royal_marriage"), Axis("prestige", 5)],
        cause_tag: "neighbour_married",
    ),
    (
        id: "royal_progress",
        description: "Объехать владения: государя видят, легитимность и знать немного растут.",
        name: "Объехать владения",
        duration_years: 1,
        cost: 20,
        requires: AxisBelow("legitimacy", 90),
        min_crown_power: 0,
        target: None,
        on_complete: [Axis("legitimacy", 3), Axis("loyalty_nobles", 2)],
        cause_tag: "royal_progress",
    ),
    (
        // Starts the war chain of events/war.ron at once; one war at a time.
        id: "declare_war",
        description: "Начать войну с соседом: дальше цепочка событий войны. Война с другом ославит вас предателем.",
        name: "Объявить войну",
        duration_years: 0,
        cost: 20,
        requires: Not(AtWar),
        min_crown_power: 0,
        target: Neighbour,
        // War on a friend (relation above neighbour_ai.friendly_above) earns a name for
        // treachery: prestige and every other neighbour's trust drop.
        on_complete: [
            IfFriendly([Axis("prestige", -15), OtherRelations(-10)]),
            StartWar(EventTarget),
            Relation(EventTarget, -30),
            Axis("loyalty_people", -3),
        ],
        cause_tag: "war_declared_by_crown",
    ),
]
