// The score of a dynasty (DESIGN 8, crates/core/src/score.rs). Stage 8b calibrates the
// weights on mass runs; these are the starting ones.
(
    // Points per unit: per year of the dynasty; per province of the crown and its vassals
    // per year; per point of `prestige_axis` per year; per crisis outlived without losing
    // provinces; per institution alive at the fall.
    weights: {
        "years": 30,
        "territory_years": 1,
        "prestige": 2,
        "stability": 40,
        "legacy": 60,
    },
    prestige_axis: "prestige",
    // A crisis: a chronicle entry of a Bad event (the default sign) with importance above this.
    crisis_importance: 3,
    // Institutions: these flags, set at the fall, count for `legacy`.
    legacy_flags: ["law_primogeniture", "law_elective", "cathedral"],
)
