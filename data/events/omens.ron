// Symptoms of the loops of the influence graph (stage 20, docs/design/hidden-state.html,
// section 4): events marked «Знамение» (`omen`) that come before a catastrophe. They fire in
// the reign and in the simulation, which tells them in the chronicle whatever their
// importance. rules.ron `symptoms` says which catastrophe each one foretells. Three more
// live in reign.ron: «Мятежный староста» (П1), «Ересь» and «Секта растёт» (П3).
[
    (
        // П1, oppression: the estates have split.
        id: "omen_runaways",
        image: "runaways",
        title: "Беглые крестьяне",
        text: "Из сёл {province.род} бегут крестьяне: ночью, семьями, с коровой на верёвке. Уходят в леса, в вольные города, за рубеж, а господа шлют ко двору жалобу за жалобой.",
        texts: [
            "В {province.пр} стоят пустые избы с распахнутыми дверями. Мужики ушли туда, где нет барщины, и приказчики не знают, кого гнать в поле.",
            "На дорогах из {province.род} ловят беглых, но их всё больше. Бегут от оброка, от розог, от господской воли.",
        ],
        when: AxisAbove("strata", 55),
        weight: 4,
        once: false,
        cooldown_years: 10,
        importance: 3,
        sign: Bad,
        omen: true,
        target: RandomProvince((holder: Crown)),
        choices: [
            (
                text: "Ловить беглых и возвращать господам",
                effects: [Axis("serfdom", 3), Axis("loyalty_nobles", 3), Axis("loyalty_people", -3)],
                cause_tag: "runaways_returned",
                hint: "Пойманный беглец бежит снова, и не один.",
                told: "Из сёл {province.род} бежали крестьяне, и корона велела ловить беглых и возвращать господам.",
                retold: [
                    "На дорогах {province.род} поставили заставы, и пойманных беглецов возвращали господам связанными, на одной верёвке.",
                    "Королевские сыщики прочесали леса вокруг {province.род}, и беглых вернули в сёла, откуда те ушли; многие ушли снова.",
                    "Беглых из {province.род} ловили с собаками по лесам и вернули господам под розги, и стало тише, но ненадолго.",
                    "Корона встала за господ: пойманных крестьян из {province.род} клеймили и вернули на барщину, а бегущих стало только больше.",
                ],
            ),
            (
                text: "Посадить беглых на пустошах короны",
                effects: [Axis("treasury", -30), Axis("mobility", 3), Province(EventTarget, Loyalty, 3)],
                cause_tag: "runaways_settled",
                hint: "Вольный поселенец пашет за двоих.",
                told: "Беглых крестьян из {province.род} посадили на пустошах короны, и через год там поднялись новые дворы.",
                retold: [
                    "Беглецам из {province.род} дали землю на королевских пустошах, и бывшие холопы впервые пахали на себя.",
                    "Корона не стала возвращать беглых господам: их поселили на пустых землях, и новые сёла платили подать прямо в казну.",
                    "Беглецам из {province.род} отвели королевские пустоши, и через пару лет там стояли сёла, не знавшие над собой никакого барона.",
                    "Крестьяне, бежавшие от господ из {province.род}, осели на коронной земле, и господа писали жалобы, а казна считала новую подать.",
                ],
            ),
            (
                text: "Не мешать, пусть уходят",
                effects: [Axis("mobility", 2), Axis("loyalty_nobles", -3), Province(EventTarget, Population, -1000), Province(EventTarget, Income, -1)],
                cause_tag: "runaways_let_go",
                hint: "Ушедшие не платят податей, но и не бунтуют.",
                told: "Из сёл {province.род} бежали крестьяне, а корона не мешала им уходить.",
                retold: [
                    "Беглых из {province.род} не ловили: кто хотел уйти, уходил, и пашни там зарастали бурьяном.",
                    "Господа {province.род} жаловались на бегство мужиков, но корона только развела руками, и сёла пустели.",
                    "Беглых из {province.род} никто не ловил, и пахать там стало некому, а господа продавали пустые деревни за бесценок.",
                    "Корона позволила крестьянам уходить, и из {province.род} к весне ушла едва не половина дворов.",
                ],
            ),
        ],
    ),
    (
        // П1, oppression: no way out of one's estate. The villages empty, and the corvée
        // with them: the node drops off its bound (stage 20, the serfdom trap discharges).
        id: "omen_empty_villages",
        image: "empty-village",
        title: "Пустеют сёла",
        text: "В {province.пр} пустеют сёла. Молодым некуда податься, ни в город, ни в ремесло, ни в монахи, и они уходят куда глаза глядят. Пашни зарастают березняком.",
        texts: [
            "На ярмарке в {province.пр} одни старики. Сыновья ушли в бродяги и в разбойники, а барщину отбывать некому.",
            "Приказчик из {province.род} доносит: в трёх сёлах из пяти заколочены избы, и колокол звонит только к отпеванию.",
        ],
        when: AxisBelow("mobility", 25),
        weight: 4,
        once: false,
        cooldown_years: 10,
        importance: 3,
        sign: Bad,
        omen: true,
        target: RandomProvince((holder: Crown)),
        choices: [
            (
                text: "Простить барщину пустеющим сёлам",
                effects: [Axis("serfdom", -15), Axis("loyalty_nobles", -4), Province(EventTarget, Population, -500)],
                cause_tag: "villages_corvee_forgiven",
                hint: "Прощённая барщина вернула пахарей на землю.",
                told: "В {province.пр} пустели сёла, и {ruler} {ruler:простил|простила} им барщину.",
                retold: [
                    "Пустеющим сёлам {province.род} простили барщину, и к весне в заколоченных избах снова задымили печи.",
                    "Барщину в {province.пр} сняли указом; господа скрипели зубами, а беглые потянулись домой.",
                ],
            ),
            (
                text: "Звать поселенцев из-за рубежа",
                effects: [Axis("treasury", -40), Axis("serfdom", -10), Axis("mobility", 3), Province(EventTarget, Population, -500)],
                cause_tag: "villages_settlers",
                hint: "Чужие поселенцы оживили пустые сёла.",
                told: "В пустеющие сёла {province.род} позвали поселенцев из-за рубежа.",
                retold: [
                    "В брошенных избах {province.род} поселились чужеземцы с другим говором и другими песнями, и поля снова распахали.",
                    "Корона созвала в {province.вин} переселенцев из-за рубежа, обещав им землю и вольность на десять лет, и сёла ожили.",
                ],
            ),
            (
                text: "Заставить оставшихся пахать за ушедших",
                effects: [Axis("serfdom", -10), Axis("loyalty_people", -5), Province(EventTarget, Population, -1500)],
                cause_tag: "villages_squeezed",
                hint: "Тех, кто остался, задавили чужой барщиной.",
                told: "В {province.пр} пустели сёла, а оставшихся заставили пахать за ушедших.",
                retold: [
                    "Тех, кто ещё оставался в {province.пр}, погнали на поля за соседей, и к осени бежали уже и они.",
                    "Барщину ушедших разложили на оставшихся, и в {province.пр} говорили, что у мужика теперь две спины и ни одного дня отдыха.",
                ],
            ),
        ],
    ),
    (
        // П2, the corvée: barons pleased and the peasants bound press for more.
        id: "omen_search_decree",
        image: "council",
        title: "Указ о сыске",
        text: "Бароны бьют челом всем съездом: мужики бегут, поля стоят, и знать просит указ о бессрочном сыске беглых. Без него, говорят, нечем будет кормить ни себя, ни войско.",
        texts: [
            "На столе у {ruler.род} челобитная за сорока печатями. Знать требует права искать беглых крестьян без срока давности.",
            "Бароны жалуются, что беглый мужик через пять лет уже вольный человек. Они просят указ, чтобы беглых возвращали и через двадцать.",
        ],
        // A search without term, once decreed, stands (stage 25).
        when: All([AxisAbove("loyalty_nobles", 65), AxisAbove("serfdom", 45), NotFlag("search_decree")]),
        weight: 4,
        once: false,
        cooldown_years: 12,
        importance: 3,
        sign: Bad,
        omen: true,
        target: None,
        choices: [
            (
                text: "Издать указ о бессрочном сыске",
                effects: [Axis("serfdom", 6), Axis("loyalty_nobles", 6), Axis("loyalty_people", -5), SetFlag("search_decree")],
                cause_tag: "search_decreed",
                hint: "Указ о сыске прикрепил крестьян крепче цепи.",
                told: "Бароны били челом о сыске беглых, и {ruler} {ruler:издал|издала} указ о бессрочном сыске.",
                retold: [
                    "Указ о бессрочном сыске огласили на всех площадях, и с того дня беглому мужику некуда было деться, кроме как за рубеж.",
                    "По челобитью знати {ruler} {ruler:скрепил|скрепила} указ: беглых искать без срока, а кто укроет, тот платит пеню.",
                ],
            ),
            (
                text: "Издать указ с урочными летами сыска",
                effects: [Axis("serfdom", 3), Axis("loyalty_nobles", 3), Axis("loyalty_people", -2)],
                cause_tag: "search_limited",
                hint: "Урочные лета оставили беглым надежду.",
                told: "По челобитью баронов {ruler} {ruler:издал|издала} указ о сыске беглых, но с урочными летами.",
                retold: [
                    "Сыск беглых разрешили, но на урочные лета: кто продержался на воле положенный срок, тот оставался вольным.",
                    "Знать получила указ о сыске, да не тот, что просила: срок давности оставили, и беглые считали годы.",
                ],
            ),
            (
                text: "Отказать баронам в сыске",
                effects: [Axis("loyalty_nobles", -8), Axis("legitimacy", -2)],
                cause_tag: "search_refused",
                hint: "Отказ в сыске знать помнила долго.",
                told: "Бароны просили указ о бессрочном сыске беглых крестьян, но {ruler} {ruler:отказал|отказала}.",
                retold: [
                    "Челобитную о сыске {ruler} {ruler:вернул|вернула} баронам нераспечатанной, и съезд разъехался в молчании.",
                    "Корона не стала ловить беглых для знати, и бароны ещё долго поминали этот отказ на своих пирах.",
                ],
            ),
        ],
    ),
    (
        // С1 broken, bread and price: the barns low and no trade to fill them.
        id: "omen_dear_bread",
        image: "famine",
        title: "Дороговизна хлеба",
        text: "Хлеб на торгу подорожал втрое. Перекупщики держат зерно в амбарах и ждут цены повыше, а у лавок с утра стоят бабы с пустыми мешками.",
        texts: [
            "Каравай теперь стоит как курица. Пекари пекут хлеб пополам с отрубями, и городская беднота считает каждую краюху.",
            "Амбары пустеют, а купцы не везут зерно: в соседних землях платят больше. На рынках ругань, и стража уже дважды разнимала драку у хлебных рядов.",
        ],
        when: AxisBelow("grain", 45),
        weight: 5,
        once: false,
        cooldown_years: 6,
        importance: 3,
        sign: Bad,
        omen: true,
        target: None,
        choices: [
            (
                text: "Запретить вывоз хлеба за рубеж",
                effects: [Axis("grain", 5), Axis("trade", -6)],
                cause_tag: "bread_export_banned",
                hint: "Запрет удержал хлеб, но отпугнул купцов.",
                told: "Хлеб на торгу подорожал втрое, и {ruler} {ruler:запретил|запретила} вывозить его за рубеж.",
                retold: [
                    "На заставах у границы встали стражники: ни одного воза с зерном за рубеж, и купцы, ругаясь, поворачивали обозы.",
                    "Вывоз хлеба запретили, и цена на торгу поползла вниз, а заморские купцы надолго забыли дорогу к нашим пристаням.",
                ],
            ),
            (
                text: "Продать зерно из казённых запасов",
                effects: [Axis("treasury", -40), Axis("grain", 10)],
                cause_tag: "bread_sold",
                hint: "Казённое зерно сбило цену.",
                told: "Хлеб на торгу подорожал втрое, и корона пустила в продажу зерно из казённых запасов.",
                retold: [
                    "Из королевских житниц на рынки вывезли зерно по старой цене, и перекупщики в тот год остались с носом.",
                    "Казённое зерно продавали прямо с телег у городских ворот, и к зиме хлеб подешевел вдвое.",
                ],
            ),
            (
                text: "Положиться на купцов и торг",
                effects: [Axis("trade", 4), Axis("loyalty_people", -4)],
                cause_tag: "bread_merchants",
                hint: "Купцы привезли хлеб, но бедным он был не по карману.",
                told: "Хлеб на торгу подорожал втрое, а корона положилась на купцов, и бедняки роптали у пустых лавок.",
                retold: [
                    "Купцы и правда привезли зерно, но по такой цене, что городская беднота ела лебеду, глядя на полные возы.",
                    "Корона в хлебные дела не вмешивалась: купцы богатели, пекари разорялись, а бедняки затягивали пояса.",
                ],
            ),
        ],
    ),
]
