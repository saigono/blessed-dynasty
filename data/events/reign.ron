// Reign events of the vertical slice: 30 in the random pool plus chain steps (weight 0).
// Prefixes: cap_ capital, prov_ provinces, fac_ factions, heir_ heirs, nb_ neighbours,
// dis_ disasters. Chain steps are spawned by the middle choice, so the neutral strategy
// reaches them. Flags `plot`, `plague`, `guard` are read by the death risk of stage 5.
[
    // ---------------------------------------------------------------- capital
    (
        id: "cap_court_intrigue",
        title: "Интриги при дворе",
        text: "Во дворце две партии: старые роды и новые писцы. Каждая нашёптывает у трона о кознях другой.",
        when: All([]),
        weight: 4,
        once: false,
        cooldown_years: 6,
        importance: 2,
        sign: Bad,
        target: None,
        choices: [
            (
                text: "Приблизить писцов и счётчиков",
                effects: [Axis("bureaucracy", 4), Axis("loyalty_nobles", -5)],
                cause_tag: "court_clerks",
                hint: "Перо служит короне вернее меча, но знать этого не простит.",
                told: "{ruler} {ruler:приблизил|приблизила} к трону писцов и счётчиков, и старые роды затаили обиду на выскочек с чернильницами.",
            ),
            (
                text: "Дать партиям грызться",
                effects: [Axis("stability", -3), Axis("legitimacy", 2)],
                cause_tag: "court_divide",
                hint: "Пока слуги спорят, господин над ними.",
                told: "При дворе схлестнулись старые роды и новые писцы, а {ruler} не {ruler:вмешался|вмешалась}: пока слуги грызлись, господин стоял над ними.",
            ),
            (
                text: "Опереться на старые роды",
                effects: [Axis("loyalty_nobles", 5), Axis("bureaucracy", -3)],
                cause_tag: "court_nobles",
                hint: "Старые роды помнят тех, кто их возвысил.",
                told: "{ruler} {ruler:опёрся|оперлась} на старые роды, и писцов оттеснили от трона.",
            ),
        ],
    ),
    (
        id: "cap_guild_charter",
        title: "Гильдии просят хартию",
        text: "Старшины цехов столицы принесли к трону хартию вольностей и просят скрепить её печатью.",
        // Granted or sold, the charter stays with the guilds (stage 25).
        when: NotFlag("guild_charter"),
        weight: 4,
        once: false,
        cooldown_years: 10,
        importance: 2,
        sign: Good,
        target: None,
        choices: [
            (
                text: "Даровать хартию",
                effects: [Province(Capital, Income, 2), Axis("liberties", 5), Axis("loyalty_people", 4), Axis("loyalty_nobles", -3), SetFlag("guild_charter")],
                cause_tag: "guild_charter_granted",
                hint: "Вольный город богатеет, а знать косится на купцов.",
                told: "{ruler} {ruler:скрепил|скрепила} печатью хартию столичных цехов. Город зажил вольнее и богаче, а знать косилась на разбогатевших купцов.",
            ),
            (
                text: "Продать хартию за серебро",
                effects: [Axis("treasury", 40), Axis("loyalty_people", -2), SetFlag("guild_charter")],
                cause_tag: "guild_charter_sold",
                hint: "Серебро сейчас, обида потом.",
                told: "Старшины цехов выкупили у короны хартию вольностей за серебро. Казна пополнилась, но в цехах ворчали, что свободу им продали втридорога.",
            ),
            (
                text: "Отказать",
                effects: [Axis("loyalty_nobles", 2), Axis("loyalty_people", -4)],
                cause_tag: "guild_charter_refused",
                hint: "Цеха запомнят отказ.",
                told: "Цеха столицы просили хартию вольностей, но {ruler} им {ruler:отказал|отказала}, и старшины ушли от трона с затаённой обидой.",
            ),
        ],
    ),
    (
        id: "cap_cathedral",
        title: "Собор на холме",
        text: "Епископ просит корону заложить в столице собор, какого не видели на сто вёрст окрест.",
        when: All([NotFlag("cathedral_building"), NotFlag("cathedral")]),
        weight: 3,
        once: true,
        cooldown_years: 0,
        importance: 3,
        sign: Good,
        target: None,
        choices: [
            (
                text: "Строить за счёт казны",
                effects: [Axis("treasury", -60), Axis("loyalty_church", 8), SetFlag("cathedral_building"), SpawnEvent("cap_cathedral_consecrated", 4)],
                cause_tag: "cathedral_crown",
                hint: "Камень переживёт того, кто его заложил.",
                told: "{ruler} {ruler:велел|велела} заложить в столице собор на казённые деньги, и епископ благословил первый камень.",
            ),
            (
                text: "Строить на пожертвования прихожан",
                effects: [Axis("treasury", -15), Axis("loyalty_people", -3), Axis("loyalty_church", 4), SetFlag("cathedral_building"), SpawnEvent("cap_cathedral_consecrated", 7)],
                cause_tag: "cathedral_alms",
                hint: "Строить будут долго и с ропотом.",
                told: "В столице заложили собор на пожертвования прихожан. Строили его медленно и с ропотом, но церковь была довольна.",
            ),
            (
                text: "Отложить до лучших времён",
                effects: [Axis("loyalty_church", -5)],
                cause_tag: "cathedral_delayed",
                hint: "Церковь не любит ждать.",
                told: "Епископ просил заложить в столице собор, но {ruler} {ruler:отложил|отложила} стройку до лучших времён, и клир долго поминал этот отказ.",
            ),
        ],
    ),
    (
        // Chain step of cap_cathedral.
        id: "cap_cathedral_consecrated",
        title: "Освящение собора",
        text: "Собор достроен. Колокола слышны далеко за стенами, и епископ ждёт двор на освящение.",
        when: Flag("cathedral_building"),
        weight: 0,
        once: true,
        cooldown_years: 0,
        importance: 3,
        sign: Good,
        target: None,
        choices: [
            (
                text: "Венчаться в соборе заново",
                effects: [ClearFlag("cathedral_building"), SetFlag("cathedral"), Axis("legitimacy", 6), Axis("prestige", 15)],
                cause_tag: "cathedral_crowning",
                hint: "Корона, освящённая заново, сидит крепче.",
                told: "Собор на холме освятили, и {ruler} {ruler:венчался|венчалась} в нём на царство заново. Корона, освящённая под новыми сводами, села крепче.",
            ),
            (
                text: "Отдать собор под усыпальницу рода",
                effects: [ClearFlag("cathedral_building"), SetFlag("cathedral"), Axis("loyalty_church", 5), Axis("prestige", 10)],
                cause_tag: "cathedral_crypt",
                hint: "Род, у которого есть усыпальница, думает о веках.",
                told: "Собор на холме освятили и отдали под усыпальницу царствующего рода, чтобы потомки покоились рядом с предками.",
            ),
        ],
    ),
    (
        id: "cap_fire",
        title: "Пожар в столице",
        text: "Ночью занялись склады у реки, и к утру выгорел целый посад.",
        // A city rebuilt in stone does not burn again (stage 25).
        when: NotFlag("stone_city"),
        weight: 3,
        once: false,
        cooldown_years: 12,
        importance: 3,
        sign: Bad,
        target: None,
        choices: [
            (
                text: "Отстроить посад из казны",
                effects: [Axis("treasury", -50), Axis("loyalty_people", 4), Province(Capital, Population, -500)],
                cause_tag: "fire_rebuilt",
                hint: "Погорельцы помнят, кто дал им кров.",
                told: "Ночной пожар выжег целый посад у реки, и {ruler} {ruler:отстроил|отстроила} его на казённые деньги. Погорельцы долго благословляли {ruler:его|её} имя.",
            ),
            (
                text: "Пусть отстраиваются сами",
                effects: [Province(Capital, Income, -2), Province(Capital, Population, -1500), Axis("loyalty_people", -4)],
                cause_tag: "fire_ignored",
                hint: "Пепелище долго не зарастает.",
                told: "Ночной пожар выжег посад у реки, и погорельцы отстраивались сами, как могли. Пепелище ещё долго чернело посреди города.",
            ),
            (
                text: "Строить заново только из камня",
                effects: [Axis("treasury", -80), Province(Capital, Population, -500), Axis("prestige", 8), Axis("loyalty_people", -2), SetFlag("stone_city")],
                cause_tag: "fire_stone",
                hint: "Каменный город не горит, но дорог.",
                told: "Ночной пожар выжег посад у реки, и {ruler} {ruler:велел|велела} строить заново только из камня. Город стал краше, но казна опустела.",
            ),
        ],
    ),
    (
        id: "cap_plot",
        title: "Заговор",
        text: "Верный слуга донёс: несколько знатных господ тайно собираются по ночам и поминают имя {ruler} недобро.",
        when: All([NotFlag("plot"), AxisBelow("loyalty_nobles", 55)]),
        weight: 3,
        once: false,
        cooldown_years: 8,
        importance: 4,
        sign: Bad,
        target: None,
        choices: [
