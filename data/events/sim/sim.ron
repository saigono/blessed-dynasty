        weight_bonus: [(AxisBelow("grain", 40), 3), (AxisBelow("grain", 30), 4), (AxisBelow("grain", 20), 6), (AxisBelow("treasury", 0), 2), (AxisBelow("stability", 30), 2)],
        once: false,
        cooldown_years: 25,
        importance: 4,
        target: None,
        choices: [
            (
                text: "Открыть казённые амбары",
                effects: [Axis("treasury", -80), Axis("grain", 20), Axis("loyalty_people", 5)],
                cause_tag: "famine_granaries",
                told: "Хлеб не уродился по всему королевству, и корона открыла казённые амбары.",
                retold: [
                    "В голодный год у королевских житниц выстраивались очереди на версту, и хлеб раздавали, пока не показалось дно сусеков.",
                    "Великий голод встретили казённым зерном: его возили по всему королевству, и многие обязаны были жизнью этим обозам.",
                    "Когда хлеб не уродился, {ruler} {ruler:велел|велела} снять замки с казённых житниц, и мерку зерна давали на каждый рот, от старика до младенца.",
                    "Голодный год пережили на королевском зерне: обозы шли из столицы во все края, и у каждого стояла охрана от отчаявшихся.",
                ],
            ),
            (
                text: "Поручить голодных монастырям",
                effects: [Axis("treasury", -20), Axis("loyalty_church", 4), Axis("loyalty_people", -2), Province(Capital, Population, -1000)],
                cause_tag: "famine_monasteries",
                told: "Хлеб не уродился по всему королевству, и голодных поручили заботам монастырей.",
                retold: [
                    "В голодный год монастыри варили похлёбку в огромных котлах, и монахи разливали её всем, кто доходил до ворот.",
                    "Голодных спасали обители: туда шли толпами, и там кормили, сколько могли, а кого не могли, отпевали.",
                    "Монастырские ворота в тот голодный год не закрывались ни днём, ни ночью, и братия сама ела по сухарю, чтобы хватило пришлым.",
                    "Корона отдала голодных на попечение обителей, и игумены кормили народ из своих погребов, а потом долго поминали двору этот долг.",
                ],
            ),
            (
                text: "Ждать нового урожая",
                effects: [Axis("loyalty_people", -10), Axis("stability", -6), Province(Capital, Population, -3000)],
                cause_tag: "famine_waited",
                told: "Хлеб не уродился по всему королевству. Люди ели лебеду и кору, а корона ждала нового урожая.",
                retold: [
                    "Великий голод пережидали молча: двор ел по-прежнему, а за стенами столицы хоронили без гробов.",
                    "В голодный год корона не открыла амбаров, и к весне королевство недосчиталось многих, а в столице от нищих не было прохода.",
                    "Корона ждала нового урожая, а народ тем временем ел лебеду; весной вдоль дорог насыпали свежие холмики без крестов.",
                    "Двор пересидел голод за запертыми амбарами, и к жатве в иных деревнях некому было выйти в поле.",
                ],
            ),
        ],
    ),
    // ------------------------------------------------------------------ schism
    (
        // Stage 20: the catastrophe of П3 (the scribes' heresy): one faith broken. A shock,
        // the church estranged; under the law of one faith a land breaks away with a
        // heretic lord (granted, then seceding).
        id: "schism",
        title: "Раскол",
        text: "Вера раскалывается. В {province.пр} изгнали епископа и служат по-своему, а по всему королевству полстраны крестится не так, как двор.",
        texts: [
            "В соборе {province.род} новые пастыри сорвали старые иконы и читают службу на простом языке. Раскол ползёт от прихода к приходу, и епископ требует от трона меча.",
            "Раскольники объявили свою церковь: у них свои священники, свой собор в {province.пр} и свой счёт грехам двора. Половина королевства смотрит, на чьей стороне корона.",
        ],
        recalled: "раскол",
        when: AxisBelow("faith", 40),
        weight: 4,
        weight_bonus: [(AxisBelow("faith", 30), 4)],
        once: false,
        cooldown_years: 30,
        importance: 5,
        target: RandomProvince((holder: Crown, capital: false)),
        choices: [
            (
                text: "Предать раскольников анафеме и огню",
                effects: [
                    Axis("stability", -20), Axis("loyalty_church", -15), Axis("faith", 8), Axis("loyalty_people", -8), Axis("army", -10),
                    Chance((percent: 0, bonus: [(Flag("law_one_faith"), 100)], then: [Grant(EventTarget), Secede(EventTarget), SetFlag("vassal_seceded")])),
                ],
                cause_tag: "schism_crushed",
                told: "Вера раскололась: в {province.пр} изгнали епископа, и {ruler} {ruler:предал|предала} раскольников анафеме и огню.",
                retold: [
                    "На раскольников пошли войной, как на врагов: их храмы жгли, пастырей вешали, а анафему читали с каждого амвона.",
                    "Раскол выжигали огнём, и в {province.пр} годами помнили костры на соборной площади.",
                ],
            ),
            (
                text: "Созвать собор и искать примирения",
                effects: [
                    Axis("stability", -20), Axis("loyalty_church", -15), Axis("faith", 3), Axis("treasury", -60), Axis("legitimacy", -5),
                    Chance((percent: 0, bonus: [(Flag("law_one_faith"), 100)], then: [Grant(EventTarget), Secede(EventTarget), SetFlag("vassal_seceded")])),
                ],
                cause_tag: "schism_council",
                told: "Вера раскололась: в {province.пр} изгнали епископа, и {ruler} {ruler:созвал|созвала} собор, чтобы искать примирения.",
                retold: [
                    "За один стол усадили и старых епископов, и новых пастырей, и спорили они так, что слышно было на улице, но до мечей не дошло.",
                    "Собор примирения не закрыл раскол, но научил обе стороны говорить, а не жечь.",
                ],
            ),
            (
                text: "Признать раскол и поделить храмы",
                effects: [
                    Axis("stability", -20), Axis("loyalty_church", -25), Axis("faith", -5), Axis("loyalty_people", 5),
                    Chance((percent: 0, bonus: [(Flag("law_one_faith"), 100)], then: [Grant(EventTarget), Secede(EventTarget), SetFlag("vassal_seceded")])),
                ],
                cause_tag: "schism_accepted",
                told: "Вера раскололась: в {province.пр} изгнали епископа, и корона признала раскол, поделив храмы.",
                retold: [
                    "Храмы поделили по жребию: одним достался собор, другим часовни, и в одном городе стали звонить к двум разным обедням.",
                    "Корона признала раскол, и в королевстве стало две церкви, две правды и одна казна, которую тянули обе.",
                ],
            ),
        ],
    ),
    // ------------------------------------------------------------ persecution
    (
        // Stage 30: the price of «Единоверие» (law_one_faith). While the law holds, the
        // zealots hunt the other faiths, and the more faith weakens, the more often: the
        // people grow bitter, merchants of other faiths leave, or the church, held back,
        // cools and faith falls further.
        id: "faith_persecution",
        title: "Сыск по вере",
        text: "Ревнители единой веры ходят по {province.дат} с монахами и стражей. В домах ищут чужие книги, у ворот допрашивают купцов, и соседи пишут доносы друг на друга.",
        texts: [
            "В {province.пр} взяли под стражу семью суконщика: у них нашли молитвенник не того обряда. Епископ требует суда, а цех просит за своих.",
            "Иноверческий квартал в {province.пр} опустел за одну ночь. Кто не успел уехать, сидит в монастырском подвале и ждёт приговора.",
            "Проповедники единой веры гонят по {province.дат} тех, кто молится по-старому. На торгу пусто: чужие купцы боятся показаться в городе.",
        ],
        recalled: "сыск по вере",
        when: All([Flag("law_one_faith"), AxisBelow("faith", 85)]),
        weight: 3,
        weight_bonus: [(AxisBelow("faith", 70), 3), (AxisBelow("faith", 60), 5)],
        once: false,
        cooldown_years: 12,
        importance: 4,
        target: RandomProvince((holder: Crown, capital: false)),
        choices: [
            (
                text: "Судить отступников церковным судом",
                effects: [Axis("loyalty_people", -10), Axis("loyalty_church", 4), Axis("faith", 3), Axis("trade", -3)],
                cause_tag: "persecution_burned",
                told: "В {province.пр} искали отступников от единой веры, и церковный суд отправил их на костёр.",
                retold: [
                    "Костры на площади {province.род} горели три дня, и народ смотрел на них молча, а молчание это было недобрым.",
                    "Церковный суд в {province.пр} не знал жалости: отступников жгли, их дома отдавали доносчикам, и соседи перестали здороваться друг с другом.",
                    "Сыск по вере в {province.пр} кончился кострами. Епископ служил благодарственный молебен, а в слободах шептались, что следующими будут они.",
                ],
            ),
            (
                text: "Выслать иноверцев за рубеж",
                effects: [Axis("trade", -8), Axis("treasury", -40), Axis("faith", 2), Axis("loyalty_church", 2)],
                cause_tag: "persecution_exiled",
                told: "Из {province.род} выслали иноверцев, и вместе с ними за рубеж ушли их лавки, мастерские и долги казне.",
                retold: [
                    "По дорогам из {province.род} тянулись повозки иноверцев, и на рынке опустели лучшие ряды.",
                    "Иноверцев выставили за рубеж всей слободой, и через год в {province.пр} некому было ткать сукно и чеканить посуду.",
                    "Высланные иноверцы унесли за рубеж ремёсла и серебро, а мытари {province.род} долго не могли собрать прежней подати.",
                ],
            ),
            (
                text: "Унять ревнителей и не искать по домам",
                effects: [Axis("loyalty_church", -10), Axis("faith", -4), Axis("legitimacy", -4)],
                cause_tag: "persecution_restrained",
                told: "Ревнители единой веры искали отступников в {province.пр}, но двор их унял, и епископ затаил обиду.",
                retold: [
                    "Сыск по вере в {province.пр} остановили королевским указом, и клир громко говорил, что трон потакает отступникам.",
                    "Ревнителей отозвали из {province.род} ни с чем, а иноверцы стали молиться по-своему почти не таясь.",
                    "Двор запретил искать чужую веру по домам, и в {province.пр} вздохнули, а с амвонов ещё долго корили трон за мягкость.",
                ],
            ),
        ],
    ),
