// Simulation events of stage 24 (the testament, testament.rs): a ruler names his favourite
// in a sealed will over the law (HeirOp TargetBequeath, crowned after him at the next
// coronation), and a forged will surfaces while the crown's right is shaky.
[
    (
        // The favourite: the ablest heir after the first in line, abler by more than the gap
        // (EventTarget Favourite). A defiant ruler does it far more often (sim.auto.traits).
        id: "royal_will",
        title: "Тайное завещание",
        text: "{ruler} всё больше благоволит {heir.дат}, а не старшему в очереди. Писцы шепчутся о запечатанном завещании, а старший наследник перестал улыбаться за обедом.",
        texts: [
            "По вечерам {ruler} подолгу сидит с {heir.тв} над картами и книгами, и двор замечает, кому достаётся королевская ласка. Канцлер тайно заказал новый воск для печати.",
            "{heir} ездит по правую руку от государя на охоте и сидит по правую руку на пиру. При дворе гадают, не впишет ли {ruler} любимца в завещание вперёд закона.",
        ],
        when: All([RulerAge(35, 200), HeirCount(2, 99)]),
        weight: 3,
        weight_bonus: [(RulerTrait("defiant"), 6)],
        once: false,
        cooldown_years: 15,
        importance: 4,
        target: Favourite(5),
        choices: [
            (
                text: "Назвать любимца наследником в тайном завещании",
                effects: [HeirOp(TargetBequeath)],
                cause_tag: "will_sealed",
                told: "{ruler} {ruler:составил|составила} тайное завещание и {ruler:запечатал|запечатала} его своей печатью; о том, чьё имя в нём стояло, при дворе лишь шептались.",
                retold: [
                    "Однажды ночью в кабинет государя позвали писца и двух свидетелей, и наутро в ларце канцлера лежал свиток под тремя печатями.",
                    "Тайное завещание легло в железный ларец, и {ruler} носил{ruler:|а} ключ от него на груди до самой смерти.",
                ],
            ),
            (
                text: "Оставить престол закону",
                effects: [Axis("legitimacy", 2)],
                cause_tag: "will_lawful",
                told: "{ruler} долго {ruler:благоволил|благоволила} {heir.дат}, но так и не {ruler:решился|решилась} обойти закон: престол остался за старшим.",
                retold: [
                    "Любовь к {heir.дат} не перевесила старого обычая: {ruler} не {ruler:стал|стала} писать завещания, и очередь осталась прежней.",
                    "Писцы ждали приказа о тайной грамоте, но его не последовало, и {ruler} до конца держал{ruler:ся|ась} закона о престоле.",
                ],
            ),
        ],
    ),
    (
        // Only while the crown's right is shaky does anyone dare bring a forged will to court.
        id: "forged_will",
        title: "Подложное завещание",
        text: "При дворе объявилось завещание, будто бы написанное прежним государем: престол в нём отдан другому, а не {ruler.дат}. Печать похожа, почерк похож, и знать уже делится надвое.",
        texts: [
            "Претендент привёз в столицу пергамент с подписью покойного государя. По нему корона принадлежит не {ruler.дат}, и в тавернах уже спорят, подлинная ли грамота.",
            "На ступенях собора огласили грамоту, что будто бы нашли в бумагах прежнего государя. В ней чужое имя вместо имени {ruler.род}, и каждый барон теперь решает, чему верить.",
        ],
        when: All([AxisBelow("legitimacy", 30), HeirCount(1, 99)]),
        weight: 3,
        weight_bonus: [(AxisBelow("legitimacy", 15), 4)],
        once: false,
        cooldown_years: 20,
        importance: 5,
        target: None,
        choices: [
            (
                text: "Объявить завещание подложным и казнить писцов",
                effects: [Axis("legitimacy", 4), Axis("loyalty_nobles", -8), Axis("loyalty_people", -3)],
                cause_tag: "forged_will_exposed",
                told: "При дворе объявилось подложное завещание прежнего государя, и {ruler} {ruler:велел|велела} казнить писцов, что его составили.",
                retold: [
                    "Подложную грамоту сожгли на площади, а писцов, что её составили, повесили у городских ворот вместе с их перьями.",
                    "Писцов, состряпавших чужое завещание, нашли за три дня, и их казнь отбила у прочих охоту подделывать королевскую руку.",
                ],
            ),
            (
                text: "Отдать дело на суд прелатов",
                effects: [Axis("treasury", -40), Axis("loyalty_church", 5), Axis("legitimacy", 2)],
                cause_tag: "forged_will_judged",
                told: "При дворе объявилось завещание, отдававшее престол другому, и {ruler} {ruler:отдал|отдала} дело на суд прелатов; те признали грамоту подложной.",
                retold: [
                    "Прелаты сличали воск и почерк неделю и в конце концов объявили завещание подделкой, но за свой суд взяли с короны немало.",
                    "Спор о завещании разбирали епископы, и их приговор сделал права {ruler.род} крепче, чем было до подделки.",
                ],
            ),
            (
                text: "Замять дело, откупившись от претендента",
                effects: [Axis("treasury", -60), SetFlag("succession_contested")],
                cause_tag: "forged_will_hushed",
                told: "Чтобы замять дело о подложном завещании, {ruler} {ruler:откупился|откупилась} от претендента, но слух о нём уже пошёл по стране.",
                retold: [
                    "Претенденту дали денег и поместье за рубежом, а грамоту выкупили и спрятали, только молва о ней гуляла по кабакам ещё долго.",
                    "Дело о завещании замяли за сундук серебра, и все поняли, что корона заплатила, а значит, было за что.",
                ],
            ),
        ],
    ),
]
