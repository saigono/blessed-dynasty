// Test events for stage 2. Stage 9 writes the real content next to them.
[
    (
        id: "harvest_feast",
        title: "Праздник урожая",
        text: "Амбары полны, и народ ждёт, что {ruler} разделит с ним радость.",
        when: AxisAbove("treasury", 50),
        weight: 10,
        once: false,
        cooldown_years: 3,
        importance: 1,
        sign: Good,
        target: None,
        choices: [
            (
                text: "Устроить пир за счёт казны",
                effects: [Axis("treasury", -30), Axis("loyalty_people", 5)],
                cause_tag: "feast_paid",
                hint: "Народ запомнит щедрость короны.",
            ),
            (
                text: "Обойтись молебном",
                effects: [Axis("loyalty_church", 3)],
                cause_tag: "feast_prayer",
            ),
        ],
    ),
    (
        id: "unruly_province",
        title: "Ропот в провинции",
        text: "В землях {province} неспокойно: люди жалуются на поборы.",
        when: All([]),
        weight: 8,
        once: false,
        cooldown_years: 2,
        importance: 2,
        target: RandomProvince((holder: Vassal, loyalty_below: 50)),
        choices: [
            (
                text: "Снизить подати",
                effects: [Province(EventTarget, Income, -1), Province(EventTarget, Loyalty, 10)],
                cause_tag: "unrest_relief",
            ),
            (
                text: "Прислать стражу",
                effects: [CrownPower(EventTarget, 5), Province(EventTarget, Loyalty, -5)],
                cause_tag: "unrest_force",
                hint: "Страх держит недолго.",
            ),
        ],
    ),
    (
        id: "envoy",
        title: "Посол из {neighbour}",
        text: "Посол {neighbour} привёз дары и ждёт ответа.",
        when: All([]),
        weight: 6,
        once: false,
        cooldown_years: 4,
        importance: 1,
        target: Neighbour,
        choices: [
            (
                text: "Принять с почётом",
                effects: [Relation(EventTarget, 10), Axis("treasury", -10)],
                cause_tag: "envoy_welcome",
            ),
            (
                text: "Отослать без ответа",
                effects: [Relation(EventTarget, -10), Axis("prestige", 2)],
                cause_tag: "envoy_snub",
            ),
        ],
    ),
    (
        id: "heresy_rumour",
        title: "Слухи о ереси",
        text: "Монахи доносят, что в городе проповедует странник, отвергающий церковь.",
        when: NotFlag("heresy"),
        weight: 5,
        once: true,
        cooldown_years: 0,
        importance: 3,
        target: None,
        choices: [
            (
                text: "Велеть разобраться через два года",
                effects: [SetFlag("heresy"), SpawnEvent("heresy_spread", 2)],
                cause_tag: "heresy_ignored",
                hint: "Отложенное дело редко решается само.",
            ),
            (
                text: "Изгнать проповедника",
                effects: [Axis("loyalty_church", 5), Axis("loyalty_people", -3)],
                cause_tag: "heresy_expelled",
            ),
        ],
    ),
    (
        // Chain only: weight 0 keeps it out of the random pool.
        id: "heresy_spread",
        title: "Ересь ширится",
        text: "Проповедник обрёл сотни последователей. Церковь требует от {ruler} суда.",
        when: Flag("heresy"),
        weight: 0,
        once: true,
        cooldown_years: 0,
        importance: 4,
        target: None,
        choices: [
            (
                text: "Созвать собор",
                effects: [ClearFlag("heresy"), Axis("loyalty_church", 5), Axis("stability", -5)],
                cause_tag: "heresy_council",
            ),
            (
                text: "Казнить зачинщиков",
                effects: [ClearFlag("heresy"), Axis("loyalty_people", -10), Axis("legitimacy", -3)],
                cause_tag: "heresy_purge",
            ),
        ],
    ),
]
