(
    // 1 = year, 4 = seasons, 12 = months. Durations in data are always in years.
    time_unit: (ticks_per_year: 1),

    // State axes: the world starts with `default`, a preset may override it. `name` is shown
    // in the UI; a change of at least `notable` in a year goes to the year's summary (0: never).
    axes: [
        // The treasury has a line of its own in the year's summary (UI): notable 0.
        (id: "treasury", min: -1000, max: 10000, default: 100, name: "Казна"),
        (id: "income", min: -100, max: 1000, default: 5, name: "Доход", notable: 2),
        (id: "army", min: 0, max: 1000, default: 50, name: "Армия", notable: 10),
        (id: "legitimacy", min: 0, max: 100, default: 50, name: "Легитимность", notable: 5),
        // Derived (`stability` below): the default is its anchor.
        (id: "stability", min: 0, max: 100, default: 50, name: "Стабильность", notable: 5),
        (id: "bureaucracy", min: 0, max: 100, default: 20, name: "Бюрократия", notable: 5),
        (id: "loyalty_nobles", min: 0, max: 100, default: 50, name: "Знать", notable: 5),
        (id: "loyalty_church", min: 0, max: 100, default: 50, name: "Церковь", notable: 5),
        (id: "loyalty_people", min: 0, max: 100, default: 50, name: "Народ", notable: 5),
        (id: "prestige", min: 0, max: 1000, default: 0, name: "Престиж", notable: 5),
        // Derived from the faction axes, never written directly; the default is ignored.
        (id: "loyalty", min: 0, max: 100, default: 50, name: "Лояльность"),
        // What events do to stability: fades by `step` a year toward 0.
        (id: "shocks", min: -100, max: 100, default: 0, name: "Потрясения", hidden: true, step: 3),
        // Hidden nodes of the influence graph (docs/design/hidden-state.html, section 2): no
        // number for the player; `reveal`: the bureaucracy that shows one in words; `step`:
        // a year toward the target.
        (id: "serfdom", min: 0, max: 100, default: 30, name: "Закрепощение", hidden: true, step: 0.4, reveal: 40),
        (id: "strata", min: 0, max: 100, default: 40, name: "Расслоение", hidden: true, step: 0.4, reveal: 70),
        (id: "mobility", min: 0, max: 100, default: 40, name: "Подвижность сословий", hidden: true, step: 0.5, reveal: 70),
        (id: "liberties", min: 0, max: 100, default: 15, name: "Городские вольности", hidden: true, step: 0.6, reveal: 40),
        (id: "trade", min: 0, max: 100, default: 30, name: "Торговля", hidden: true, step: 1.5, reveal: 20),
        (id: "grain", min: 0, max: 100, default: 50, name: "Хлебные запасы", hidden: true, step: 5, reveal: 20),
        (id: "literacy", min: 0, max: 100, default: 10, name: "Грамотность", hidden: true, step: 0.25, reveal: 55),
        (id: "faith", min: 0, max: 100, default: 65, name: "Единоверие", hidden: true, step: 0.5, reveal: 55),
    ],

    // Stability is derived: its anchor (the axis default) plus the Target edges into it plus
    // `shocks`, clamped. Axis("stability", x) in effects and rules goes to `shocks`; a
    // preset's stability is where it starts, the gap a shock.
    stability: (axis: "stability", shocks: "shocks"),

    // What the crown knows of the hidden nodes (section 7): a node opens in words at the
    // `axis` of its `reveal`, every node in numbers with the forecast of 60 years at `numbers`.
    reveal: (axis: "bureaucracy", numbers: 85),

    // Each faction's loyalty is its axis. `loyalty_axis` = weighted mean, rounded toward zero.
    factions: [
        (id: "nobles", axis: "loyalty_nobles", weight: 2),
        (id: "church", axis: "loyalty_church", weight: 1),
        (id: "people", axis: "loyalty_people", weight: 1),
    ],
    loyalty_axis: "loyalty",

    // Crown power of own provinces (foreign ones and those cut off from the capital get 0),
    // recomputed from scratch, never below 0:
    // base[holder] - (threshold - loyalty) * loyalty_penalty (only below threshold)
    // - path_cost * distance_penalty + buildings + capital.crown_bonus.
    // path_cost: cheapest path from the capital; a step into an own province costs 1, into
    // a neighbour's max(1, 1 + foreign_step_penalty - relation * foreign_step_relation).
    crown_power: (
        base: (crown: 60, vassal: 30),
        loyalty_threshold: 50,
        loyalty_penalty: 0.5,
        distance_penalty: 5,
        foreign_step_penalty: 1,
        foreign_step_relation: 0.02,
        buildings: {"fort": 10, "road": 5, "market": 2},
    ),

    // How many actions may run at once: the largest `slots` whose threshold the axis reached.
    // The actions of a war going on (target Enemy) have `war_slots` of their own.
    action_slots: (axis: "bureaucracy", steps: [(0, 1), (40, 2), (70, 3)], war_slots: 1),

    // Per year: treasury += income of crown provinces + the Flow edges into it (influences).
    // The army's upkeep and the war's toll are in `war`.
    economy: (
        treasury: "treasury",
    ),

    // The influence graph, counted in this order once a year after the passive changes:
    // lagged sources, then targets and steps, then flows. An edge adds k * (source - rest),
    // or by its `curve` of (source, contribution) points; `delay`: years the source is
    // smoothed over. Target: to the target of `to` (its anchor plus the edges; the axis steps
    // toward it by its `step` a year). Flow: to the stock `to` every year.
    influences: [
        (id: "income", from: "income", to: "treasury", k: 1, kind: Flow),
        // Stability: 50 + 0.6 * (loyalty - 50) + 0.4 * (legitimacy - 50) - heresy + shocks.
        (id: "st_loyalty", from: "loyalty", to: "stability", k: 0.6, rest: 50),
        (id: "st_legitimacy", from: "legitimacy", to: "stability", k: 0.4, rest: 50),
        // Heresy: 0 at faith 60 and above, 5 at 45, 12 at 30, 20 at 15.
        // `rest`: where the curve leaves 0, the way a chain reads faith (stage 20).
        (id: "st_heresy", from: "faith", to: "stability", rest: 60, curve: [(15, -20), (30, -12), (45, -5), (60, 0)]),
        // The graph of section 3. At the start every source stands at its rest: the graph is
        // silent and the targets are the defaults.
        (id: "e1", from: "serfdom", to: "strata", k: 0.5, rest: 30, delay: 10),
        // Flat above 85.
        (id: "e2", from: "strata", to: "mobility", rest: 40, delay: 5, curve: [(0, 30), (40, 0), (85, -33.75)]),
        (id: "e3", from: "mobility", to: "strata", k: -0.6, rest: 40, delay: 10),
        // 0.8 above nobles 50, nothing below.
        (id: "e4", from: "loyalty_nobles", to: "serfdom", rest: 50, delay: 5, curve: [(50, 0), (100, 40)]),
        (id: "e5", from: "serfdom", to: "loyalty_nobles", k: 0.4, rest: 30),
        // -0.6 up to 60, -1.0 above, flat above 85.
        (id: "e6", from: "strata", to: "loyalty_people", rest: 40, curve: [(0, 24), (40, 0), (60, -12), (85, -37)]),
        // Only under the law «Городские вольности» (`off`: counts while a law names it).
        (id: "e7", from: "strata", to: "liberties", k: 0.4, rest: 50, delay: 10, off: true),
        (id: "e8", from: "liberties", to: "mobility", k: 0.5, rest: 15, delay: 10),
        (id: "e9", from: "liberties", to: "trade", k: 0.6, rest: 15, delay: 5),
        (id: "e10", from: "trade", to: "grain", k: 0.4, rest: 30),
        (id: "e11", from: "grain", to: "trade", k: -0.3, rest: 50),
        // 0.5, twice as steep below 30: famine hurts more than plenty pleases.
        (id: "e12", from: "grain", to: "loyalty_people", rest: 50, curve: [(0, -40), (30, -10), (50, 0), (100, 25)]),
        (id: "e13", from: "trade", to: "treasury", k: 0.1, rest: 30, kind: Flow),
        (id: "e14", from: "literacy", to: "faith", k: -0.8, rest: 10, delay: 15),
        // -1.5 within faith 35..60, flat outside.
        (id: "e15", from: "faith", to: "literacy", rest: 60, delay: 5, curve: [(35, 37.5), (60, 0)]),
        (id: "e16", from: "faith", to: "loyalty_church", k: 0.4, rest: 65),
        (id: "e17", from: "literacy", to: "mobility", k: 0.4, rest: 10, delay: 15),
        (id: "e18", from: "literacy", to: "bureaucracy", k: 0.02, rest: 10, kind: Flow),
    ],

    // Loops of the graph (section 4), by their edges in order: `data_lint` checks the gain
    // of each outside its curves.
    loops: [
        ("П1 Гнёт", ["e2", "e3"]),
        ("П2 Барщина", ["e4", "e5"]),
        ("П3 Ересь книжников", ["e14", "e15"]),
        ("С1 Хлеб и цена", ["e11", "e10"]),
        ("С2 Вольный город", ["e7", "e8", "e3"]),
    ],

    // The catastrophes of the loops and the symptoms of each (events marked `omen`) that
    // come before it (stage 20, criterion 3): П1 and П2 end in the peasant war, П3 in the
    // schism, a broken С1 in the great famine.
    symptoms: [
        ("peasant_war", ["prov_rebel_elder", "omen_runaways", "omen_empty_villages", "omen_search_decree"]),
        ("schism", ["fac_heresy", "fac_heresy_spreads"]),
        ("great_famine", ["omen_dear_bread"]),
    ],

    // Laws-institutions (docs/design/hidden-state.html, section 5). A law is in force while
    // its flag `id` is set and outlives the ruler; one law of a `group` at a time. `cost` and
    // `years` to bring it in, `requires` to start; `resistance`: anchor shifts while it is
    // brought in (a faction against it); in force, `anchors`: anchor shifts, `edges`:
    // multipliers of edges of `influences`, `treasury`: added to the yearly income; done,
    // `on_complete` once; `keep`: no repeal, only another law of its group replaces it. The
    // succession laws are those of `heirs.laws` by their flag, named and described there.
    // Every law gets the actions to enact it and to repeal it (`enact`, `repeal`: their
    // names), both for `min_crown_power` of the capital; a repeal costs `repeal_share` of the
    // price, the simulation's automaton pays it all.
    laws: (
        enact: "Ввести закон «{law}»",
        repeal: "Отменить закон «{law}»",
        repeal_share: 0.5,
        min_crown_power: 40,
        // A faction above 70 presses the automaton for the laws that raise its anchor and
        // against those that lower it or that it resists, one below 30 only against (the
        // weight `pressure` of sim.auto, per point); only so pressed does it repeal a law, at
        // the full price.
        pressure: (30, 70),
        list: [
            // Stage 28b: the firmer a law holds the crown together, the dearer it is and the
            // harder the nobles resist it; the primogenitures need loyal nobles to start.
            (id: "law_primogeniture", group: "Наследование", keep: true, cost: 120, years: 4,
                requires: All([NotFlag("succession_contested"), AxisAbove("loyalty_nobles", 59.999)]),
                resistance: [("loyalty_nobles", -20)],
                on_complete: [Axis("loyalty_church", 3), Axis("loyalty_nobles", -3)]),
            (id: "law_male", group: "Наследование", keep: true, cost: 90, years: 3,
                requires: All([NotFlag("succession_contested"), AxisAbove("loyalty_nobles", 54.999)]),
                resistance: [("loyalty_nobles", -10)],
                on_complete: [Axis("loyalty_church", 2)]),
            (id: "law_salic", group: "Наследование", keep: true, cost: 90, years: 3,
                requires: All([NotFlag("succession_contested"), AxisAbove("loyalty_nobles", 54.999)]),
                resistance: [("loyalty_church", -10), ("loyalty_nobles", -5)],
                on_complete: [Axis("loyalty_nobles", 3), Axis("loyalty_church", -2)]),
            // A grown man on the throne pleases the barons.
            (id: "law_seniority", group: "Наследование", keep: true, cost: 60, years: 2,
                requires: NotFlag("succession_contested"),
                resistance: [("loyalty_church", -10)],
                anchors: [("loyalty_nobles", 3)],
                on_complete: [Axis("loyalty_nobles", 3), Axis("stability", -3)]),
            // The council of barons pulls toward the corvée.
            (id: "law_elective", group: "Наследование", keep: true, cost: 60, years: 2,
                requires: NotFlag("succession_contested"),
                resistance: [("loyalty_church", -10)],
                anchors: [("loyalty_nobles", 5)], edges: [("e4", 1.2)],
                on_complete: [Axis("loyalty_nobles", 5), Axis("legitimacy", -3)]),
            // The custom of the land. More lords, more corvée: with serfdom the gain of П2
            // nears 0.8.
            (id: "law_partition", group: "Наследование", keep: true, cost: 30, years: 1,
                requires: NotFlag("succession_contested"),
                resistance: [("loyalty_church", -5)],
                anchors: [("loyalty_nobles", 8)], edges: [("e4", 1.25), ("e1", 1.2)],
                on_complete: [Axis("loyalty_nobles", 5), Axis("stability", -3)]),
            // The ten laws of section 5. Peasants: serfdom or free peasants (custom: neither).
            (id: "law_serfdom", group: "Крестьяне", cost: 60, years: 3,
                name: "Крепостное право",
                description: "Крестьян прикрепляют к земле господина. Сразу знать довольна, барщина даёт казне 3 в год, ополчение пополняет армию. Закон держит крестьян в крепости, а знать — у барщины: довольные бароны требуют новых повинностей, гнёт растёт и запирает простолюдина в его сословии. Через два-три поколения народ ожесточается, начинаются мужицкие войны.",
                resistance: [("loyalty_people", -10)],
                anchors: [("serfdom", 30), ("loyalty_nobles", 8)], edges: [("e4", 1.5)],
                treasury: 3, on_complete: [Axis("army", 10)]),
            (id: "law_free_peasants", group: "Крестьяне", cost: 90, years: 4,
                name: "Вольные крестьяне",
                description: "Барщину отменяют, крестьянин волен уйти с земли. Знать теряет даровой труд и ропщет, вассалы смелеют. Закон держит крепость низкой и глушит союз знати и барщины; сословия расслаиваются меньше, люди выбиваются в цеха и писцы, торговля оживает.",
                resistance: [("loyalty_nobles", -10)],
                anchors: [("serfdom", -20), ("loyalty_nobles", -8), ("trade", 5)], edges: [("e4", 0)]),
            // Faith: one faith or tolerance (custom: neither).
            (id: "law_one_faith", group: "Вера", cost: 45, years: 2,
                name: "Единоверие",
                description: "Одна вера на всё королевство, инакомыслие под запретом. Церковь довольна, ересь отступает. Закон держит единство веры и отодвигает раскол, но если ересь всё же пустит корни, она бьёт по стабильности в полтора раза сильнее.",
                resistance: [("loyalty_people", -5)],
                anchors: [("faith", 10), ("loyalty_church", 5)], edges: [("st_heresy", 1.5)]),
            (id: "law_tolerance", group: "Вера", cost: 45, years: 2,
                name: "Терпимость",
                description: "Иноверцев и сектантов не преследуют. Церковь недовольна и долго помнит обиду, зато купцы едут охотнее. Ересь растёт, но почти не колеблет стабильность: раскола не будет.",
                resistance: [("loyalty_church", -10)],
                anchors: [("loyalty_church", -10), ("trade", 5)], edges: [("st_heresy", 0.3)]),
            (id: "law_tithe", cost: 30, years: 1,
                name: "Десятина",
                description: "Десятая доля урожая идёт церкви. Церковь довольна, вера крепче, казна теряет 2 в год. Закон держит церковь сытой, но медленно подпитывает гнёт: тяглецу платить и господину, и клиру.",
                resistance: [("loyalty_people", -10)],
                anchors: [("loyalty_church", 10), ("faith", 5), ("strata", 5)], treasury: -2),
            (id: "law_schools", cost: 60, years: 3,
                name: "Монастырские школы",
                description: "При монастырях учат грамоте детей всех сословий. Дорого, 6 в год, и при правлении основателя отдачи не видно. Через поколения грамотных становится много: они идут в писцы и укрепляют канцелярию, сословные стены тоньше, а книжность под присмотром монахов не рождает ереси.",
                anchors: [("literacy", 20)], edges: [("e14", 0.3)], treasury: -6),
            (id: "law_charters", cost: 60, years: 2,
                name: "Городские вольности",
                description: "Города получают хартии, свой суд и цеха. Торговля и казна растут за десять-двадцать лет. Вольный город принимает беглых и гасит гнёт деревни, но городская грамотность без школ через пару веков готовит ересь книжников. Знать теряет власть над городами.",
                resistance: [("loyalty_nobles", -10)],
                anchors: [("liberties", 35), ("literacy", 15), ("loyalty_nobles", -5)], edges: [("e7", 1)]),
            (id: "law_code", cost: 120, years: 4, requires: AxisAbove("bureaucracy", 39.999),
                name: "Свод законов",
                description: "Единый королевский суд вместо вотчинного. Нужна бюрократия от 40. Дорого и долго, знать ворчит: она теряет суд над своими людьми. Закон держит гнёт в узде: расслоение не душит подвижность и меньше бьёт по народу. Легитимность растёт сразу.",
                resistance: [("loyalty_nobles", -10)],
                anchors: [("loyalty_nobles", -3)], edges: [("e2", 0.7), ("e6", 0.7)],
                on_complete: [Axis("legitimacy", 5)]),
            (id: "law_granaries", cost: 90, years: 3,
                name: "Королевские житницы",
                description: "Корона держит запас хлеба на чёрный день, 4 в год. При хорошем урожае незаметно. Закон держит амбары полными: великий голод редок, народ сыт и спокоен. Купцам дорогого хлеба не видать, торговля ниже.",
                resistance: [("trade", -5)],
                anchors: [("grain", 15), ("trade", -5)], treasury: -4),
            (id: "law_fairs", cost: 45, years: 2,
                name: "Ярмарочное право",
                description: "Ярмарки свободны от мыта баронов. Торговля растёт, казна получает 2-3 в год. Купцы богатеют, города крепнут, но богатство копится у немногих: расслоение растёт и слабо подогревает гнёт. Знать теряет мыто.",
                resistance: [("loyalty_nobles", -10)],
                anchors: [("trade", 15), ("liberties", 5), ("strata", 5)]),
        ],
    ),

    // Per year: faction axes move by `step` toward their default, province loyalty toward
    // `province_loyalty`, crown power modifiers from effects toward 0.
    drift: (step: 1, province_loyalty: 50),

    // Weight of a quiet tick in the random event pick, next to the weights of the events.
    quiet_weight: 20,

    // Stage 26b: at most `events_per_year` events with a choice reach the ruler in a year
    // (his death aside; a message, an event of one choice, is not held back). The others wait
    // in the queue for the next years, the most important first; one waiting longer than
    // `queue_years` past its due year drops, and so does one whose `when` is false as it
    // would show (an ultimatum after the war is over).
    events_per_year: 1,
    queue_years: 3,

    // Stage 26b: the buildings the map shows, by their `Build` id, each a glyph of the
    // game's font (DejaVu Sans; a test checks it). A work of the whole kingdom told by flags
    // shows in the capital: built while `flag` is set, being built while `underway` is.
    buildings: [
        (id: "fort", name: "крепость", icon: "♜"),
        (id: "road", name: "дорога", icon: "═"),
        (id: "market", name: "рынок", icon: "⚖"),
        (id: "abbey", name: "обитель", icon: "☦"),
        (id: "dikes", name: "валы", icon: "≈"),
        (id: "cathedral", name: "собор", icon: "✝", flag: "cathedral", underway: "cathedral_building"),
    ],

    // Province loyalty below this shows as unrest on the map. Display only; below the
    // start loyalty of every own province (40 and up), between the sim triggers (30, 40).
    unrest_below: 35,

    // A newborn from HeirOp(Add).
    new_heir: (name: "Младенец", age: 0, ability: 50, claim: 50, status: Home),

    // Neighbour AI, once a year per neighbour. First its strength moves by `recover` toward
    // its start strength in the preset: losses to wars and tribute heal. Stance: relation
    // below `hostile_below` is Expand when strength >= the weakest crown power on the common
    // border + expand_margin, otherwise (or with no common border) Defend; above
    // `friendly_above` Trade; else Wait. Then relation moves by the stance's `relation` and
    // `drift` toward 0 (old grudges and friendships fade unless kept up), and one roll in
    // 0..100 picks at most one of its `events` (id, chance in percent per year; chances sum
    // to <= 100). Stage 28: a Defend state with no common border sends none (it has no
    // border to threaten).
    // Events targeting a province hit the weakest border province and name the neighbour
    // as its second target; others target the neighbour.
    neighbour_ai: (
        hostile_below: -20,
        friendly_above: 30,
        expand_margin: 0,
        drift: 1,
        recover: 1,
        // `invasion` is a simulation event (events/sim/): the reign drops it as unknown.
        expand: (relation: -2, events: [
            ("neighbour_raid", 20), ("neighbour_ultimatum", 10), ("neighbour_war_declared", 10),
            ("invasion", 15),
        ]),
        defend: (relation: -1, events: [("neighbour_ultimatum", 10)]),
        trade: (relation: 1, events: [("neighbour_trade", 20)]),
        wait: (relation: 0, events: [("neighbour_trade", 5), ("neighbour_ultimatum", 3)]),
        // An event a neighbour starts joins the random pick with this weight, next to
        // quiet_weight and the weights of the pool events; not picked, it is dropped.
        weight: 50,
    ),

    // War, one at a time. StartWar queues `start_event` at the enemy at once.
    // Strength: ours = army * (1 + fort bonus per own fortified province on the enemy border
    // + sum(axis * k) of `bonus`) * treasury factor (treasury_poor at an empty treasury,
    // rising to 1 at treasury_full); theirs = the neighbour's strength.
    // Clash: each side's strength times a roll in `roll`; war_score += (ours - theirs) * score_k,
    // clamped to +-max_score. Tribute(v): treasury += v, the neighbour's strength -= v *
    // tribute_strength. EndWar(outcome): the enemy's strength changes by `end_strength`.
    // War costs: while at war the crown provinces bring `income_penalty` of their income
    // less; the army costs `army_upkeep` a year, a curve (army, upkeep) steeper the bigger
    // the army; every year the treasury is below 0, or a year of peace the income does not
    // cover the army, `desertion` of the army runs away.
    war: (
        start_event: "war_declared",
        army: "army",
        fort: ("fort", 0.1),
        bonus: [("loyalty_nobles", 0.005)],
        treasury_full: 100,
        treasury_poor: 0.6,
        roll: (0.5, 1.5),
        score_k: 0.5,
        max_score: 100,
        tribute_strength: 0.1,
        end_strength: [(Victory, -10), (Draw, 0), (Defeat, 5)],
        income_penalty: 0.3,
        army_upkeep: [(0, 0), (50, 5), (100, 15), (150, 35), (200, 70), (300, 170), (1000, 1000)],
        desertion: 0.2,
        // `{war_won}`, `{war_lost}` in the war's events: «2 сражения» won and lost (stage 25).
        battles: ("сражение", "сражения", "сражений"),
        battles_said: ["ни одного сражения", "одно сражение", "два сражения", "три сражения",
            "четыре сражения", "пять сражений", "шесть сражений", "семь сражений",
            "восемь сражений", "девять сражений", "десять сражений"],
    ),

    // Direct rule has a limit (yearly): the crown holds at most capital crown power *
    // per_power + sum(axis * k of per_axis) provinces itself, the capital included. Beyond
    // that, every year: its weakest provinces (by crown power) over the limit lose `loyalty`,
    // and each of them costs the `penalty` axes and `income` of the yearly income and, while
    // over, lowers the anchors of the `pressure` axes. The land
    // stays with the crown: only the player gives it away (grant_province), or the automaton,
    // whose weight `overreach` makes a grant worth more while the crown is over its limit.
    // Stage 15 (docs/calibration.md): the capital (crown power 90) and bureaucracy 20 give
    // room for 8 at the start, two conquests above the 6 crown lands; the room grows by one
    // per 10 bureaucracy.
    crown_capacity: (
        per_power: 0.07,
        per_axis: [("bureaucracy", 0.1)],
        loyalty: 3,
        income: 2,
        // While over the room, per province over: the anchor of stability lower (stage 19; the
        // yearly `penalty` of stage 15 piled up in the shocks and held them at -100).
        pressure: [("stability", -2)],
    ),

    // Effect Grant: the nearest vassal within `max_distance` border crossings gets the
    // province, otherwise a new house named by the next unused name of names.ron `vassals`,
    // with this loyalty and strength; when the names run out, the nearest vassal at any distance.
    grant: (max_distance: 1, new_loyalty: 60, new_strength: 10, strength: 5),

    // Stage 27: the kingdoms of the world against each other (realm.rs). Every world sees each
    // other kingdom as a neighbour of strength army * `army` + its provinces * `province` + each
    // axis of `axes` through its curve, from that kingdom's own world every year; what the
    // others took from that strength in a year (a war lost, tribute) comes off its army at the
    // `army` rate. A new house on a fallen throne starts with the `usurper` axes at these
    // values. A kingdom with no crown land left is no more: its land goes to the state that
    // holds its capital (`Conqueror`), or every vassal founds a state on his (`Vassals`, also
    // when its own vassal holds the capital). News of the other kingdoms (the summary of the
    // year, the chronicle) below `threshold` are not told; texts name no numbers.
    realm: (
        strength: (
            army: 0.6,
            province: 5,
            axes: [("stability", [(0, 0), (100, 20)]), ("treasury", [(0, 0), (500, 10)])],
        ),
        usurper: [("legitimacy", 30)],
        dissolution: Conqueror,
        news: (
            threshold: 4,
            war: (importance: 4, title: "Война соседей", texts: [
                "Между {realm.тв} и {enemy.тв} началась война: на рубежах жгут сигнальные костры, купцы поворачивают обозы назад.",
                "Из-за рубежа пришла весть: {realm} {realm:двинул|двинула} войско на {enemy.вин}.",
            ]),
            capture: (importance: 4, title: "Чужая земля", texts: [
                "Гонцы донесли, что земля {province} отошла под руку {realm.род}, и {enemy} не {enemy:сумел|сумела} её отстоять.",
                "{realm} {realm:взял|взяла} у {enemy.род} землю {province}, и над её крепостью сменили стяг.",
            ]),
            house: (importance: 4, title: "Смена династии", texts: [
                "В {realm.пр} пал дом {old.род}, и престол занял дом {house.род}.",
                "Из {realm.род} пришла весть: дом {old.род} больше не правит, на престол взошёл дом {house.род}.",
            ]),
            breakaway: (importance: 4, title: "Новое государство", texts: [
                "От {enemy.род} откололась земля {province}: дом {realm} больше не присягает прежним господам и правит сам.",
                "Дом {realm} отложился от {enemy.род}, и в земле {province} родилось новое государство.",
            ]),
            fallen: (importance: 5, title: "Падение державы", texts: [
                "Пришла весть, что {realm.род} больше нет: у державы не осталось своих земель, и их поделили чужие руки.",
                "{realm} {realm:пал|пала}: столица потеряна, и земли державы разошлись по чужим рукам.",
            ]),
        ),
    ),

    // Yearly ruler death risk in per mille: the `base` row of the largest age_from <= age,
    // plus (100 - health) * health_k, plus every risk whose `when` holds. A hit spawns the
    // death event; the ruler dies only if the choice says so. While a death event is on
    // its cooldown, its risk does not count.
    death: (
        base: [(0, 4), (40, 8), (50, 30), (55, 60), (60, 90), (65, 130), (70, 180), (80, 300)],
        health_k: 0.2,
        event: "illness",
        risks: [
            (when: WarStage(Fighting), per_mille: 30, event: "war_wound"),
            (when: Flag("plot"), per_mille: 60, event: "assassination"),
            (when: Flag("plague"), per_mille: 40, event: "illness"),
            (when: RulerAge(70, 200), per_mille: 150, event: "old_age"),
        ],
    ),

    // Game::abdicate fires `event`; its Abdicate effect ends the reign. Unless the
    // institutions axis and the first heir's ability are above their thresholds, the first
    // heir loses `claim_drop` of claim and `contested_flag` is set (succession_dispute).
    abdication: (
        event: "abdication",
        institutions: ("bureaucracy", 60),
        heir_ability: 60,
        claim_drop: 40,
        contested_flag: "succession_contested",
    ),

    // Per year. Ability grows by status until adult_age. Claims move by claim_step toward
    // the target of the current law: eldest (heirs[0]) or others, plus ability * ability_k;
    // a hostage also loses hostage_claim. Birth chance in percent by ruler age, times
    // `unmarried` without the married flag: a child out of wedlock is a bastard, out of the
    // line until recognized (recognize_bastard) with `bastard_claim`, after every lawful
    // heir. The ruler's children (World.line_from) stand first, in birth order, then the
    // collateral line; "eldest" is heirs[0].
    // `death`: yearly risk of every heir in per mille by age, like death.base.
    // Both tables are steps: the row of the largest age_from <= age holds to the end of life.
    // Births end at 50; a ruler crowned grown had children before (sim::born_before: the
    // same table over his adult years, bastards before his wedding, each child past
    // `death`), so few lines die out (stage 15, docs/calibration.md).
    heirs: (
        adult_age: 16,
        growth_home: 2,
        growth_studying: 3.5,
        growth_hostage: 1,
        hostage_claim: -4,
        claim_step: 2,
        // Who succeeds is the law's `rule` (sim::rightful): Absolute, Male, Salic,
        // Seniority, Elective, Partition. Claims say how firm the new ruler sits: the heir the
        // rule puts first has `rightful_claim` at once and moves toward `eldest`, the rest
        // toward `others`, plus ability * ability_k; a new ruler's claim below crisis_claim
        // contests the succession, and so may every heir left (dispute_per_heir percent each).
        // `coronation`: axis shifts at every coronation under the law. `female_heir`: a queen
        // crowned under the law is contested and shifts these axes. `house`: Partition's
        // (loyalty, strength) of a son's house.
        laws: [
            // `name` and `description` are for the UI; {eldest}, {others}, {ability_k},
            // {crisis_claim}, {dispute_per_heir}, {rightful_claim} stand for the numbers of the law.
            (flag: "law_primogeniture", rule: Absolute, eldest: 75, others: 35, ability_k: 0, crisis_claim: 70, rightful_claim: 90,
                name: "Абсолютное первородство",
                description: "Трон получает старший ребёнок правителя, сын или дочь, без детей — старший из боковой линии. Первый в очереди по закону сразу имеет претензию {rightful_claim}, остальные держатся у {others}. Если у наследника претензия ниже {crisis_claim}, престол оспорят."),
            (flag: "law_male", rule: Male, eldest: 75, others: 35, ability_k: 0, crisis_claim: 60, rightful_claim: 90,
                female_heir: [("legitimacy", -10), ("loyalty_nobles", -10)],
                name: "Мужское первородство",
                description: "Трон получает старший сын правителя, и право сына бесспорнее: престол оспорят, только если претензия ниже {crisis_claim}. Первый в очереди по закону сразу имеет претензию {rightful_claim}. Дочь наследует, только если сыновей нет, и тогда престол оспорят, легитимность упадёт, знать будет недовольна."),
            (flag: "law_salic", rule: Salic, eldest: 75, others: 35, ability_k: 0, crisis_claim: 70, rightful_claim: 90,
                coronation: [("legitimacy", 5)],
                name: "Салический закон",
                description: "Престол только мужчинам: сначала сыновья правителя, без них мужчина боковой линии. Женщины не наследуют вовсе: если мужчин в роду не осталось, династия пресекается. Зато право такого короля бесспорнее: легитимность при воцарении выше. Первый в очереди по закону сразу имеет претензию {rightful_claim}. Если у наследника претензия ниже {crisis_claim}, престол оспорят."),
            (flag: "law_seniority", rule: Seniority, eldest: 75, others: 35, ability_k: 0, crisis_claim: 70, dispute_per_heir: 6, rightful_claim: 90,
                name: "Лествичное право",
                description: "Престол старшему в роду: сначала братья правителя по старшинству, потом его дети. На трон приходит взрослый, но дети умершего не уступают дяде: по {dispute_per_heir}% на каждого оставшегося наследника, что престол оспорят."),
            (flag: "law_elective", rule: Elective, eldest: 0, others: 0, ability_k: 0.9, crisis_claim: 65, dispute_per_heir: 3,
                coronation: [("loyalty_nobles", 5), ("legitimacy", -10)],
                name: "Выборный закон",
                description: "Совет избирает самого способного из наследников: претензия каждого растёт к его способностям × {ability_k}, старшинство не важно. Знать при каждом избрании довольна, легитимность ниже. Проигравшие спорят: по {dispute_per_heir}% на каждого оставшегося наследника, и престол оспорят, если у избранного претензия ниже {crisis_claim}."),
            (flag: "law_partition", rule: Partition, eldest: 75, others: 35, ability_k: 0, crisis_claim: 70, rightful_claim: 90,
                coronation: [("loyalty_nobles", 5)], house: (50, 20),
                name: "Разделение",
                description: "Корону получает старший сын, а каждый следующий сын при воцарении — коронную землю в удел и свой дом. Уделы раздаются от дальних земель к столице, столица остаётся у короны. Знать довольна, но земель у короны всё меньше. Если у наследника претензия ниже {crisis_claim}, престол оспорят."),
        ],
        birth: [(0, 0), (16, 30), (35, 22), (45, 10), (50, 0)],
        // Chance in percent that a child is a son.
        male_percent: 50,
        married_flag: "married",
        unmarried: 0.2,
        // Naming an heir over the rightful one (HeirOp Designate, designate_heir, heir_dispute):
        // these axes once; at his coronation a dispute `designate_dispute` percent more likely,
        // and the rightful heir keeps his claim, a rival.
        designate_penalty: [("legitimacy", -10), ("loyalty_nobles", -5), ("loyalty_church", -5)],
        designate_dispute: 40,
        bastard_claim: 20,
        // Disputes from real causes besides the claim: a child crowned (below
        // sim.regency_age), an heir of ability below the first number: chances in percent.
        dispute_minor: 50,
        dispute_weak: (67, 100),
        death: [(0, 120), (1, 40), (5, 6), (16, 6), (30, 10), (40, 15), (50, 30), (55, 60), (60, 90), (65, 130), (70, 180), (80, 300)],
    ),

    // A suit (Effect::Marry, marry_neighbour): the ruler weds without heirs.married_flag,
    // else the first heir in line of `age` or older not yet married. A court at war with the
    // crown, already wed to it or with a relation below refuse_below turns it away outright;
    // else it agrees with the chance in percent: percent + relation * relation_k
    // + sum(axis * k) + (our strength / theirs - 1) * strength_k (war::strengths)
    // - war_penalty while the crown is at war with anyone, 0..=100.
    marriage: (
        age: 14,
        refuse_below: -20,
        percent: 30,
        relation_k: 0.5,
        axes: [("prestige", 0.1)],
        strength_k: 20,
        // A court weds its child into a house at war unwillingly (stage 25).
        war_penalty: 20,
    ),

    // Every coronation in the simulation (sim::crown), in this order: each faction axis moves
    // `reset` of the way back to its anchor under the laws in force (a new page); the axis of legitimacy_from_claim
    // moves its share of the way toward the new ruler's claim (0.5: the mean of the two);
    // a contested succession (abdication.contested_flag) adds `contested`; then the law's
    // `coronation`, then the `axes` of the ruler's traits (sim.traits).
    coronation: (
        reset: 0.3,
        legitimacy_from_claim: ("legitimacy", 0.5),
        contested: [("legitimacy", -10), ("loyalty_nobles", -10)],
    ),

    // The founder's testament (stage 24, testament.rs, Game::write_testament): a precept, up
    // to one order, up to one heir named under seal. It binds from his death with a strength:
    // legend x decay x zeal. Legend at his death: base + axes * k + years of his reign * years
    // + his deeds (cause tags of his decisions, `law` per law he brought in) * k, 0..=max.
    // Decay: the share left by the years since his death (curve). Zeal: by the reader's
    // legitimacy (curve), plus his traits. Every ruler after him adds the precept's weights
    // (and the order's `weight`) times the strength to his AutoChooser (sim.auto keys).
    testament: (
        precepts: [
            (id: "treasury", name: "Полная казна — крепость державы",
                description: "Копить золото и не начинать войн без крайней нужды.",
                // `marriage` 6: a wedding outweighs its dowry for a ruler who counts gold
                // twice too (stage 25, docs/calibration.md).
                weights: {"treasury": 0.3, "income": 2, "province_income": 1, "army": 0.15, "war": -40, "marriage": 6}),
            (id: "sword", name: "Меч кормит род",
                description: "Держать сильное войско и добывать земли оружием.",
                weights: {"war": 10, "army": 0.1, "province": 10, "prestige": 0.3}),
            (id: "faith", name: "Вера превыше всего",
                description: "Беречь церковь и её благословение на престол.",
                weights: {"loyalty_church": 1.2, "legitimacy": 0.5}),
            (id: "land", name: "Ни пяди земли",
                description: "Не раздавать уделов и не уступать земель короны.",
                weights: {"grant": -30, "secede": -20, "province": 30}),
            (id: "peace", name: "Мир с соседями",
                description: "Жить с соседями в дружбе, родниться с ними и избегать войн.",
                weights: {"relation": 0.4, "war": -25, "marriage": 10}),
            (id: "law", name: "Закон превыше короля",
                description: "Крепить приказы и законы, а не волю одного государя.",
                weights: {"bureaucracy": 0.5, "law": 3, "pressure": 1, "stability": 0.5}),
        ],
        // `weight` on the law's flag, on `province`, on `war`; `what` the order in words.
        orders: (
            keep_law: (name: "Хранить закон", weight: 30, what: "не отменять закон «{law}»",
                breach: [
                    "Закон «{law}», который {founder} {founder:завещал|завещала} хранить вечно, был отменён при {ruler.пр}, и многие сочли это изменой памяти {founder.род}.",
                    "{ruler} {ruler:отступил|отступила} от наказа {forebear}: закон «{law}» утратил силу, и при дворе заговорили о дурных знамениях.",
                ]),
            keep_province: (name: "Удержать землю", weight: 30, what: "никогда не отдавать землю {province}",
                breach: [
                    "Землю {province}, которую {founder} {founder:завещал|завещала} никогда не отдавать, корона потеряла при {ruler.пр}.",
                    "Наказ {forebear} был нарушен: земля {province} ушла под чужую руку, и при дворе вспоминали {founder.вин} со стыдом.",
                ]),
            peace: (name: "Мир с соседом", weight: -30, what: "никогда не воевать с {neighbour.тв}",
                breach: [
                    "Мир с {neighbour.тв}, завещанный {founder.тв}, был нарушен при {ruler.пр}: началась война.",
                    "Наказ {forebear} не воевать с {neighbour.тв} пал: войско вновь выступило против соседа, и старики качали головами.",
                ]),
        ),
        legend: (
            base: 0.5,
            axes: [("prestige", 0.005)],
            years: 0.01,
            deeds: [(["law"], 0.1), (["war_won_land", "war_siege_won", "war_won_gold"], 0.15)],
            max: 2,
        ),
        // Half the legend in about 70 years.
        decay: [(0, 1), (35, 0.72), (70, 0.5), (140, 0.2), (300, 0.05)],
        zeal: (
            axis: "legitimacy",
            // A ruler of shaky right clings to the founder's word.
            curve: [(0, 1.6), (30, 1.3), (60, 1), (100, 0.7)],
            traits: {"pious": 0.3, "defiant": -0.7},
        ),
        // Written by a ruler younger than `age` with health at least `health`: rumours that
        // he prepares for death, `per_year` for every year short of `age`. Again at a rewrite.
        rumours: (age: 50, health: 40, per_year: [("loyalty_nobles", -0.5), ("stability", -0.4)]),
        // An heir named by a will over the law is contested this often (heirs.designate_dispute
        // for one named openly); at his coronation `heir` times the strength.
        heir_dispute: 60,
        heir: [("legitimacy", 10)],
        // A choice the testament's own chooser scores highest, at least `margin` above the
        // lowest (an action: worth at least `margin`): `axes` times the strength.
        faithful: (margin: 8, axes: [("legitimacy", 1)]),
        // The order broken: these times the strength, and it binds no more.
        breach: [("legitimacy", -12), ("loyalty_nobles", -6), ("loyalty_church", -6)],
        // {founder} the testator, {ruler}, {forebear} the founder as the ruler calls him (in
        // the genitive: «деда»), {precept}, {order} the order in words, {heir}, {prev},
        // {will} the precept and the order.
        texts: (
            read: ("Завещание основателя", [
                "Когда {founder.вин} похоронили, при дворе вскрыли {founder:его|её} завещание.",
                "Над гробом {founder.род} канцлер сломал печать на {founder:его|её} завещании.",
                "Последнюю волю {founder.род} огласили в тронном зале при всём дворе.",
            ]),
            precept: [
                "Потомкам {founder} {founder:оставил|оставила} заповедь: «{precept}».",
                "Первым {founder:он|она} {founder:завещал|завещала} держаться правила: «{precept}».",
            ],
            order: [
                "Ещё {founder:он|она} {founder:велел|велела} {order}.",
                "Особо наказано было {order}.",
            ],
            heir: [
                "Наследником {founder:он|она} {founder:назвал|назвала} {heir.вин}.",
                "Престол {founder:он|она} {founder:оставил|оставила} {heir.дат}.",
            ],
            faithful: [
                "Так {ruler} {ruler:остался верен|осталась верна} завету {founder.род}.",
                "Помня наказ {forebear}, {ruler} {ruler:поступил|поступила}, как {founder:завещал|завещала} {founder}.",
                "{ruler:Верный|Верная} завету {founder.род}, {ruler} и тут не {ruler:отступил|отступила} от {founder:его|её} слова.",
            ],
            breach: "Завет нарушен",
            crowned: [
                "Так было сказано в завещании {prev.род}, хотя по закону корона причиталась другому.",
                "{ruler} {ruler:получил|получила} престол по тайному завещанию {prev.род}, в обход законного наследника.",
            ],
            willed: [
                "В {year} году {ruler} {ruler:взошёл|взошла} на престол по завещанию прежнего государя, в обход законного наследника.",
                "{ruler} {ruler:получил|получила} корону в {year} году: так было сказано в запечатанном завещании, вскрытом над гробом.",
            ],
            life_founder: [
                "Умирая, {ruler} {ruler:оставил|оставила} потомкам завет: {will}.",
                "В завещании {ruler} {ruler:наказал|наказала} потомкам {will}.",
            ],
            life_kept: [
                "Помня наказ {forebear}, {ruler} {ruler:держался|держалась} завета {founder.род}.",
                "{ruler} свято {ruler:чтил|чтила} завет {founder.род}.",
            ],
            life_broken: [
                "{ruler} {ruler:нарушил|нарушила} завет {founder.род}, и потомки не простили {ruler:ему|ей} этого.",
                "Наказ {forebear} {ruler} не {ruler:сберёг|сберегла}: при {ruler:нём|ней} завет {founder.род} был нарушен.",
            ],
            forebears: [("отца", "матери"), ("деда", "бабки"), ("прадеда", "прабабки"), ("пращура", "праматери")],
            rumour: "При дворе зашептались, что государь готовится к смерти: знать насторожилась.",
            sealed: "{founder} {founder:составил|составила} завещание и {founder:скрепил|скрепила} его печатью; вскроют его над гробом.",
        ),
    ),

    // The dynasty after the founder (sim::run): the same rules year by year, the choices
    // made by sim::AutoChooser, until a fall or `max_years` from tick 0.
    // Falls: no heir, the capital not held by the crown, `usurped_flag`, no crown province.
    sim: (
        max_years: 300,
        // Events of this importance and above go to the chronicle; a new ruler and a
        // province lost or gained always do, with importance `notable`.
        threshold: 4,
        notable: 5,
        // Every player decision marks what it changed with weight 1; the weight is
        // multiplied by `decay` every year. Chronicle entries collect these marks as causes.
        decay: 0.97,
        // The hint of the main cause shows in the entry from this weight on: the founder's
        // decisions fade from the chronicle along with their marks.
        hint_weight: 0.3,
        usurped_flag: "usurped",
        // A ruler younger than regency_age reigns under the flag until he reaches it.
        regency_flag: "regency",
        regency_age: 16,
        // The first heir's death (texts.heir_died) is told from this age on; a younger one
        // only if he was the last heir, none was born after and the dynasty ended NoHeir.
        heir_death_age: 14,
        // Flags of one reign, cleared when the next ruler is crowned.
        reign_flags: ["church_regency"],
        ruler_health: 80,
        // Relation of the state a seceding vassal founds (Effect::Secede).
        secession_relation: -50,
        // Trait chance of a new ruler in percent: percent + ability * ability_k, plus
        // `studying` or `hostage` by the heir's status.
        // `axes`: shifts once, at the coronation; `told`: (of a king, of a queen), added to the
        // coronation entry for the trait with the largest shift.
        traits: [
            (id: "greedy", percent: 35, ability_k: -0.3, studying: 0, hostage: 10,
                axes: [("loyalty_people", -10)],
                told: ("Народ роптал: новый король слыл скупцом.", "Народ роптал: новая королева слыла скупой."),
                retold: [("Ещё на коронационном пиру новый король велел убрать со столов лишние блюда, и по столице поползли слухи о его скупости.", "Ещё на коронационном пиру новая королева велела убрать со столов лишние блюда, и по столице поползли слухи о её скупости."), ("Казначеи радовались, а народ роптал: новый король считал каждый грош.", "Казначеи радовались, а народ роптал: новая королева считала каждый грош.")]),
            (id: "cautious", percent: 10, ability_k: 0.3, studying: 10, hostage: 15,
                axes: [("stability", 5)],
                told: ("Страна вздохнула спокойно: новый король не любил поспешных решений.", "Страна вздохнула спокойно: новая королева не любила поспешных решений."),
                retold: [("Новый король не подписывал ни одного указа, не переспав с ним ночь, и страна вздохнула спокойно.", "Новая королева не подписывала ни одного указа, не переспав с ним ночь, и страна вздохнула спокойно."), ("Советники скоро поняли, что новый король не терпит спешки, и в королевстве стало тише.", "Советники скоро поняли, что новая королева не терпит спешки, и в королевстве стало тише.")]),
            (id: "warlike", percent: 30, ability_k: 0, studying: -15, hostage: 10,
                axes: [("loyalty_nobles", 10)],
                told: ("Знать ликовала: новый король рвался в поход.", "Знать ликовала: новая королева рвалась в поход."),
                retold: [("Рыцари точили мечи: на коронации новый король говорил больше о походах, чем о законах.", "Рыцари точили мечи: на коронации новая королева говорила больше о походах, чем о законах."), ("Знать ликовала, а купцы хмурились: новый король смотрел на карту, как охотник на лес.", "Знать ликовала, а купцы хмурились: новая королева смотрела на карту, как охотник на лес.")]),
            (id: "pious", percent: 10, ability_k: 0, studying: 35, hostage: -5,
                axes: [("loyalty_church", 10)],
                told: ("Церковь возрадовалась: новый король был набожен.", "Церковь возрадовалась: новая королева была набожна."),
                retold: [("Новый король велел служить молебен до пира, а не после, и клир это запомнил.", "Новая королева велела служить молебен до пира, а не после, и клир это запомнил."), ("Епископы благословляли нового короля охотнее прежнего: он знал псалтырь наизусть.", "Епископы благословляли новую королеву охотнее прежнего: она знала псалтырь наизусть.")]),
            // Stage 24: cares little for the founder's word (testament.zeal) and names heirs at will.
            (id: "defiant", percent: 10, ability_k: 0, studying: -5, hostage: 15,
                axes: [("legitimacy", -3)],
                told: ("Старики качали головами: новый король не чтил заветов предков.", "Старики качали головами: новая королева не чтила заветов предков."),
                retold: [("На коронации новый король не стал слушать завет основателя до конца, и старики переглянулись.", "На коронации новая королева не стала слушать завет основателя до конца, и старики переглянулись."), ("Двор шептался: новый король посмеивается над заветами предков.", "Двор шептался: новая королева посмеивается над заветами предков.")]),
        ],
        // AutoChooser: an option scores sum(weight[key] * amount) over its effects, plus a
        // roll in 0..=noise. Keys: axis ids, flag ids (+1 set, -1 cleared; only a change
        // counts, so a law change weighs the new law's flag less the old one's) and effect kinds:
        // province_income, province_population, province_loyalty, health, relation,
        // crown_power, heir_ability, heir_claim (by the delta), army_upkeep (by the change in
        // yearly upkeep an army change brings, war.army_upkeep); build, grant, revoke, secede,
        // war, hostage, death, abdicate, marriage (+1 a wedding; a suit by its chance), recognize
        // (+1 a bastard recognized, plus heir with no heir left); overreach (+1 for a grant while the crown is over
        // crown_capacity); province (+1 gained, -1 given); heir (+1, -1).
        // Weights of the ruler's traits add to `base`.
        auto: (
            noise: 10,
            base: {
                "treasury": 0.3, "income": 2, "army": 0.3, "legitimacy": 1, "stability": 1,
                "bureaucracy": 0.5, "loyalty_nobles": 0.6, "loyalty_church": 0.4,
                "loyalty_people": 0.5, "prestige": 0.3,
                "province_income": 2, "province_population": 0.005, "province_loyalty": 0.2,
                "health": 0.5, "relation": 0.1, "crown_power": 0.5,
                "build": 3, "grant": -20, "revoke": -3, "secede": -10, "war": -10, "hostage": -10,
                "death": -500, "abdicate": -500, "province": 20, "heir": 60,
                "heir_ability": 0.3, "heir_claim": 0.2, "army_upkeep": -0.1, "marriage": 7, "married": 30,
                // `marriage` 7 (20 before stage 25): marry_heir is open in peace too, and at
                // 7 its cost (20 * treasury 0.3) about cancels it, so the automaton weds by it
                // now and then, mostly through heir_marriage (docs/calibration.md, stage 25).
                // A bastard recognized: the church frowns; with no heir left `heir` adds up.
                "recognize": -20,
                // Beyond the limit a grant is weighed like any other (grant, province); with
                // overreach 30 the heirs give the conquests away and warmonger dynasties fall
                // to usurpation (stage 15, docs/calibration.md).
                "overreach": 0,
                "usurped": -12, "plot": -20, "plague": -20,
                // Laws change rarely: `law` for any change, then per point of a law's anchor
                // shift or resistance on a pressing faction (laws.pressure).
                "law": -10, "pressure": 2,
                // Stage 28b: the custom of partition is left for a primogeniture only by a
                // ruler of its trait (cautious, warlike, pious below), and only when the
                // nobles allow it (`laws`, `requires`); never for seniority or election.
                "law_primogeniture": 40, "law_male": 23, "law_salic": 35,
                // An heir named in a sealed will over the law (stage 24, royal_will).
                "bequeath": -2,
            },
            traits: {
                "greedy": {"treasury": 0.3, "income": 2, "province_income": 2},
                "cautious": {"war": -20, "army": 0.3, "stability": 1, "health": 1, "law_primogeniture": 18},
                "warlike": {"war": 25, "army": 0.4, "prestige": 0.7, "province": 20, "law_male": 15},
                "pious": {"loyalty_church": 1.2, "law_salic": 20},
                "defiant": {"bequeath": 25},
            },
        ),
        // (title, text) of the entries the simulation makes itself, told in the past. Names
        // take a case and words agree with sex (text.rs): `{ruler.род}`, `{ruler:взошёл|взошла}`.
        // `crowned`: {ruler} the new ruler, {prev} the last one with his epithet; the lands
        // entries: {province}, {neighbour}, {ruler}; `heir_died`: {heir}; the laws: {law},
        // {ruler}; `partition`: {lands}, {ruler}. The titles stay as they are: the UI and
        // `cli batch` find the entries by them.
        texts: (
            crowned: ("Новое правление", "После {prev.род} на престол {ruler:взошёл|взошла} {ruler}."),
            province_lost: ("Потеря земли", "Корона потеряла {province.вин}: край отошёл под руку {neighbour.род}."),
            province_gained: ("Земля возвращена", "При {ruler.пр} корона вернула себе {province.вин}, отняв край у {neighbour.род}."),
            // The heir first in line died of age risk (heirs.death); see heir_death_age.
            heir_died: ("Смерть наследника", "{heir:Умер|Умерла} {heir}, {heir:первый|первая} в очереди на престол."),
            // The law in force changed (an action done or a choice); {law} is its name.
            law_changed: ("Новый закон о престоле", "{ruler} {ruler:переменил|переменила} порядок наследования: отныне престол переходил по закону «{law}»."),
            // Any other law of `laws` brought in, or repealed with none of its group instead.
            law_enacted: ("Новый закон", "{ruler} {ruler:ввёл|ввела} закон «{law}», и его огласили на площадях всех земель."),
            law_repealed: ("Отмена закона", "{ruler} {ruler:отменил|отменила} закон «{law}», и о нём скоро забыли."),
            partition: ("Земли поделены между братьями", "По закону о разделе младшие братья {ruler.род} получили уделы: {lands}."),
            // More texts of the entries above, picked by seed apart from the main rng.
            variants: {
                "crowned": [
                    "Престол {prev.род} {ruler:унаследовал|унаследовала} {ruler}.",
                    "Ещё не отзвонили колокола по {prev.дат}, а епископ уже поднимал корону над головой {ruler.род}.",
                    "Двор, ещё вчера кланявшийся {prev.дат}, принёс присягу {ruler.дат}.",
                    "В соборе пели многая лета, и {ruler} {ruler:принял|приняла} скипетр, ещё помнивший руку {prev.род}.",
                    "На трон {prev.род} {ruler:сел|села} {ruler}, и глашатаи понесли новое имя по всем землям.",
                ],
                "province_lost": [
                    "Над замками {province.род} подняли знамёна {neighbour.род}, и королевские наместники уехали оттуда навсегда.",
                    "{ruler} не {ruler:удержал|удержала} {province.вин}, и тамошние люди стали подданными {neighbour.род}.",
                    "Межевые столбы перенесли за {province.вин}, и вся тамошняя земля досталась {neighbour.дат}.",
                    "В {province.пр} отныне собирал подати {neighbour}, а не корона.",
                ],
                "province_gained": [
                    "Над замками {province.род} снова подняли королевское знамя, и {neighbour} {neighbour:смирился|смирилась} с потерей.",
                    "Наместники {neighbour.род} покинули {province.вин}, и край вернулся под руку короны.",
                    "В церквях {province.род} снова молились за {ruler.вин}, а не за {neighbour.вин}.",
                    "Ключи от ворот {province.род} привезли к трону на бархатной подушке, и {neighbour.дат} пришлось уступить край.",
                    "Над стенами {province.род} снова подняли королевское знамя, и мытари короны вернулись в свои старые конторы.",
                    "В {province.пр} снова поминали в молитвах {ruler.вин}, и край вернулся под руку короны.",
                ],
                "heir_died": [
                    "Двор облачился в траур: {heir:скончался|скончалась} {heir}, {heir:наследник|наследница} престола.",
                    "Смерть унесла {heir.вин}, на {heir:котором|которой} держались надежды династии.",
                    "Колокола звонили по {heir.дат} три дня, и очередь к престолу стала на одно имя короче.",
                    "{heir} не {heir:дожил|дожила} до своей короны: в соборе {heir:отпели первого|отпели первую} в очереди на трон.",
                    "Гроб {heir.род} несли бароны, которые ещё вчера заискивали перед {heir:ним как перед будущим государем|ней как перед будущей государыней}.",
                ],
                "law_changed": [
                    "По воле {ruler.род} престол с той поры наследовали по закону «{law}».",
                    "Старый порядок престолонаследия отменили, и глашатаи объявили новый: закон «{law}».",
                    "Очередь к трону перекроили заново: {ruler} {ruler:утвердил|утвердила} закон «{law}», и наследники пересчитали свои надежды.",
                    "Писцы переписали родословные набело, ибо отныне корона переходила по закону «{law}».",
                    "{ruler} {ruler:скрепил|скрепила} печатью закон «{law}», и при дворе долго спорили, кому он на руку.",
                ],
                "law_enacted": [
                    "При {ruler.пр} в силу вошёл закон «{law}».",
                    "Глашатаи разнесли по королевству новый закон «{law}», скреплённый печатью {ruler.род}.",
                    "Писцы {ruler.род} разослали по уездам списки закона «{law}», и с того дня по нему судили и рядили.",
                    "{ruler} {ruler:утвердил|утвердила} закон «{law}», и весь тот год о нём спорили в каждой таверне.",
                ],
                "law_repealed": [
                    "При {ruler.пр} закон «{law}» утратил силу.",
                    "Уступив знати и клиру, {ruler} {ruler:отменил|отменила} закон «{law}».",
                    "Закон «{law}» сняли со стен судебных палат, и {ruler} больше о нём не {ruler:вспоминал|вспоминала}.",
                    "Указом {ruler.род} закон «{law}» отменили, и всё пошло по-старому.",
                ],
                "partition": [
                    "Земли короны поделили между сыновьями покойного государя: {lands}.",
                    "Младшие братья {ruler.род} разъехались по своим уделам: {lands}.",
                    "Раздел наследства не пощадил и коронных земель, и младшие сыновья получили уделы: {lands}.",
                    "По старому закону о разделе каждому из братьев {ruler.род} выделили удел, и на карте королевства легли новые межи: {lands}.",
                ],
            },
            // What ended a reign (a RulerDies cause or the abdication event id) and the dynasty,
            // as shown to the player.
            reign_ends: {
                "illness": "болезнь",
                "old_age": "старость",
                "assassination": "убийство",
                "war_wound": "рана на войне",
                "abdication": "отречение",
                "monastery": "уход в монастырь",
            },
            // The subject is the dynasty (feminine): «89 лет на троне · пала от узурпации».
            falls: [
                (NoHeir, "пресеклась без наследника"),
                (CapitalLost, "пала с потерей столицы"),
                (Usurped, "пала от узурпации"),
                (NoCrownLand, "распалась на уделы"),
                (Alive, "правит до сих пор"),
            ],
            // How the dynasty ended, told after its last entry: {ruler} the last ruler, {year}.
            fall_told: [
                (NoHeir, [
                    "Со смертью {ruler.род} род пресёкся: некому было принять корону.",
                    "{ruler} {ruler:умер|умерла}, не оставив наследника, и династия угасла.",
                    "В {year} году {ruler} {ruler:сошёл в могилу бездетным|сошла в могилу бездетной}, и корона осталась лежать на подушке у пустого трона.",
                    "Колокола звонили по {ruler.дат} в {year} году, а звать на престол было некого: род иссяк, как пересохший колодец.",
                    "После {ruler.род} не осталось ни сына, ни дочери, ни внука, и династия догорела тихо, как свеча под утро.",
                ]),
                (CapitalLost, [
                    "Враг вошёл в столицу, и династия, лишившись престольного града, пала.",
                    "С падением столицы рухнула и власть рода: {ruler} {ruler:бежал|бежала}, и корона досталась чужим.",
                    "В {year} году над столицей поднялся дым, и чужие знамёна на её стенах возвестили, что {ruler} {ruler:был последним|была последней} в роду.",
                    "Когда в {year} году пали городские ворота, пала и власть рода: {ruler} {ruler:ушёл|ушла} в изгнание, и корону подняли чужие руки.",
                    "Престольный град взяли приступом в {year} году, и вместе с ним {ruler} {ruler:потерял|потеряла} всё, что ещё держало династию на троне.",
                ]),
                (Usurped, [
                    "Узурпатор сверг {ruler.вин} и прервал династию.",
                    "Трон захватил узурпатор, и {ruler} {ruler:стал|стала} {ruler:последним|последней} в роду, кто носил корону.",
                    "В {year} году узурпатор сел на трон, ещё тёплый после {ruler.род}, и летопись рода оборвалась на полуслове.",
                    "Знать открыла ворота узурпатору, и в {year} году {ruler} {ruler:лишился|лишилась} разом и короны, и будущего своего рода.",
                    "Корона ушла от {ruler.род} к узурпатору в {year} году, и имя династии с тех пор поминали только в прошедшем времени.",
                ]),
                (NoCrownLand, [
                    "Уделы один за другим ушли из-под руки короны, и у {ruler.род} не осталось своей земли: королевство распалось.",
                    "Королевство разошлось по уделам, как старый плащ по швам, и в {year} году {ruler} {ruler:остался|осталась} государем лишь на пергаменте.",
                    "К {year} году каждый вассал правил сам, и корона {ruler.род} стала просто золотым обручем без земли.",
                    "Вассалы растащили коронные земли по одной, и в {year} году у {ruler.род} не осталось ни деревни, ни замка, ни подданных.",
                    "В {year} году державы больше не было: остались уделы и их хозяева, а {ruler.дат} было нечем править.",
                ]),
                (Alive, [
                    "Династия правит и поныне: на троне {ruler}, и летопись ещё не дописана.",
                    "На троне по-прежнему {ruler}, и последняя страница этой летописи ещё пуста.",
                    "Род всё ещё у власти: в {year} году корону носит {ruler}, и перо летописца не отложено.",
                    "Династия стоит и поныне, и {ruler} продолжает дело, начатое основателем.",
                    "Летопись здесь прерывается, но не кончается: {ruler} правит, и род жив.",
                ]),
            ],
            // Epithets by the deeds of a reign (data.rs `Epithet`): cause tags of the choices
            // and actions, `trait:<id>`, `law`, `province_gained`, `province_lost`,
            // `heir_died`. The most deeds per `min` wins, the first on a tie; `told` is the
            // sentence of the life, {epithet.тв} the epithet in a case. `also`: its other
            // names, one picked by seed (stage 26c).
            epithets: [
                (name: ("Собиратель земель", "Собирательница земель"), min: 3,
                    also: [("Завоеватель", "Завоевательница"), ("Великий", "Великая")],
                    deeds: ["province_gained", "war_won_land", "war_siege_won"],
                    told: ["{ruler} {ruler:приумножил|приумножила} владения короны, и {ruler:его|её} прозвали {epithet.тв}.",
                        "Земли, присоединённые {ruler.тв}, надолго остались за короной, и в летописи {ruler:он вошёл|она вошла} как {ruler} {epithet}.",
                        "При {ruler.пр} границы королевства раздвинулись, и {ruler:его|её} помнят как {epithet.вин}.",
                        "Каждая новая земля под рукой короны прибавляла {ruler.дат} славы, и потомки звали {ruler:его|её} {epithet.тв}.",
                        "{ruler} {ruler:оставил|оставила} наследникам больше земли, чем {ruler:получил|получила} сам{ruler:|а}, и за это {ruler:его|её} величали {epithet.тв}."]),
                (name: ("Несчастный", "Несчастная"), min: 3,
                    also: [("Злосчастный", "Злосчастная"), ("Скорбный", "Скорбная")],
                    deeds: ["province_lost", "heir_died", "war_lost_hostage", "invasion_yielded", "revolt_conceded"],
                    told: ["Беды не оставляли {ruler.вин} всё правление, и летописец назвал {ruler:его|её} {epithet.тв}.",
                        "Судьба не щадила {ruler.род}: потери шли одна за другой, и {ruler:его|её} помнили как {epithet.вин}.",
                        "Что ни год, то потеря: так прошло правление {ruler.род}, и летопись зовёт {ruler:его|её} {epithet.тв}.",
                        "{ruler} {ruler:хоронил|хоронила} близких и {ruler:терял|теряла} земли, и в народе {ruler:его|её} прозвали {epithet.тв}.",
                        "Над {ruler.тв} будто висел злой рок, и потомки поминали {ruler:его|её} не иначе как {epithet.вин}."]),
                (name: ("Воитель", "Воительница"), min: 3,
                    also: [("Храбрый", "Храбрая"), ("Воинственный", "Воинственная")],
                    deeds: ["trait:warlike", "war_declared_by_crown", "war_accepted", "invasion_met", "war_attack", "war_storm", "war_last_stand", "war_battle", "nomads_fought", "incident_raid"],
                    told: ["Почти всё правление {ruler} {ruler:провёл|провела} в седле, и в летописи {ruler:он остался|она осталась} {epithet.тв}.",
                        "{ruler} редко {ruler:снимал|снимала} доспехи, и потомки звали {ruler:его|её} {epithet.тв}.",
                        "Мирных лет при {ruler.пр} было мало, походов много, и в песнях {ruler:его|её} зовут {epithet.тв}.",
                        "{ruler} {ruler:знал|знала} дым походного костра лучше, чем запах дворцовых свечей, и {ruler:его|её} прозвали {epithet.тв}.",
                        "Войско любило {ruler.вин} и ходило за {ruler:ним|ней} куда угодно, и в летописях за {ruler:ним|ней} осталось имя {epithet}."]),
                (name: ("Строитель", "Строительница"), min: 2,
                    also: [("Созидатель", "Созидательница"), ("Зодчий", "Зодчая")],
                    deeds: ["fort_built", "road_built", "market_built", "cathedral_crown", "cathedral_alms", "fire_stone", "mine_crown", "pilgrims_abbey", "flood_dikes", "golden_cathedral", "prosperity_saved"],
                    told: ["За крепости, дороги и храмы, поставленные при {ruler.пр}, потомки прозвали {ruler:его|её} {epithet.тв}.",
                        "{ruler} больше всего {ruler:любил|любила} строить, и в народе {ruler:его|её} звали {epithet.тв}.",
                        "Камень, положенный при {ruler.пр}, стоит и поныне, и по нему {ruler:его|её} помнят как {epithet.вин}.",
                        "{ruler} {ruler:оставил|оставила} после себя стены, мосты и колокольни, и потомки прозвали {ruler:его|её} {epithet.тв}.",
                        "Где {ruler:проезжал|проезжала} {ruler}, там вырастали леса строек, и в летописи {ruler:он вошёл|она вошла} как {ruler} {epithet}."]),
                (name: ("Законодатель", "Законодательница"), min: 2,
                    also: [("Правосудный", "Правосудная")],
                    deeds: ["law", "golden_laws", "court_clerks"],
                    told: ["Законы, введённые {ruler.тв}, пережили {ruler:его|её}, и потомки звали {ruler:его|её} {epithet.тв}.",
                        "{ruler} {ruler:правил|правила} пером, а не мечом, и в летописи {ruler:его|её} назвали {epithet.тв}.",
                        "Указы {ruler.род} читали на площадях ещё при правнуках, и за {ruler:ним|ней} закрепилось прозвище {epithet}.",
                        "При {ruler.пр} королевство получило законы, которые помнили дольше, чем войны, и {ruler:его|её} прозвали {epithet.тв}.",
                        "Судьи ещё долго сверялись с уложениями {ruler.род}, и потомки величали {ruler:его|её} {epithet.тв}."]),
                (name: ("Грозный", "Грозная"), min: 3,
                    also: [("Суровый", "Суровая"), ("Жестокий", "Жестокая")],
                    deeds: ["plot_arrests", "plot_executed", "riot_crushed", "elder_hanged", "heresy_burned", "famine_ignored", "plague_quarantine", "peasants_crushed", "schism_crushed", "crisis_crushed", "revolt_crushed", "search_decreed", "villages_squeezed", "nobles_refused", "assembly_dictated", "runaways_returned"],
                    told: ["Казни и расправы {ruler.род} помнили долго, и {ruler:его|её} прозвали {epithet.тв}.",
                        "Перед {ruler.тв} трепетали и бароны, и чернь, и за {ruler:ним|ней} навсегда осталось прозвище {epithet}.",
                        "Виселицы при {ruler.пр} не пустовали, и в народе {ruler:его|её} звали {epithet.тв}, понизив голос.",
                        "{ruler} {ruler:правил|правила} так, что бароны боялись спать, а мужики боялись роптать, и {ruler:его|её} прозвали {epithet.тв}.",
                        "Расправы {ruler.род} помнили и внуки казнённых, и в летописи за {ruler:ним|ней} осталось имя {epithet}."]),
                (name: ("Набожный", "Набожная"), min: 3,
                    also: [("Благочестивый", "Благочестивая"), ("Богомольный", "Богомольная")],
                    deeds: ["trait:pious", "church_tithe", "church_lands", "cathedral_crypt", "festival_procession", "plague_prayer", "heresy_synod", "drought_prayer", "illness_prayer", "heir_prayer", "fever_prayer", "tutor_church", "regency_church", "vows_endowed", "disaster_prayer", "famine_monasteries", "pestilence_monks", "quarrel_church", "succession_church", "crisis_council"],
                    told: ["{ruler} {ruler:строил|строила} обители и не {ruler:пропускал|пропускала} ни одной службы, и в народе {ruler:его|её} звали {epithet.тв}.",
                        "Церковь не знала покровителя щедрее, и {ruler.вин} прозвали {epithet.тв}.",
                        "{ruler} {ruler:молился|молилась} чаще, чем {ruler:советовался|советовалась} с канцлером, и клир прозвал {ruler:его|её} {epithet.тв}.",
                        "Колокола обителей, поставленных при {ruler.пр}, долго звонили по {ruler:нему|ней}, и в памяти {ruler:он остался|она осталась} {epithet.тв}.",
                        "У церкви не было при дворе друга вернее, и в монастырских книгах {ruler.вин} зовут {epithet.тв}."]),
                (name: ("Щедрый", "Щедрая"), min: 3,
                    also: [("Добрый", "Добрая"), ("Милостивый", "Милостивая")],
                    deeds: ["festival_people", "festival_tourney", "famine_relief", "famine_tax_relief", "people_tax_cut", "riot_bread", "fire_rebuilt", "flood_relief", "disaster_relief", "famine_granaries", "peasants_appeased", "bread_sold", "prosperity_feast", "villages_corvee_forgiven", "drought_grain"],
                    told: ["{ruler} не {ruler:скупился|скупилась} ни на хлеб, ни на праздники, и народ прозвал {ruler:его|её} {epithet.тв}.",
                        "Хлеб из королевских амбаров при {ruler.пр} раздавали не скупясь, и народ звал {ruler.вин} {epithet.тв}.",
                        "{ruler} {ruler:кормил|кормила} голодных и {ruler:поил|поила} пирующих, и в песнях за {ruler:ним|ней} осталось имя {epithet}.",
                        "Казна при {ruler.пр} пустела быстро, но не напрасно, и потомки прозвали {ruler:его|её} {epithet.тв}.",
                        "Про {ruler.вин} говорили, что у {ruler:него|неё} не бывает запертых амбаров, и {ruler:его|её} величали {epithet.тв}."]),
                (name: ("Мудрый", "Мудрая"), min: 3,
                    also: [("Разумный", "Разумная")],
                    deeds: ["trait:cautious", "court_divide", "assembly_heard", "elder_heard", "border_arbitration", "dispute_council", "appanage_council", "plot_watched", "tutor_scholar", "embassy_treaty", "runaways_settled", "search_limited"],
                    told: ["{ruler} {ruler:умел|умела} выслушать и знать, и простолюдинов, и {ruler:его|её} прозвали {epithet.тв}.",
                        "{ruler} редко {ruler:спешил|спешила} и почти никогда не {ruler:ошибался|ошибалась}, и потомки звали {ruler:его|её} {epithet.тв}.",
                        "Споры, которые при других королях решали мечом, {ruler} {ruler:решал|решала} словом, и за это {ruler:его|её} прозвали {epithet.тв}.",
                        "Советы {ruler.род} вспоминали ещё долго, и в летописи {ruler:он остался|она осталась} {epithet.тв}.",
                        "{ruler} {ruler:умел|умела} ждать и слушать, и в памяти народа {ruler:он остался|она осталась} {epithet.тв}."]),
                (name: ("Миролюбивый", "Миролюбивая"), min: 3,
                    also: [("Миротворец", "Миротворица")],
                    deeds: ["ultimatum_paid", "war_bought_off", "invasion_bought_off", "trade_opened", "border_yielded", "war_sue_for_peace", "war_draw_gifts", "nomads_paid", "incident_hushed", "neighbour_married", "heir_married_foreign"],
                    told: ["{ruler} {ruler:предпочитал|предпочитала} войне откуп и торг, и в летописи {ruler:его|её} назвали {epithet.тв}.",
                        "{ruler} {ruler:умел|умела} откупиться от войны и сторговаться с соседом, и {ruler:его|её} прозвали {epithet.тв}.",
                        "При {ruler.пр} мечи ржавели в ножнах, а купцы богатели, и {ruler:его|её} прозвали {epithet.тв}.",
                        "{ruler} {ruler:покупал|покупала} мир серебром и словом, и летопись называет {ruler:его|её} {epithet.тв}.",
                        "Посольств при {ruler.пр} было больше, чем войн, и в памяти {ruler:он остался|она осталась} {epithet.тв}."]),
                (name: ("Недолгий", "Недолгая"), min: 0, years: 3, deeds: [],
                    also: [("Мимолётный", "Мимолётная")],
                    told: ["Правление {ruler.род} было так коротко, что в памяти {ruler:он остался|она осталась} {epithet.тв}.",
                        "{ruler} едва {ruler:успел|успела} примерить корону, и летопись запомнила {ruler:его|её} {epithet.тв}.",
                        "Царствование {ruler.род} промелькнуло, как летняя гроза, и в памяти {ruler:он остался|она осталась} {epithet.тв}.",
                        "О {ruler.пр} летопись пишет мало, ибо {ruler:он правил|она правила} недолго, и {ruler:его|её} прозвали {epithet.тв}.",
                        "Трон не успел привыкнуть к {ruler.дат}, и потомки звали {ruler:его|её} {epithet.тв}."]),
                (name: ("Тихий", "Тихая"), min: 0, deeds: [],
                    also: [("Кроткий", "Кроткая"), ("Смиренный", "Смиренная")],
                    told: ["Правление {ruler.род} прошло без громких дел, и потомки звали {ruler:его|её} {epithet.тв}.",
                        "Летописи говорят о правлении {ruler.род} немного, и в памяти {ruler:он остался|она осталась} {epithet.тв}.",
                        "При {ruler.пр} не было ни великих войн, ни великих бед, и потомки прозвали {ruler:его|её} {epithet.тв}.",
                        "{ruler} {ruler:правил|правила} неслышно, как течёт широкая река, и в летописи {ruler:он остался|она осталась} {epithet.тв}.",
                        "Годы {ruler.род} прошли без шума и без крови, и {ruler:его|её} звали {epithet.тв}."]),
            ],
            // The life of a ruler in the family tree (data.rs `Life`): how the reign began,
            // the epithet, the `deeds` most important entries, how it ended. {ruler}, {year}
            // the year the phrase is about, {years} the years of the reign, {law}, {deed}.
            // Every phrase is one sentence. The deeds are joined by the gap between them:
            // `deed` the first, `same_year`, `soon` (up to `soon_years`) and `later`.
            life: (
                founder: [
                    "{ruler} {ruler:принял|приняла} корону в {year} году и {ruler:положил|положила} начало династии.",
                    "В {year} году корона досталась {ruler.дат}, и с {ruler:него|неё} повёлся царствующий род.",
                    "С {ruler.род}, {ruler:венчанного|венчанной} на царство в {year} году, начинается летопись рода.",
                    "Родословное древо дома растёт от {ruler.род}, {ruler:взошедшего|взошедшей} на престол в {year} году.",
                    "В {year} году {ruler} {ruler:поднял|подняла} над столицей знамя своего рода, и с того дня повелась династия.",
                ],
                regency: [
                    "{ruler} {ruler:взошёл|взошла} на престол ребёнком в {year} году, и первые годы за {ruler:него|неё} правили регенты.",
                    "В {year} году корону возложили на {ruler:малолетнего|малолетнюю} {ruler.вин}, и страной правил регентский совет.",
                    "{ruler} {ruler:был ещё мальчиком|была ещё девочкой}, когда в {year} году {ruler:его|её} усадили на трон, и долгие годы указы подписывали за {ruler:него|неё}.",
                    "В {year} году престол перешёл к {ruler:малолетнему|малолетней} {ruler.дат}, и до {ruler:его|её} совершеннолетия королевством правили опекуны.",
                    "Корона, надетая на {ruler.вин} в {year} году, была {ruler:ему|ей} велика, и пока {ruler:он рос|она росла}, правил совет.",
                ],
                designated: [
                    "В {year} году на престол {ruler:взошёл|взошла} {ruler}, {ruler:названный|названная} наследником в обход законного права.",
                    "{ruler} {ruler:получил|получила} корону в {year} году по воле прежнего государя, а не по закону, и многие этого не простили.",
                    "В {year} году корону {ruler:получил|получила} {ruler}, хотя по закону очередь была не {ruler:его|её}.",
                    "{ruler} {ruler:взошёл|взошла} на престол в {year} году по слову прежнего государя, через голову законных наследников.",
                    "Воля покойного, а не закон, отдала корону {ruler.дат} в {year} году, и обойдённые этого не забыли.",
                ],
                contested: [
                    "{ruler} {ruler:взошёл|взошла} на престол в {year} году, но {ruler:его|её} право оспаривали с первого дня.",
                    "Корона досталась {ruler.дат} в {year} году в смуте и спорах: не все признали {ruler:его|её} право.",
                    "В {year} году {ruler} {ruler:надел|надела} корону, но присягали {ruler.дат} нехотя и не все.",
                    "{ruler} {ruler:принял|приняла} престол в {year} году под ропот знати, и первые годы {ruler:ему|ей} пришлось доказывать своё право.",
                    "Царствование {ruler.род} началось в {year} году со смуты: претенденты не признавали {ruler:его|её} венца.",
                ],
                lawful: [
                    "{ruler} {ruler:взошёл|взошла} на престол в {year} году по закону «{law}».",
                    "В {year} году, как велел закон «{law}», корону {ruler:принял|приняла} {ruler}.",
                    "{ruler} {ruler:унаследовал|унаследовала} престол в {year} году бесспорно, по праву, что давал закон «{law}».",
                    "В {year} году корона по закону «{law}» перешла к {ruler.дат}, и никто не оспорил этого права.",
                    "{ruler} {ruler:наследовал|наследовала} трон в {year} году так, как велел закон «{law}», без смуты и споров.",
                ],
                deed: [
                    "В {year} году {deed}.",
                    "{year} год запомнился тем, что {deed}.",
                    "Под {year} годом летописец записал, что {deed}.",
                    "Памятен {year} год: {deed}.",
                    "В {year} году, как пишет летописец, {deed}.",
                ],
                same_year: [
                    "В том же году {deed}.",
                    "Тогда же {deed}.",
                    "Не успел закончиться тот год, как {deed}.",
                    "Тот же год принёс и другое: {deed}.",
                    "Ещё до конца года {deed}.",
                ],
                soon: [
                    "Вскоре {deed}.",
                    "Не прошло и трёх лет, как {deed}.",
                    "А в {year} году {deed}.",
                    "Спустя недолгое время {deed}.",
                    "Следом, в {year} году, {deed}.",
                ],
                later: [
                    "Много позже, в {year} году, {deed}.",
                    "Прошли годы, и в {year} году {deed}.",
                    "Годы спустя {deed}.",
                    "Ещё позже, в {year} году, {deed}.",
                    "Лишь через несколько лет, в {year} году, {deed}.",
                ],
                soon_years: 3,
                deeds: 3,
                ends: {
                    "illness": [
                        "{ruler} {ruler:умер|умерла} от болезни в {year} году, процарствовав {years}.",
                        "Болезнь свела {ruler.вин} в могилу в {year} году, и {ruler:он|она} {ruler:правил|правила} {years}.",
                        "Спустя {years} на троне {ruler.вин} сразила болезнь, и в {year} году {ruler:его|её} отпели в соборе.",
                        "Болезнь подтачивала {ruler.вин} долго и в {year} году взяла своё, а на троне {ruler:он пробыл|она пробыла} {years}.",
                        "В {year} году {ruler} {ruler:слёг|слегла} в тяжкой болезни и уже не {ruler:встал|встала}, проправив {years}.",
                    ],
                    "old_age": [
                        "{ruler} {ruler:скончался|скончалась} в глубокой старости в {year} году, процарствовав {years}.",
                        "В {year} году {ruler} мирно {ruler:угас|угасла} от старости, проправив {years}.",
                        "{ruler} {ruler:дожил|дожила} до седин и тихо {ruler:отошёл|отошла} во сне в {year} году, процарствовав {years}.",
                        "В {year} году {ruler} {ruler:умер|умерла} в своей постели, {ruler:окружённый|окружённая} внуками, и {ruler:правил|правила} к тому дню {years}.",
                        "Смерть пришла к {ruler.дат} в {year} году не спеша, как приходит к старикам, и застала {ruler:его|её} на троне, где {ruler:он|она} {ruler:провёл|провела} {years}.",
                    ],
                    "assassination": [
                        "В {year} году {ruler} {ruler:пал|пала} от руки убийц, процарствовав {years}.",
                        "Заговорщики оборвали жизнь {ruler.род} в {year} году, и {ruler:он|она} {ruler:правил|правила} всего {years}.",
                        "В {year} году {ruler.вин} зарезали в собственных покоях, и {ruler:он|она} {ruler:правил|правила} {years}.",
                        "В {year} году {ruler} {ruler:выпил|выпила} за ужином отравленное вино и к утру {ruler:был мёртв|была мертва}, процарствовав {years}.",
                        "Кинжал заговорщика настиг {ruler.вин} в {year} году на ступенях собора, после того как {ruler:он|она} {ruler:правил|правила} {years}.",
                    ],
                    "war_wound": [
                        "В {year} году {ruler} {ruler:умер|умерла} от раны, полученной в бою, процарствовав {years}.",
                        "Стрела, полученная в бою, загноилась, и в {year} году {ruler} {ruler:умер|умерла}, процарствовав {years}.",
                        "В {year} году {ruler} {ruler:скончался|скончалась} от ран, принятых в сече, а {ruler:правил|правила} перед тем {years}.",
                        "Боевая рана свела {ruler.вин} в могилу в {year} году, и {ruler:он|она} {ruler:царствовал|царствовала} {years}.",
                        "{ruler} {ruler:правил|правила} {years} и {ruler:умер|умерла} в {year} году в походном шатре, от раны, полученной в бою.",
                    ],
                    "abdication": [
                        "В {year} году {ruler} {ruler:отрёкся|отреклась} от престола, процарствовав {years}.",
                        "Через {years} правления {ruler} {ruler:сложил|сложила} корону и {ruler:отрёкся|отреклась} от престола.",
                        "Устав от власти, {ruler} {ruler:отрёкся|отреклась} от престола в {year} году, проправив {years}.",
                        "В {year} году {ruler} при всём дворе {ruler:снял|сняла} с себя корону и {ruler:отрёкся|отреклась} от престола, на котором {ruler:провёл|провела} {years}.",
                        "{ruler} {ruler:правил|правила} {years}, а в {year} году {ruler:отрёкся|отреклась} от престола и {ruler:доживал|доживала} век вдали от двора.",
                    ],
                    "monastery": [
                        "В {year} году {ruler} {ruler:ушёл|ушла} в монастырь, оставив престол, на котором {ruler:провёл|провела} {years}.",
                        "В {year} году {ruler} {ruler:сменил|сменила} корону на монашеский клобук, процарствовав {years}.",
                        "Спустя {years} на престоле {ruler} {ruler:ушёл|ушла} в обитель и в {year} году {ruler:принял|приняла} постриг.",
                        "В {year} году за {ruler.тв} закрылись ворота монастыря, и опустел престол, где {ruler:он|она} {ruler:провёл|провела} {years}.",
                        "{ruler} {ruler:царствовал|царствовала} {years} и в {year} году {ruler:оставил|оставила} мир ради кельи и молитвы.",
                    ],
                },
                // A ruler alive when the dynasty fell under him, or still reigning.
                falls: [
                    (CapitalLost, [
                        "В {year} году {ruler} {ruler:потерял|потеряла} столицу, и с нею пала династия.",
                        "В {year} году враг ворвался в столицу, и {ruler} {ruler:бежал|бежала} из горящего дворца, унося с собой конец династии.",
                        "Столица пала в {year} году, и вместе с её воротами рухнул трон {ruler.род}.",
                        "{ruler} {ruler:правил|правила} {years}, пока в {year} году чужое войско не взяло престольный город.",
                        "В {year} году над стенами столицы подняли чужое знамя, и {ruler} {ruler:остался|осталась} государем без города и без трона.",
                    ]),
                    (Usurped, [
                        "В {year} году узурпатор сверг {ruler.вин}, и династия пресеклась на {ruler:нём|ней}.",
                        "В {year} году узурпатор занял трон, и {ruler} {ruler:стал последним|стала последней} в роду, кто носил венец.",
                        "Узурпатор отнял у {ruler.род} корону в {year} году, и род сошёл с престола навсегда.",
                        "{ruler} {ruler:правил|правила} {years}, пока в {year} году узурпатор не вошёл во дворец с мечом и не сорвал с {ruler:него|неё} венец.",
                        "В {year} году знать открыла ворота узурпатору, и {ruler.вин} свели с трона, на котором {ruler:он|она} {ruler:провёл|провела} {years}.",
                    ]),
                    (NoCrownLand, [
                        "К {year} году у {ruler.род} не осталось ни одной своей земли: королевство распалось на уделы.",
                        "К {year} году уделы разошлись по рукам вассалов, и {ruler} {ruler:остался королём|осталась королевой} без королевства.",
                        "В {year} году последняя коронная земля ушла из рук {ruler.род}, и держава рассыпалась на уделы.",
                        "{ruler} {ruler:правил|правила} {years}, и к {year} году от королевства остались лишь гербы на чужих замках.",
                        "К {year} году каждый вассал был сам себе государем, и корона на голове {ruler.род} больше ничего не значила.",
                    ]),
                    (Alive, [
                        "{ruler} правит и поныне, уже {years}.",
                        "{ruler} и сейчас на престоле: {ruler:он|она} правит уже {years}.",
                        "Правление {ruler.род} ещё не окончено: за плечами {years} на троне.",
                        "{ruler} по-прежнему носит корону, правит уже {years}, и конец этой главы ещё не написан.",
                        "Летопись не закрыта: {ruler} царствует уже {years}.",
                    ]),
                ],
                years: ("год", "года", "лет"),
            ),
            // Two linked events of one year or two told as one entry (stage 26c, `sim::fuse`):
            // {a} the first without its full stop, {b} the second from a small letter. `pairs`
            // join the events named, with a title of their own if set; other events join when
            // they share a target or a chain, by `same_year` or `next_year`.
            // Openings of a told that start a clause of their own: a life or a fused entry puts
            // a comma before it («Вскоре, пока орда...»).
            clauses: ["пока ", "когда ", "чтобы ", "едва ", "после того как ", "если ", "хотя ",
                "не дожидаясь ", "прослышав ", "узнав ", "проиграв ", "выиграв ", "уступив ",
                "устав ", "пережив ", "заплатив ", "получив ", "потеряв "],
            fuse: (
                same_year: [
                    "{a}, а вскоре {b}.",
                    "{a}; в тот же год {b}.",
                    "{a}, и не успела улечься эта тревога, как {b}.",
                    "{a}; следом за тем {b}.",
                    "{a}. Тот год на этом не кончился: {b}.",
                ],
                next_year: [
                    "{a}, а на следующий год {b}.",
                    "{a}. Год спустя {b}.",
                    "{a}. Не прошло и года, как {b}.",
                    "{a}. На другой год {b}.",
                    "{a}, а в новом году {b}.",
                ],
                pairs: [
                    (first: ["dis_drought", "prov_crop_failure", "great_famine"], then: ["cap_riot"],
                        title: "Голодный бунт",
                        joins: [
                            "{a}. Пустые амбары скоро вывели людей на улицы: {b}.",
                            "{a}, и голод привёл толпу к воротам дворца: {b}.",
                            "{a}; хлеба не хватило, а с ним и терпения: {b}.",
                        ]),
                    (first: ["cap_fire"], then: ["cap_riot"],
                        joins: [
                            "{a}. Погорельцы, оставшиеся без крова, первыми взялись за колья: {b}.",
                            "{a}, и пепелище быстро стало площадью бунта: {b}.",
                            "{a}. Дым ещё не рассеялся, а в городе уже кричали: {b}.",
                        ]),
                    (first: ["cap_plague", "dis_pestilence", "disaster"], then: ["cap_riot", "fac_heresy"],
                        joins: [
                            "{a}. Страх перед мором обернулся злобой: {b}.",
                            "{a}, и люди, хоронившие близких, искали виноватых: {b}.",
                            "{a}. Мор оставил после себя не только могилы: {b}.",
                        ]),
                    (first: ["dis_flood"], then: ["dis_pestilence", "prov_crop_failure"],
                        joins: [
                            "{a}. Вода ушла, а беда осталась: {b}.",
                            "{a}, и вслед за водой пришла новая напасть: {b}.",
                            "{a}. Едва просохли поля, как {b}.",
                        ]),
                    (first: ["cap_plot"], then: ["cap_plot_unmasked", "assassination"],
                        title: "Заговор",
                        joins: [
                            "{a}. Скоро всё разрешилось: {b}.",
                            "{a}, и долго ждать развязки не пришлось: {b}.",
                            "{a}. Тайное недолго оставалось тайным: {b}.",
                        ]),
                    (first: ["war_declared", "neighbour_war_declared", "invasion"], then: ["war_clash"],
                        joins: [
                            "{a}. Первая кровь пролилась скоро: {b}.",
                            "{a}, и вскоре войска сошлись лицом к лицу: {b}.",
                            "{a}. Ждать сечи пришлось недолго: {b}.",
                        ]),
                    (first: ["war_clash"], then: ["war_siege", "war_talks"],
                        joins: [
                            "{a}. Война на том не кончилась: {b}.",
                            "{a}, а за стычкой последовало большее: {b}.",
                            "{a}. Следом война повернула по-новому: {b}.",
                        ]),
                    (first: ["war_siege", "war_talks", "war_clash"], then: ["war_victory", "war_defeat", "war_draw"],
                        title: "Конец войны",
                        joins: [
                            "{a}. Так война подошла к концу: {b}.",
                            "{a}, и вскоре всё решилось: {b}.",
                            "{a}. Развязка не заставила себя ждать: {b}.",
                        ]),
                    (first: ["great_famine", "unrest"], then: ["peasant_war"],
                        joins: [
                            "{a}. Голодные взялись за косы: {b}.",
                            "{a}, и терпение мужиков лопнуло: {b}.",
                            "{a}. Из голода родилась война: {b}.",
                        ]),
                ],
            ),
        ),
    ),
)
