// Events started by the neighbour AI (`rules.ron` neighbour_ai), never from the random pool
// on their own: the AI offers them to the pick. A province event (the raid) also knows its
// raider, so `{neighbour}` and `EventTarget` neighbour effects work there too.
[
    (
        id: "neighbour_ultimatum",
        image: "ultimatum",
        title: "Ультиматум: {neighbour}",
        text: "Послы {neighbour.род} входят в тронный зал не кланяясь. Они требуют дани серебром и скотом и обещают, что за отказ заплатят порубежные сёла.",
        texts: [
            "Грамота {neighbour.род} короткая и дерзкая: дань к Михайлову дню, или войско перейдёт реку. Гонец ждёт ответа и не снимает шапки.",
            "У границы стоят чужие полки, а в столицу прискакал посол с пустым сундуком для дани. {neighbour} ждёт, что {ruler} испугается.",
        ],
        when: All([]),
        weight: 0,
        once: false,
        cooldown_years: 0,
        importance: 3,
        target: Neighbour,
        choices: [
            (
                text: "Заплатить дань серебром",
                effects: [Axis("treasury", -40), Axis("prestige", -3), Relation(EventTarget, 10)],
                cause_tag: "ultimatum_paid",
                hint: "Купленный мир стоит ровно столько, сколько заплачено.",
                told: "{neighbour} {neighbour:потребовал|потребовала} дани, грозя мечом, и {ruler} {ruler:заплатил|заплатила}, не торгуясь.",
                retold: [
                    "Сундук с серебром увезли за рубеж под охраной чужих всадников, и на границе на время стало тихо.",
                    "Корона откупилась от угроз {neighbour.род}: дань отсчитали в тронном зале при послах, и казначей пересчитывал монеты дважды.",
                ],
            ),
            (
                text: "Выгнать послов из столицы",
                effects: [Axis("prestige", 3), Relation(EventTarget, -15)],
                cause_tag: "ultimatum_refused",
                hint: "Выгнанные послы возвращаются с войском.",
                told: "{neighbour} {neighbour:потребовал|потребовала} дани, но {ruler} {ruler:выгнал|выгнала} послов из столицы.",
                retold: [
                    "Посол {neighbour.род} уехал без дани и без шапки: её сбили с него стражники у ворот, и двор смеялся до вечера.",
                    "На угрозы {neighbour.род} {ruler} {ruler:ответил|ответила} коротко: послам дали час на сборы, и до границы их провожали копьями.",
                ],
            ),
        ],
    ),
    (
        id: "neighbour_trade",
        image: "trade",
        title: "Чужие купцы",
        text: "Купцы {neighbour.род} просят места на наших ярмарках. Везут сукно, соль и стекло и обещают платить пошлину звонкой монетой.",
        texts: [
            "К столице подходит чужой обоз в сорок телег: {neighbour} просит пустить своих торговцев на ярмарки. Свои купцы уже толпятся у дворца с челобитной.",
            "Посол {neighbour.род} привёз образцы товаров и грамоту о торговле. Он клянётся, что чужое серебро потечёт в казну, а свои купцы клянутся, что разорятся.",
        ],
        when: All([]),
        weight: 0,
        once: false,
        cooldown_years: 0,
        importance: 1,
        sign: Good,
        target: Neighbour,
        choices: [
            (
                text: "Открыть ярмарки чужим купцам",
                effects: [Axis("treasury", 25), Relation(EventTarget, 5), Axis("loyalty_people", 2)],
                cause_tag: "trade_opened",
                hint: "Чужие купцы везут серебро и вести.",
                told: "Купцы {neighbour.род} получили право торговать на ярмарках королевства, и в торговых рядах заговорили на чужом наречии.",
                retold: [
                    "На осенней ярмарке впервые встали лавки купцов {neighbour.род}, и казна в тот год насчитала пошлин больше обычного.",
                    "Ярмарки открыли для торговцев {neighbour.род}: чужое сукно подешевело, а вместе с ним в города пришли чужие вести.",
                ],
            ),
            (
                text: "Защитить своих купцов от чужих",
                effects: [Relation(EventTarget, -5), Axis("loyalty_nobles", 2)],
                cause_tag: "trade_refused",
                hint: "Свои купцы благодарны, сосед обижен.",
                told: "{neighbour} {neighbour:просил|просила} пустить своих купцов на ярмарки, но корона защитила своих торговцев.",
                retold: [
                    "Чужой обоз завернули у заставы, и столичные купцы в тот вечер пили за здоровье {ruler.род}.",
                    "Купцам {neighbour.род} отказали в ярмарочных местах, и обиженный посол уехал, пообещав, что этого не забудут.",
                ],
            ),
        ],
    ),
    (
        id: "neighbour_raid",
        image: "raid",
        title: "Набег: {province}",
        text: "Конные отряды {neighbour.род} перешли границу. В {province.пр} горят сёла, по дорогам гонят угнанный скот, и беженцы стучатся в ворота замков.",
        texts: [
            "Над {province.тв} поднимаются дымы: люди {neighbour.род} грабят мельницы и амбары. Старосты шлют гонцов, а гонцы загоняют коней.",
            "Набег пришёл перед жатвой. Всадники {neighbour.род} вытаптывают поля {province.род} и уводят в полон девок и мальчишек.",
        ],
        recalled: "набег соседей",
        when: All([]),
        weight: 0,
        once: false,
        cooldown_years: 0,
        importance: 3,
        target: RandomProvince((borders_foreign: true)),
        choices: [
            (
                text: "Выслать войско навстречу набегу",
                effects: [Axis("army", -5), Province(EventTarget, Loyalty, 5), Relation(EventTarget, -5)],
                cause_tag: "raid_repelled",
                hint: "Отбитый набег учит соседа осторожности.",
                told: "Отряды {neighbour.род} перешли границу и жгли сёла в {province.пр}, но королевское войско отбросило их за реку.",
                retold: [
                    "Грабителей {neighbour.род} настигли у брода в {province.пр} и порубили, а отбитый скот гнали назад всей округой.",
                    "Королевская конница поспела к {province.дат} на третий день и выгнала чужих всадников за рубеж; пленных вернули по сёлам.",
                ],
            ),
            (
                text: "Отсидеться за стенами замков",
                effects: [Province(EventTarget, Population, -500), Province(EventTarget, Income, -1), Province(EventTarget, Loyalty, -10), CrownPower(EventTarget, -5)],
                cause_tag: "raid_endured",
                hint: "Брошенная провинция помнит, кто её не защитил.",
                told: "Отряды {neighbour.род} жгли сёла в {province.пр} и уводили скот, а люди отсиживались за стенами.",
                retold: [
                    "В {province.пр} войска так и не дождались: замки заперли ворота, а сёла горели одно за другим.",
                    "Набег прокатился по {province.дат} и ушёл за границу с добычей; о помощи короны там потом вспоминали с усмешкой.",
                ],
            ),
        ],
    ),
    (
        // Leads into the war chain (events/war.ron) through StartWar.
        id: "neighbour_war_declared",
        image: "war-declared",
        title: "{neighbour} объявляет войну",
        text: "Глашатаи {neighbour.род} трубят у ворот столицы и бросают к трону латную перчатку. За рекой уже белеют вражьи шатры.",
        texts: [
            "Война пришла без спроса: {neighbour} {neighbour:разорвал|разорвала} договоры и {neighbour:объявил|объявила} войну. Порубежные крепости шлют гонцов, а купцы спешно увозят товар.",
            "В грамоте {neighbour.род} всего три строки, и последняя кончается словом «война». Бароны ждут, примет ли {ruler} вызов.",
        ],
        recalled: "война с соседом",
        when: Not(AtWar),
        weight: 0,
        once: false,
        cooldown_years: 0,
        importance: 5,
        target: Neighbour,
        choices: [
            (
                text: "Принять вызов соседа",
                effects: [StartWar(EventTarget), Axis("prestige", 2)],
                cause_tag: "war_accepted",
                hint: "Кто принял вызов, тот и отвечает за исход.",
                told: "{neighbour} {neighbour:объявил|объявила} войну, и {ruler} {ruler:принял|приняла} вызов.",
                retold: [
                    "Перчатку {neighbour.род} подняли с пола тронного зала, и в тот же день по замкам поскакали гонцы созывать войско.",
                    "На вызов {neighbour.род} {ruler} {ruler:ответил|ответила} одним словом, и глашатаи увезли это слово за рубеж.",
                    "На объявление войны в королевском совете никто не заговорил о мире: к вечеру уже ковали подковы и точили копья.",
                    "Вызов {neighbour.род} приняли, в соборе отслужили молебен о победе, а гонцы понесли по замкам приказ собирать рать.",
                ],
            ),
            (
                text: "Откупиться от войны серебром",
                effects: [Tribute(-60), Relation(EventTarget, 20), Axis("prestige", -5)],
                cause_tag: "war_bought_off",
                hint: "Откуп кормит того, кто грозит.",
                told: "{neighbour} {neighbour:бросил|бросила} к трону перчатку, но {ruler} {ruler:откупился|откупилась} от войны.",
                retold: [
                    "Войну с {neighbour.тв} купили, не начав: обоз с серебром ушёл за реку, и вражьи шатры свернули.",
                    "От войны откупились, и {neighbour} {neighbour:увёл|увела} войско от границы, пересчитывая королевское серебро.",
                    "Войну с {neighbour.тв} погасили до первой крови: послам вручили серебро, и обиду, которой, быть может, и не было, забыли.",
                    "За мир заплатили вперёд: {neighbour.дат} отправили серебряную посуду и меха, и война так и осталась на пергаменте.",
                ],
            ),
        ],
    ),
]
