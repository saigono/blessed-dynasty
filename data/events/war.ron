// The war chain. StartWar (action declare_war, event neighbour_war_declared) queues
// war_declared at the enemy; every step spawns the next and passes the enemy on as its target.
// Each step waits for its stage (rules.ron `war`): war_declared at Declared, war_clash at
// Fighting, then war_siege (winning) or war_talks (not winning) at Fighting, then exactly one
// of war_victory, war_defeat, war_draw at Peace by war_score. The sibling that does not fit
// is dropped. Nominally four years from the declaration. The outcome comes a year after the
// siege or the talks with no battle in between: its text tells the battles won and lost
// ({war_won}, {war_lost}), why the war ends. The war actions of actions.ron
// (battle, talks, siege) can cut it short: talks spawn the outcome by the score at once.
// Victory takes the province the war is fought for (War.target, ProvinceTarget WarTarget).
// war_siege_won is the card of the siege action (actions.ron war_siege_target): the province
// is taken already, its one choice signs the peace. A war breaks the enemy's treaty of
// nb_embassy: war_declared clears its mark "treaty".
[
    (
        id: "war_declared",
        title: "Война: {neighbour}",
        text: "Война с {neighbour.тв} объявлена, и по замкам скачут гонцы. Войско нужно собрать прежде, чем враг перейдёт границу, а в казне гуляет эхо.",
        texts: [
            "На главной площади зачитали указ о войне с {neighbour.тв}. Кузнецы не спят ночами, а воеводы спорят, кем воевать: наёмниками, баронскими дружинами или тем, что есть под рукой.",
            "Войне с {neighbour.тв} нужны люди. В порту ждут наёмные роты, в замках точат мечи бароны, а у ворот столицы стоит малая королевская дружина, готовая выступить хоть завтра.",
        ],
        texts_when: [
            (AxisBelow("treasury", 40), "Война с {neighbour.тв} началась в недобрый час: казна почти пуста, и наёмники в порту требуют платы вперёд. Бароны готовы привести дружины, но не задаром."),
        ],
        when: WarStage(Declared),
        weight: 0,
        once: false,
        cooldown_years: 0,
        importance: 4,
        target: Neighbour,
        choices: [
            (
                text: "Нанять наёмников за серебро",
                effects: [Axis("treasury", -60), Axis("army", 25), SetWarStage(Fighting), SpawnEvent("war_clash", 1), Unmark("treaty")],
                cause_tag: "war_mercenaries",
                hint: "Наёмник верен, пока ему платят.",
                told: "Для войны с {neighbour.тв} корона набрала наёмников на казённое серебро.",
                retold: [
                    "В столицу вошли наёмные роты под чужими знамёнами, и казначей отсчитал им жалованье за три месяца вперёд.",
                    "Против {neighbour.род} выставили наёмников, пикинёров с юга и арбалетчиков с островов, и каждый из них знал цену своему ремеслу.",
                ],
            ),
            (
                text: "Созвать вассалов с дружинами",
                effects: [Axis("loyalty_nobles", -5), Axis("army", 15), SetWarStage(Fighting), SpawnEvent("war_clash", 1), Unmark("treaty")],
                cause_tag: "war_levy",
                hint: "Бароны, пролившие кровь за корону, потребуют награды.",
                told: "На войну с {neighbour.тв} {ruler} {ruler:созвал|созвала} вассалов с их дружинами.",
                retold: [
                    "По зову {ruler.род} бароны привели свои дружины, и под королевским стягом встали два десятка чужих гербов.",
                    "Вассалы съехались к сборному месту с конными и пешими, и каждый уже прикидывал, какую награду попросит за эту войну.",
                ],
            ),
            (
                text: "Выступить малым войском",
                effects: [Axis("prestige", -2), SetWarStage(Fighting), SpawnEvent("war_clash", 1), Unmark("treaty")],
                cause_tag: "war_small_army",
                hint: "Малое войско быстро выступает и быстро тает.",
                told: "{ruler} {ruler:выступил|выступила} против {neighbour.род} с малым войском, не дожидаясь подкреплений.",
                retold: [
                    "Не дожидаясь баронских дружин, королевская дружина ушла к границе налегке, с одним обозом и двумя трубачами.",
                    "Против {neighbour.род} выступили с тем, что было под рукой: старая гвардия да городское ополчение.",
                ],
            ),
        ],
    ),
    (
        id: "war_clash",
        title: "Битва на рубеже",
        text: "Войска сошлись у границы. {neighbour} строит полки на холме за ручьём, ветер треплет знамёна, и воеводы ждут приказа.",
        texts: [
            "Утро туманное, и вражеский лагерь виден только по кострам. Разведчики говорят, что у {neighbour.род} больше конницы, а у нас лучше лучники.",
            "Две рати третий день стоят друг против друга. Солдаты перекрикиваются через поле, а в шатре воеводы спорят до хрипоты.",
        ],
        when: WarStage(Fighting),
        weight: 0,
        once: false,
        cooldown_years: 0,
        importance: 4,
        target: Neighbour,
        choices: [
            (
                text: "Наступать всеми силами",
                effects: [Clash, Clash, Axis("army", -10), SpawnEvent("war_siege", 1), SpawnEvent("war_talks", 1)],
                cause_tag: "war_attack",
                hint: "Смелый удар решает войну быстрее, но кровью.",
                told: "Войска сошлись на рубеже, и {ruler} {ruler:повёл|повела} полки в наступление на {neighbour.вин}.",
                retold: [
                    "Королевские полки пошли в атаку на рассвете, через ручей и вверх по склону, прямо на копья {neighbour.род}.",
                    "На рубеже дали бой: конница ударила в лоб, пехота пошла следом, и к полудню поле было усеяно телами.",
                ],
            ),
            (
                text: "Держать позиции и ждать",
                effects: [Clash, Axis("army", -5), SpawnEvent("war_siege", 1), SpawnEvent("war_talks", 1)],
                cause_tag: "war_hold",
                hint: "Кто стоит на месте, тот не проигрывает, но и не выигрывает.",
                told: "Войска короны и {neighbour.род} сошлись на рубеже, и королевские полки устояли на своих позициях.",
                retold: [
                    "Королевское войско окопалось на рубеже и отбивало атаки {neighbour.род} до самой темноты.",
                    "На рубеже стояли насмерть: частокол, рвы и стена щитов, о которую разбивалась чужая конница.",
                ],
            ),
            (
                text: "Отступить, сберегая войско",
                effects: [Axis("prestige", -5), Axis("loyalty_nobles", -3), SpawnEvent("war_siege", 1), SpawnEvent("war_talks", 1)],
                cause_tag: "war_retreat",
                hint: "Отступление сберегает войско, но не славу.",
                told: "Войска сошлись на рубеже, но королевское войско отступило перед {neighbour.тв} без боя, и знать этого не простила.",
                retold: [
                    "Ночью королевский лагерь снялся и ушёл, оставив костры гореть, и утром {neighbour} {neighbour:нашёл|нашла} перед собой пустое поле.",
                    "Без боя отошли за реку, сберегая полки, и рыцари ворчали, что так воюют купцы, а не короли.",
                ],
            ),
        ],
    ),
    (
        id: "war_siege",
        title: "Осада крепости",
        text: "Королевское войско стоит под стенами вражеской крепости. {neighbour} шлёт ей подмогу лесными тропами, в лагере кончается фураж, и осада затягивается.",
        texts: [
            "Крепость {neighbour.род} сидит на скале, и тараны до неё не достают. Минёры роют подкоп, лестницы готовы, и войско ждёт решения.",
            "Под стенами вражеской крепости третью неделю горят костры. Со стен летят стрелы и насмешки, а гарнизон, говорят, уже ест лошадей.",
        ],
        when: All([WarStage(Fighting), WarScoreAbove(0)]),
        weight: 0,
        once: false,
        cooldown_years: 0,
        importance: 4,
        target: Neighbour,
        choices: [
            (
                text: "Идти на штурм стен",
                effects: [Clash, Clash, Axis("army", -10), SetWarStage(Peace), SpawnEvent("war_victory", 1), SpawnEvent("war_defeat", 1), SpawnEvent("war_draw", 1)],
                cause_tag: "war_storm",
                hint: "Штурм берёт стены, но кладёт под ними лучших.",
                told: "Королевское войско пошло на штурм вражеской крепости, к которой {neighbour} {neighbour:слал|слала} подмогу.",
                retold: [
                    "На рассвете к стенам приставили лестницы, и штурмующие полезли наверх под кипятком и камнями.",
                    "Крепость {neighbour.род} брали приступом: ворота выбили тараном, и бой шёл во дворах до самой цитадели.",
                ],
            ),
            (
                text: "Вести правильную осаду",
                effects: [Clash, Axis("treasury", -30), SetWarStage(Peace), SpawnEvent("war_victory", 1), SpawnEvent("war_defeat", 1), SpawnEvent("war_draw", 1)],
                cause_tag: "war_siege",
                hint: "Правильная осада берёт крепость серебром, а не кровью.",
                told: "Королевское войско обложило вражескую крепость и повело правильную осаду.",
                retold: [
                    "Вокруг крепости {neighbour.род} вырыли ров и насыпали вал, и минёры днём и ночью вели подкоп под угловую башню.",
                    "Крепость обложили со всех сторон и стали ждать: подвоз отрезали, колодцы засыпали, а казна платила осадным мастерам.",
                ],
            ),
            (
                text: "Снять осаду и начать переговоры",
                effects: [SetWarStage(Peace), SpawnEvent("war_victory", 1), SpawnEvent("war_defeat", 1), SpawnEvent("war_draw", 1)],
                cause_tag: "war_siege_lifted",
                hint: "Победу, оставленную недобитой, враг не признаёт.",
                told: "Осаду вражеской крепости сняли, и к {neighbour.дат} отправились переговорщики.",
                retold: [
                    "Войско отошло от стен, так и не взяв их, и в стан {neighbour.род} поехали послы с белым жезлом.",
                    "Осадные лагеря свернули, и вместо мин и таранов в дело пошли грамоты и печати.",
                ],
            ),
        ],
    ),
    (
        id: "war_talks",
        title: "Переговоры о мире",
        text: "{neighbour} теснит королевское войско: обозы брошены, раненых везут на телегах, и в полках недосчитываются каждого пятого. Воеводы советуют искать мира, пока не поздно.",
        texts: [
            "Королевские полки отходят от рубежа, и враг идёт по пятам. Старый воевода, сняв шлем, говорит, что ещё один бой войско либо выиграет, либо его не станет.",
            "Вести с войны всё хуже: враг занял броды и жжёт порубежные сёла. В лагере о мире говорят громче, чем о победе.",
        ],
        when: All([WarStage(Fighting), Not(WarScoreAbove(0))]),
        weight: 0,
        once: false,
        cooldown_years: 0,
        importance: 4,
        target: Neighbour,
        choices: [
            (
                text: "Дать решающий бой",
                effects: [Clash, Axis("army", -5), SetWarStage(Peace), SpawnEvent("war_victory", 1), SpawnEvent("war_defeat", 1), SpawnEvent("war_draw", 1)],
                cause_tag: "war_last_stand",
                hint: "Последний бой либо спасает войну, либо проигрывает её до конца.",
                told: "{neighbour} {neighbour:теснил|теснила} королевское войско, и {ruler} {ruler:решился|решилась} на последний бой.",
                retold: [
                    "Отступать было некуда, и королевские полки развернулись лицом к врагу, поставив на один бой всю войну.",
                    "Войско собрали в кулак для последнего удара, и в ночь перед боем в лагере не пели песен.",
                ],
            ),
            (
                text: "Просить мира первыми",
                effects: [Axis("prestige", -5), SetWarStage(Peace), SpawnEvent("war_victory", 1), SpawnEvent("war_defeat", 1), SpawnEvent("war_draw", 1)],
                cause_tag: "war_sue_for_peace",
                hint: "Мир, выпрошенный первым, стоит дороже.",
                told: "Войско {neighbour.род} теснило королевские полки, и корона первой запросила мира.",
                retold: [
                    "К {neighbour.дат} отправили послов с просьбой о мире, и все понимали, что платить за этот мир придётся короне.",
                    "Корона запросила мира, пока ещё было чем торговаться, и в лагере {neighbour.род} в тот вечер пили за победу.",
                ],
            ),
        ],
    ),
    (
        id: "war_victory",
        title: "Победа",
        text: "{neighbour}, проиграв короне {war_won}, больше не ищет битв и просит мира. Послы ждут у шатра и готовы торговаться о цене.",
        texts: [
            "Война выиграна: за {war_won} враг потерял лучших воинов и всякую надежду. Послы {neighbour.род} стоят у шатра, ожидая условий.",
            "Победа! После того как королевские полки выиграли {war_won}, {neighbour} просит мира и спрашивает лишь, сколько это будет стоить.",
        ],
        when: All([WarStage(Peace), WarScoreAbove(15)]),
        weight: 0,
        once: false,
        cooldown_years: 0,
        importance: 5,
        sign: Good,
        target: Neighbour,
        choices: [
            (
                text: "Взять спорную землю и контрибуцию",
                effects: [TransferProvince(WarTarget, Crown), Tribute(60), Axis("prestige", 15), Axis("legitimacy", 5), Relation(EventTarget, -20), EndWar(Victory)],
                cause_tag: "war_won_land",
                hint: "Взятая земля долго помнит, чьей была.",
                told: "{neighbour}, проиграв {war_won}, {neighbour:запросил|запросила} мира, и корона взяла спорную землю и контрибуцию.",
                retold: [
                    "Выиграв {war_won}, корона продиктовала мир: спорная земля отошла под королевский стяг, а обоз с контрибуцией тянулся до столицы два дня.",
                    "{neighbour} {neighbour:уступил|уступила} спорную землю и {neighbour:заплатил|заплатила} контрибуцию: так кончилась война, в которой корона выиграла {war_won}.",
                ],
            ),
            (
                text: "Взять только контрибуцию серебром",
                effects: [Tribute(120), Axis("prestige", 8), Axis("legitimacy", 3), EndWar(Victory)],
                cause_tag: "war_won_gold",
                hint: "Серебро уходит, а обида побеждённого остаётся.",
                told: "{neighbour}, проиграв {war_won}, {neighbour:запросил|запросила} мира, и победители удовольствовались богатой контрибуцией.",
                retold: [
                    "Выиграв {war_won}, корона не стала брать земли и взяла серебром: возы с контрибуцией шли через границу всю осень.",
                    "Мир с {neighbour.тв} купили победой: враг, проигравший {war_won}, заплатил полной мерой, а границы остались прежними.",
                ],
            ),
        ],
    ),
    (
        id: "war_defeat",
        title: "Поражение",
        text: "Корона проиграла {war_lost}, и королевское войско разбито. Послы {neighbour.род} диктуют условия в нашем же шатре, и спорить с ними некем.",
        texts: [
            "Проиграв {war_lost}, войско откатилось к столице. {neighbour} требует земли или заложника, а в казне не хватит серебра даже на выкуп пленных.",
            "Враг стоит у порога. За эту войну корона проиграла {war_lost}, и {neighbour} знает цену своей победе.",
        ],
        recalled: "проигранная война",
        when: All([WarStage(Peace), WarScoreBelow(-15)]),
        weight: 0,
        once: false,
        cooldown_years: 0,
        importance: 5,
        target: Neighbour,
        choices: [
            (
                text: "Уступить пограничную провинцию",
                effects: [TransferProvince(OwnBorder, Foreign(EventTarget)), Tribute(-50), RulerHealth(-10), Axis("legitimacy", -10), Axis("prestige", -10), Axis("loyalty_nobles", -10), EndWar(Defeat)],
                cause_tag: "war_lost_land",
                hint: "Отданная земля станет причиной новой войны.",
                told: "Корона проиграла {war_lost}, и {neighbour} {neighbour:забрал|забрала} пограничную землю.",
                retold: [
                    "Проиграв {war_lost}, корона подписала мир, и над одной из пограничных крепостей спустили королевский стяг.",
                    "Мир купили землёй: проиграв {war_lost}, корона уступила {neighbour.дат} порубежный край вместе с сёлами и мельницами.",
                ],
            ),
            (
                text: "Отдать наследника в заложники",
                effects: [TakeHostage(0, EventTarget), Tribute(-100), RulerHealth(-10), Axis("legitimacy", -8), Axis("prestige", -10), Axis("loyalty_nobles", -10), EndWar(Defeat)],
                cause_tag: "war_lost_hostage",
                hint: "Наследник, выросший у врага, вернётся чужим.",
                told: "Корона проиграла {war_lost}, и наследника престола отдали {neighbour.дат} в заложники.",
                retold: [
                    "Проиграв {war_lost}, корона заплатила самым дорогим: наследника увезли ко двору {neighbour.род} заложником мира.",
                    "Мир скрепили живой печатью: после того как войско проиграло {war_lost}, наследник престола уехал в заложники за рубеж.",
                ],
            ),
        ],
    ),
    (
        id: "war_draw",
        title: "Мир без победы",
        text: "Война вышла вничью: {war_won} в пользу короны, {war_lost} в пользу врага. Обе стороны устали, и {neighbour} {neighbour:готов|готова} мириться на прежних границах.",
        texts: [
            "Ни одна сторона не взяла верх: в счёт короны {war_won}, в счёт {neighbour.род} {war_lost}. Послы съезжаются на мельнице у брода, чтобы мириться.",
            "Поля вытоптаны, сёла сожжены, а граница стоит там же, где стояла. Счёт войны вышел такой: {war_won} в пользу короны и {war_lost} в пользу врага, и {neighbour} предлагает мир.",
        ],
        when: All([WarStage(Peace), Not(WarScoreAbove(15)), Not(WarScoreBelow(-15))]),
        weight: 0,
        once: false,
        cooldown_years: 0,
        importance: 4,
        target: Neighbour,
        choices: [
            (
