(
    // 1 = year, 4 = seasons, 12 = months. Durations in data are always in years.
    time_unit: (ticks_per_year: 1),

    // State axes: the world starts with `default`, a preset may override it. `name` is shown
    // in the UI; a change of at least `notable` in a year goes to the year's summary (0: never).
    axes: [
        // The treasury has a line of its own in the year's summary (UI): notable 0.
        (id: "treasury", min: -1000, max: 10000, default: 100, name: "Казна"),
        (id: "income", min: -100, max: 1000, default: 5, name: "Доход", notable: 2),
        (id: "army", min: 0, max: 1000, default: 50, name: "Армия", notable: 10),
        (id: "legitimacy", min: 0, max: 100, default: 50, name: "Легитимность", notable: 5),
        // Derived (`stability` below): the default is its anchor.
        (id: "stability", min: 0, max: 100, default: 50, name: "Стабильность", notable: 5),
        (id: "bureaucracy", min: 0, max: 100, default: 20, name: "Бюрократия", notable: 5),
        (id: "loyalty_nobles", min: 0, max: 100, default: 50, name: "Знать", notable: 5),
        (id: "loyalty_church", min: 0, max: 100, default: 50, name: "Церковь", notable: 5),
        (id: "loyalty_people", min: 0, max: 100, default: 50, name: "Народ", notable: 5),
        (id: "prestige", min: 0, max: 1000, default: 0, name: "Престиж", notable: 5),
        // Derived from the faction axes, never written directly; the default is ignored.
        (id: "loyalty", min: 0, max: 100, default: 50, name: "Лояльность"),
        // What events do to stability: fades by `step` a year toward 0.
        (id: "shocks", min: -100, max: 100, default: 0, name: "Потрясения", hidden: true, step: 3),
        // Hidden nodes of the influence graph (docs/design/hidden-state.html, section 2): no
        // number for the player; `reveal`: the bureaucracy that shows one in words; `step`:
        // a year toward the target.
        (id: "serfdom", min: 0, max: 100, default: 30, name: "Закрепощение", hidden: true, step: 0.4, reveal: 40),
        (id: "strata", min: 0, max: 100, default: 40, name: "Расслоение", hidden: true, step: 0.4, reveal: 70),
        (id: "mobility", min: 0, max: 100, default: 40, name: "Подвижность сословий", hidden: true, step: 0.5, reveal: 70),
        (id: "liberties", min: 0, max: 100, default: 15, name: "Городские вольности", hidden: true, step: 0.6, reveal: 40),
        (id: "trade", min: 0, max: 100, default: 30, name: "Торговля", hidden: true, step: 1.5, reveal: 20),
        (id: "grain", min: 0, max: 100, default: 50, name: "Хлебные запасы", hidden: true, step: 5, reveal: 20),
        (id: "literacy", min: 0, max: 100, default: 10, name: "Грамотность", hidden: true, step: 0.25, reveal: 55),
        (id: "faith", min: 0, max: 100, default: 65, name: "Единоверие", hidden: true, step: 0.5, reveal: 55),
    ],

    // Stability is derived: its anchor (the axis default) plus the Target edges into it plus
    // `shocks`, clamped. Axis("stability", x) in effects and rules goes to `shocks`; a
    // preset's stability is where it starts, the gap a shock.
    stability: (axis: "stability", shocks: "shocks"),

    // What the crown knows of the hidden nodes (section 7): a node opens in words at the
    // `axis` of its `reveal`, every node in numbers with the forecast of 60 years at `numbers`.
    reveal: (axis: "bureaucracy", numbers: 85),

    // Each faction's loyalty is its axis. `loyalty_axis` = weighted mean, rounded toward zero.
    factions: [
        (id: "nobles", axis: "loyalty_nobles", weight: 2),
        (id: "church", axis: "loyalty_church", weight: 1),
        (id: "people", axis: "loyalty_people", weight: 1),
    ],
    loyalty_axis: "loyalty",

    // Crown power of own provinces (foreign ones and those cut off from the capital get 0),
    // recomputed from scratch, never below 0:
    // base[holder] - (threshold - loyalty) * loyalty_penalty (only below threshold)
    // - path_cost * distance_penalty + buildings + capital.crown_bonus.
    // path_cost: cheapest path from the capital; a step into an own province costs 1, into
    // a neighbour's max(1, 1 + foreign_step_penalty - relation * foreign_step_relation).
    crown_power: (
        base: (crown: 60, vassal: 30),
        loyalty_threshold: 50,
        loyalty_penalty: 0.5,
        distance_penalty: 5,
        foreign_step_penalty: 1,
        foreign_step_relation: 0.02,
        buildings: {"fort": 10, "road": 5, "market": 2},
    ),

    // How many actions may run at once: the largest `slots` whose threshold the axis reached.
    // The actions of a war going on (target Enemy) have `war_slots` of their own.
    action_slots: (axis: "bureaucracy", steps: [(0, 1), (40, 2), (70, 3)], war_slots: 1),

    // Per year: treasury += income of crown provinces + the Flow edges into it (influences).
    // The army's upkeep and the war's toll are in `war`.
    economy: (
        treasury: "treasury",
    ),

    // The influence graph, counted in this order once a year after the passive changes:
    // lagged sources, then targets and steps, then flows. An edge adds k * (source - rest),
    // or by its `curve` of (source, contribution) points; `delay`: years the source is
    // smoothed over. Target: to the target of `to` (its anchor plus the edges; the axis steps
    // toward it by its `step` a year). Flow: to the stock `to` every year.
    influences: [
        (id: "income", from: "income", to: "treasury", k: 1, kind: Flow),
        // Stability: 50 + 0.6 * (loyalty - 50) + 0.4 * (legitimacy - 50) - heresy + shocks.
        (id: "st_loyalty", from: "loyalty", to: "stability", k: 0.6, rest: 50),
        (id: "st_legitimacy", from: "legitimacy", to: "stability", k: 0.4, rest: 50),
        // Heresy: 0 at faith 60 and above, 5 at 45, 12 at 30, 20 at 15.
        // `rest`: where the curve leaves 0, the way a chain reads faith (stage 20).
        (id: "st_heresy", from: "faith", to: "stability", rest: 60, curve: [(15, -20), (30, -12), (45, -5), (60, 0)]),
        // The graph of section 3. At the start every source stands at its rest: the graph is
        // silent and the targets are the defaults.
        (id: "e1", from: "serfdom", to: "strata", k: 0.5, rest: 30, delay: 10),
        // Flat above 85.
        (id: "e2", from: "strata", to: "mobility", rest: 40, delay: 5, curve: [(0, 30), (40, 0), (85, -33.75)]),
        (id: "e3", from: "mobility", to: "strata", k: -0.6, rest: 40, delay: 10),
        // 0.8 above nobles 50, nothing below.
        (id: "e4", from: "loyalty_nobles", to: "serfdom", rest: 50, delay: 5, curve: [(50, 0), (100, 40)]),
        (id: "e5", from: "serfdom", to: "loyalty_nobles", k: 0.4, rest: 30),
        // -0.6 up to 60, -1.0 above, flat above 85.
        (id: "e6", from: "strata", to: "loyalty_people", rest: 40, curve: [(0, 24), (40, 0), (60, -12), (85, -37)]),
        // Only under the law «Городские вольности» (`off`: counts while a law names it).
        (id: "e7", from: "strata", to: "liberties", k: 0.4, rest: 50, delay: 10, off: true),
        (id: "e8", from: "liberties", to: "mobility", k: 0.5, rest: 15, delay: 10),
        (id: "e9", from: "liberties", to: "trade", k: 0.6, rest: 15, delay: 5),
        (id: "e10", from: "trade", to: "grain", k: 0.4, rest: 30),
        (id: "e11", from: "grain", to: "trade", k: -0.3, rest: 50),
        // 0.5, twice as steep below 30: famine hurts more than plenty pleases.
        (id: "e12", from: "grain", to: "loyalty_people", rest: 50, curve: [(0, -40), (30, -10), (50, 0), (100, 25)]),
        (id: "e13", from: "trade", to: "treasury", k: 0.1, rest: 30, kind: Flow),
        (id: "e14", from: "literacy", to: "faith", k: -0.8, rest: 10, delay: 15),
        // -1.5 within faith 35..60, flat outside.
        (id: "e15", from: "faith", to: "literacy", rest: 60, delay: 5, curve: [(35, 37.5), (60, 0)]),
        (id: "e16", from: "faith", to: "loyalty_church", k: 0.4, rest: 65),
        (id: "e17", from: "literacy", to: "mobility", k: 0.4, rest: 10, delay: 15),
        (id: "e18", from: "literacy", to: "bureaucracy", k: 0.02, rest: 10, kind: Flow),
    ],

    // Loops of the graph (section 4), by their edges in order: `data_lint` checks the gain
    // of each outside its curves.
    loops: [
        ("П1 Гнёт", ["e2", "e3"]),
        ("П2 Барщина", ["e4", "e5"]),
        ("П3 Ересь книжников", ["e14", "e15"]),
        ("С1 Хлеб и цена", ["e11", "e10"]),
        ("С2 Вольный город", ["e7", "e8", "e3"]),
    ],

    // The catastrophes of the loops and the symptoms of each (events marked `omen`) that
    // come before it (stage 20, criterion 3): П1 and П2 end in the peasant war, П3 in the
    // schism, a broken С1 in the great famine.
    symptoms: [
        ("peasant_war", ["prov_rebel_elder", "omen_runaways", "omen_empty_villages", "omen_search_decree"]),
        ("schism", ["fac_heresy", "fac_heresy_spreads"]),
        ("great_famine", ["omen_dear_bread"]),
    ],

    // Laws-institutions (docs/design/hidden-state.html, section 5). A law is in force while
    // its flag `id` is set and outlives the ruler; one law of a `group` at a time. `cost` and
    // `years` to bring it in, `requires` to start; `resistance`: anchor shifts while it is
    // brought in (a faction against it); in force, `anchors`: anchor shifts, `edges`:
    // multipliers of edges of `influences`, `treasury`: added to the yearly income; done,
    // `on_complete` once; `keep`: no repeal, only another law of its group replaces it. The
    // succession laws are those of `heirs.laws` by their flag, named and described there.
    // Every law gets the actions to enact it and to repeal it (`enact`, `repeal`: their
    // names), both for `min_crown_power` of the capital; a repeal costs `repeal_share` of the
    // price, the simulation's automaton pays it all.
    laws: (
        enact: "Ввести закон «{law}»",
        repeal: "Отменить закон «{law}»",
        repeal_share: 0.5,
        min_crown_power: 40,
        // A faction above 70 presses the automaton for the laws that raise its anchor and
        // against those that lower it or that it resists, one below 30 only against (the
        // weight `pressure` of sim.auto, per point); only so pressed does it repeal a law, at
        // the full price.
        pressure: (30, 70),
        list: [
            (id: "law_primogeniture", group: "Наследование", keep: true, cost: 60, years: 3,
                requires: NotFlag("succession_contested"),
                resistance: [("loyalty_nobles", -10)],
                on_complete: [Axis("loyalty_church", 3), Axis("loyalty_nobles", -3)]),
            (id: "law_male", group: "Наследование", keep: true, cost: 45, years: 2,
                requires: NotFlag("succession_contested"),
                resistance: [("loyalty_nobles", -5)],
                on_complete: [Axis("loyalty_church", 2)]),
            (id: "law_salic", group: "Наследование", keep: true, cost: 45, years: 2,
                requires: NotFlag("succession_contested"),
                resistance: [("loyalty_church", -10)],
                on_complete: [Axis("loyalty_nobles", 3), Axis("loyalty_church", -2)]),
            // A grown man on the throne pleases the barons.
            (id: "law_seniority", group: "Наследование", keep: true, cost: 60, years: 3,
                requires: NotFlag("succession_contested"),
                resistance: [("loyalty_church", -10)],
                anchors: [("loyalty_nobles", 3)],
                on_complete: [Axis("loyalty_nobles", 3), Axis("stability", -3)]),
            // The council of barons pulls toward the corvée.
            (id: "law_elective", group: "Наследование", keep: true, cost: 60, years: 3,
                requires: NotFlag("succession_contested"),
                resistance: [("loyalty_church", -10)],
                anchors: [("loyalty_nobles", 5)], edges: [("e4", 1.2)],
                on_complete: [Axis("loyalty_nobles", 5), Axis("legitimacy", -3)]),
            // More lords, more corvée: with serfdom the gain of П2 nears 0.8.
            (id: "law_partition", group: "Наследование", keep: true, cost: 45, years: 2,
                requires: NotFlag("succession_contested"),
                resistance: [("loyalty_church", -10)],
                anchors: [("loyalty_nobles", 8)], edges: [("e4", 1.25), ("e1", 1.2)],
                on_complete: [Axis("loyalty_nobles", 5), Axis("stability", -3)]),
            // The ten laws of section 5. Peasants: serfdom or free peasants (custom: neither).
            (id: "law_serfdom", group: "Крестьяне", cost: 60, years: 3,
                name: "Крепостное право",
                description: "Крестьян прикрепляют к земле господина. Сразу знать довольна, барщина даёт казне 3 в год, ополчение пополняет армию. Закон держит крестьян в крепости, а знать — у барщины: довольные бароны требуют новых повинностей, гнёт растёт и запирает простолюдина в его сословии. Через два-три поколения народ ожесточается, начинаются мужицкие войны.",
                resistance: [("loyalty_people", -10)],
                anchors: [("serfdom", 30), ("loyalty_nobles", 8)], edges: [("e4", 1.5)],
                treasury: 3, on_complete: [Axis("army", 10)]),
            (id: "law_free_peasants", group: "Крестьяне", cost: 90, years: 4,
                name: "Вольные крестьяне",
                description: "Барщину отменяют, крестьянин волен уйти с земли. Знать теряет даровой труд и ропщет, вассалы смелеют. Закон держит крепость низкой и глушит союз знати и барщины; сословия расслаиваются меньше, люди выбиваются в цеха и писцы, торговля оживает.",
                resistance: [("loyalty_nobles", -10)],
                anchors: [("serfdom", -20), ("loyalty_nobles", -8), ("trade", 5)], edges: [("e4", 0)]),
            // Faith: one faith or tolerance (custom: neither).
            (id: "law_one_faith", group: "Вера", cost: 45, years: 2,
                name: "Единоверие",
                description: "Одна вера на всё королевство, инакомыслие под запретом. Церковь довольна, ересь отступает. Закон держит единство веры и отодвигает раскол, но если ересь всё же пустит корни, она бьёт по стабильности в полтора раза сильнее.",
                resistance: [("loyalty_people", -5)],
                anchors: [("faith", 10), ("loyalty_church", 5)], edges: [("st_heresy", 1.5)]),
            (id: "law_tolerance", group: "Вера", cost: 45, years: 2,
                name: "Терпимость",
                description: "Иноверцев и сектантов не преследуют. Церковь недовольна и долго помнит обиду, зато купцы едут охотнее. Ересь растёт, но почти не колеблет стабильность: раскола не будет.",
                resistance: [("loyalty_church", -10)],
                anchors: [("loyalty_church", -10), ("trade", 5)], edges: [("st_heresy", 0.3)]),
            (id: "law_tithe", cost: 30, years: 1,
                name: "Десятина",
                description: "Десятая доля урожая идёт церкви. Церковь довольна, вера крепче, казна теряет 2 в год. Закон держит церковь сытой, но медленно подпитывает гнёт: тяглецу платить и господину, и клиру.",
                resistance: [("loyalty_people", -10)],
                anchors: [("loyalty_church", 10), ("faith", 5), ("strata", 5)], treasury: -2),
            (id: "law_schools", cost: 60, years: 3,
                name: "Монастырские школы",
                description: "При монастырях учат грамоте детей всех сословий. Дорого, 6 в год, и при правлении основателя отдачи не видно. Через поколения грамотных становится много: они идут в писцы и укрепляют канцелярию, сословные стены тоньше, а книжность под присмотром монахов не рождает ереси.",
                anchors: [("literacy", 20)], edges: [("e14", 0.3)], treasury: -6),
            (id: "law_charters", cost: 60, years: 2,
                name: "Городские вольности",
                description: "Города получают хартии, свой суд и цеха. Торговля и казна растут за десять-двадцать лет. Вольный город принимает беглых и гасит гнёт деревни, но городская грамотность без школ через пару веков готовит ересь книжников. Знать теряет власть над городами.",
                resistance: [("loyalty_nobles", -10)],
                anchors: [("liberties", 35), ("literacy", 15), ("loyalty_nobles", -5)], edges: [("e7", 1)]),
            (id: "law_code", cost: 120, years: 4, requires: AxisAbove("bureaucracy", 39.999),
                name: "Свод законов",
                description: "Единый королевский суд вместо вотчинного. Нужна бюрократия от 40. Дорого и долго, знать ворчит: она теряет суд над своими людьми. Закон держит гнёт в узде: расслоение не душит подвижность и меньше бьёт по народу. Легитимность растёт сразу.",
                resistance: [("loyalty_nobles", -10)],
                anchors: [("loyalty_nobles", -3)], edges: [("e2", 0.7), ("e6", 0.7)],
                on_complete: [Axis("legitimacy", 5)]),
            (id: "law_granaries", cost: 90, years: 3,
                name: "Королевские житницы",
                description: "Корона держит запас хлеба на чёрный день, 4 в год. При хорошем урожае незаметно. Закон держит амбары полными: великий голод редок, народ сыт и спокоен. Купцам дорогого хлеба не видать, торговля ниже.",
                resistance: [("trade", -5)],
                anchors: [("grain", 15), ("trade", -5)], treasury: -4),
            (id: "law_fairs", cost: 45, years: 2,
                name: "Ярмарочное право",
                description: "Ярмарки свободны от мыта баронов. Торговля растёт, казна получает 2-3 в год. Купцы богатеют, города крепнут, но богатство копится у немногих: расслоение растёт и слабо подогревает гнёт. Знать теряет мыто.",
                resistance: [("loyalty_nobles", -10)],
                anchors: [("trade", 15), ("liberties", 5), ("strata", 5)]),
        ],
    ),

    // Per year: faction axes move by `step` toward their default, province loyalty toward
    // `province_loyalty`, crown power modifiers from effects toward 0.
    drift: (step: 1, province_loyalty: 50),

    // Weight of a quiet tick in the random event pick, next to the weights of the events.
    quiet_weight: 20,

    // Province loyalty below this shows as unrest on the map. Display only; below the
    // start loyalty of every own province (40 and up), between the sim triggers (30, 40).
    unrest_below: 35,

    // A newborn from HeirOp(Add).
    new_heir: (name: "Младенец", age: 0, ability: 50, claim: 50, status: Home),

    // Neighbour AI, once a year per neighbour. First its strength moves by `recover` toward
    // its start strength in the preset: losses to wars and tribute heal. Stance: relation
    // below `hostile_below` is Expand when strength >= the weakest crown power on the common
    // border + expand_margin, otherwise (or with no common border) Defend; above
    // `friendly_above` Trade; else Wait. Then relation moves by the stance's `relation` and
    // `drift` toward 0 (old grudges and friendships fade unless kept up), and one roll in
    // 0..100 picks at most one of its `events` (id, chance in percent per year; chances sum
    // to <= 100).
    // Events targeting a province hit the weakest border province and name the neighbour
    // as its second target; others target the neighbour.
    neighbour_ai: (
        hostile_below: -20,
        friendly_above: 30,
        expand_margin: 0,
        drift: 1,
        recover: 1,
        // `invasion` is a simulation event (events/sim/): the reign drops it as unknown.
        expand: (relation: -2, events: [
            ("neighbour_raid", 25), ("neighbour_ultimatum", 10), ("neighbour_war_declared", 5),
            ("invasion", 10),
        ]),
        defend: (relation: -1, events: [("neighbour_ultimatum", 10)]),
        trade: (relation: 1, events: [("neighbour_trade", 20)]),
        wait: (relation: 0, events: [("neighbour_trade", 5), ("neighbour_ultimatum", 3)]),
        // An event a neighbour starts joins the random pick with this weight, next to
        // quiet_weight and the weights of the pool events; not picked, it is dropped.
        weight: 50,
    ),

    // War, one at a time. StartWar queues `start_event` at the enemy at once.
    // Strength: ours = army * (1 + fort bonus per own fortified province on the enemy border
    // + sum(axis * k) of `bonus`) * treasury factor (treasury_poor at an empty treasury,
    // rising to 1 at treasury_full); theirs = the neighbour's strength.
    // Clash: each side's strength times a roll in `roll`; war_score += (ours - theirs) * score_k,
    // clamped to +-max_score. Tribute(v): treasury += v, the neighbour's strength -= v *
    // tribute_strength. EndWar(outcome): the enemy's strength changes by `end_strength`.
    // War costs: while at war the crown provinces bring `income_penalty` of their income
    // less; the army costs `army_upkeep` a year, a curve (army, upkeep) steeper the bigger
    // the army; every year the treasury is below 0, or a year of peace the income does not
    // cover the army, `desertion` of the army runs away.
    war: (
        start_event: "war_declared",
        army: "army",
        fort: ("fort", 0.1),
        bonus: [("loyalty_nobles", 0.005)],
        treasury_full: 100,
        treasury_poor: 0.6,
        roll: (0.5, 1.5),
        score_k: 0.5,
        max_score: 100,
        tribute_strength: 0.1,
        end_strength: [(Victory, -10), (Draw, 0), (Defeat, 5)],
        income_penalty: 0.3,
        army_upkeep: [(0, 0), (50, 5), (100, 15), (150, 35), (200, 70), (300, 170), (1000, 1000)],
        desertion: 0.2,
    ),

    // Direct rule has a limit (yearly): the crown holds at most capital crown power *
    // per_power + sum(axis * k of per_axis) provinces itself, the capital included. Beyond
    // that, every year: its weakest provinces (by crown power) over the limit lose `loyalty`,
    // and each of them costs the `penalty` axes and `income` of the yearly income and, while
    // over, lowers the anchors of the `pressure` axes. The land
    // stays with the crown: only the player gives it away (grant_province), or the automaton,
    // whose weight `overreach` makes a grant worth more while the crown is over its limit.
    // Stage 15 (docs/calibration.md): the capital (crown power 90) and bureaucracy 20 give
    // room for 8 at the start, two conquests above the 6 crown lands; the room grows by one
    // per 10 bureaucracy.
    crown_capacity: (
        per_power: 0.07,
        per_axis: [("bureaucracy", 0.1)],
        loyalty: 3,
        income: 2,
        // While over the room, per province over: the anchor of stability lower (stage 19; the
        // yearly `penalty` of stage 15 piled up in the shocks and held them at -100).
        pressure: [("stability", -2)],
    ),

    // Effect Grant: the nearest vassal within `max_distance` border crossings gets the
    // province, otherwise a new house named by the next unused name of names.ron `vassals`,
    // with this loyalty and strength; when the names run out, the nearest vassal at any distance.
    grant: (max_distance: 1, new_loyalty: 60, new_strength: 10, strength: 5),

    // Yearly ruler death risk in per mille: the `base` row of the largest age_from <= age,
    // plus (100 - health) * health_k, plus every risk whose `when` holds. A hit spawns the
    // death event; the ruler dies only if the choice says so. While a death event is on
    // its cooldown, its risk does not count.
    death: (
        base: [(0, 4), (40, 8), (50, 30), (55, 60), (60, 90), (65, 130), (70, 180), (80, 300)],
        health_k: 0.2,
        event: "illness",
        risks: [
            (when: WarStage(Fighting), per_mille: 30, event: "war_wound"),
            (when: Flag("plot"), per_mille: 60, event: "assassination"),
            (when: Flag("plague"), per_mille: 40, event: "illness"),
            (when: RulerAge(70, 200), per_mille: 150, event: "old_age"),
        ],
    ),

    // Game::abdicate fires `event`; its Abdicate effect ends the reign. Unless the
    // institutions axis and the first heir's ability are above their thresholds, the first
    // heir loses `claim_drop` of claim and `contested_flag` is set (succession_dispute).
    abdication: (
        event: "abdication",
        institutions: ("bureaucracy", 60),
        heir_ability: 60,
        claim_drop: 40,
        contested_flag: "succession_contested",
    ),

    // Per year. Ability grows by status until adult_age. Claims move by claim_step toward
    // the target of the current law: eldest (heirs[0]) or others, plus ability * ability_k;
    // a hostage also loses hostage_claim. Birth chance in percent by ruler age, times
    // `unmarried` without the married flag: a child out of wedlock is a bastard, out of the
    // line until recognized (recognize_bastard) with `bastard_claim`, after every lawful
    // heir. The ruler's children (World.line_from) stand first, in birth order, then the
    // collateral line; "eldest" is heirs[0].
    // `death`: yearly risk of every heir in per mille by age, like death.base.
    // Both tables are steps: the row of the largest age_from <= age holds to the end of life.
    // Births end at 50; a ruler crowned grown had children before (sim::born_before: the
    // same table over his adult years, bastards before his wedding, each child past
    // `death`), so few lines die out (stage 15, docs/calibration.md).
    heirs: (
        adult_age: 16,
        growth_home: 2,
        growth_studying: 3.5,
        growth_hostage: 1,
        hostage_claim: -4,
        claim_step: 2,
        // Who succeeds is the law's `rule` (sim::rightful): Absolute, Male, Salic,
        // Seniority, Elective, Partition. Claims say how firm the new ruler sits: the heir the
        // rule puts first has `rightful_claim` at once and moves toward `eldest`, the rest
        // toward `others`, plus ability * ability_k; a new ruler's claim below crisis_claim
        // contests the succession, and so may every heir left (dispute_per_heir percent each).
        // `coronation`: axis shifts at every coronation under the law. `female_heir`: a queen
        // crowned under the law is contested and shifts these axes. `house`: Partition's
        // (loyalty, strength) of a son's house.
        laws: [
            // `name` and `description` are for the UI; {eldest}, {others}, {ability_k},
            // {crisis_claim}, {dispute_per_heir}, {rightful_claim} stand for the numbers of the law.
            (flag: "law_primogeniture", rule: Absolute, eldest: 75, others: 35, ability_k: 0, crisis_claim: 70, rightful_claim: 90,
                name: "Абсолютное первородство",
                description: "Трон получает старший ребёнок правителя, сын или дочь, без детей — старший из боковой линии. Первый в очереди по закону сразу имеет претензию {rightful_claim}, остальные держатся у {others}. Если у наследника претензия ниже {crisis_claim}, престол оспорят."),
            (flag: "law_male", rule: Male, eldest: 75, others: 35, ability_k: 0, crisis_claim: 60, rightful_claim: 90,
                female_heir: [("legitimacy", -10), ("loyalty_nobles", -10)],
                name: "Мужское первородство",
                description: "Трон получает старший сын правителя, и право сына бесспорнее: престол оспорят, только если претензия ниже {crisis_claim}. Первый в очереди по закону сразу имеет претензию {rightful_claim}. Дочь наследует, только если сыновей нет, и тогда престол оспорят, легитимность упадёт, знать будет недовольна."),
            (flag: "law_salic", rule: Salic, eldest: 75, others: 35, ability_k: 0, crisis_claim: 70, rightful_claim: 90,
                coronation: [("legitimacy", 5)],
                name: "Салический закон",
                description: "Престол только мужчинам: сначала сыновья правителя, без них мужчина боковой линии. Женщины не наследуют вовсе: если мужчин в роду не осталось, династия пресекается. Зато право такого короля бесспорнее: легитимность при воцарении выше. Первый в очереди по закону сразу имеет претензию {rightful_claim}. Если у наследника претензия ниже {crisis_claim}, престол оспорят."),
            (flag: "law_seniority", rule: Seniority, eldest: 75, others: 35, ability_k: 0, crisis_claim: 70, dispute_per_heir: 6, rightful_claim: 90,
                name: "Лествичное право",
                description: "Престол старшему в роду: сначала братья правителя по старшинству, потом его дети. На трон приходит взрослый, но дети умершего не уступают дяде: по {dispute_per_heir}% на каждого оставшегося наследника, что престол оспорят."),
            (flag: "law_elective", rule: Elective, eldest: 0, others: 0, ability_k: 0.9, crisis_claim: 65, dispute_per_heir: 3,
                coronation: [("loyalty_nobles", 5), ("legitimacy", -10)],
                name: "Выборный закон",
                description: "Совет избирает самого способного из наследников: претензия каждого растёт к его способностям × {ability_k}, старшинство не важно. Знать при каждом избрании довольна, легитимность ниже. Проигравшие спорят: по {dispute_per_heir}% на каждого оставшегося наследника, и престол оспорят, если у избранного претензия ниже {crisis_claim}."),
            (flag: "law_partition", rule: Partition, eldest: 75, others: 35, ability_k: 0, crisis_claim: 70, rightful_claim: 90,
                coronation: [("loyalty_nobles", 5)], house: (50, 20),
                name: "Разделение",
                description: "Корону получает старший сын, а каждый следующий сын при воцарении — коронную землю в удел и свой дом. Уделы раздаются от дальних земель к столице, столица остаётся у короны. Знать довольна, но земель у короны всё меньше. Если у наследника претензия ниже {crisis_claim}, престол оспорят."),
        ],
        birth: [(0, 0), (16, 30), (35, 22), (45, 10), (50, 0)],
        // Chance in percent that a child is a son.
        male_percent: 50,
        married_flag: "married",
        unmarried: 0.2,
        // Naming an heir over the rightful one (HeirOp Designate, designate_heir, heir_dispute):
        // these axes once; at his coronation a dispute `designate_dispute` percent more likely,
        // and the rightful heir keeps his claim, a rival.
        designate_penalty: [("legitimacy", -10), ("loyalty_nobles", -5), ("loyalty_church", -5)],
        designate_dispute: 40,
        bastard_claim: 20,
        // Disputes from real causes besides the claim: a child crowned (below
        // sim.regency_age), an heir of ability below the first number: chances in percent.
        dispute_minor: 50,
        dispute_weak: (67, 100),
        death: [(0, 120), (1, 40), (5, 6), (16, 6), (30, 10), (40, 15), (50, 30), (55, 60), (60, 90), (65, 130), (70, 180), (80, 300)],
    ),

    // A suit (Effect::Marry, marry_neighbour): the ruler weds without heirs.married_flag,
    // else the first heir in line of `age` or older not yet married. A court at war with the
    // crown, already wed to it or with a relation below refuse_below turns it away outright;
    // else it agrees with the chance in percent: percent + relation * relation_k
    // + sum(axis * k) + (our strength / theirs - 1) * strength_k (war::strengths), 0..=100.
    marriage: (
        age: 14,
        refuse_below: -20,
        percent: 30,
        relation_k: 0.5,
        axes: [("prestige", 0.1)],
        strength_k: 20,
    ),

    // Every coronation in the simulation (sim::crown), in this order: each faction axis moves
    // `reset` of the way back to its anchor under the laws in force (a new page); the axis of legitimacy_from_claim
    // moves its share of the way toward the new ruler's claim (0.5: the mean of the two);
    // a contested succession (abdication.contested_flag) adds `contested`; then the law's
    // `coronation`, then the `axes` of the ruler's traits (sim.traits).
    coronation: (
        reset: 0.3,
        legitimacy_from_claim: ("legitimacy", 0.5),
        contested: [("legitimacy", -10), ("loyalty_nobles", -10)],
    ),

    // The dynasty after the founder (sim::run): the same rules year by year, the choices
    // made by sim::AutoChooser, until a fall or `max_years` from tick 0.
    // Falls: no heir, the capital not held by the crown, `usurped_flag`, no crown province.
    sim: (
        max_years: 300,
        // Events of this importance and above go to the chronicle; a new ruler and a
        // province lost or gained always do, with importance `notable`.
        threshold: 4,
        notable: 5,
        // Every player decision marks what it changed with weight 1; the weight is
        // multiplied by `decay` every year. Chronicle entries collect these marks as causes.
        decay: 0.97,
        // The hint of the main cause shows in the entry from this weight on: the founder's
        // decisions fade from the chronicle along with their marks.
        hint_weight: 0.3,
        usurped_flag: "usurped",
        // A ruler younger than regency_age reigns under the flag until he reaches it.
        regency_flag: "regency",
        regency_age: 16,
        // The first heir's death (texts.heir_died) is told from this age on; a younger one
        // only if he was the last heir, none was born after and the dynasty ended NoHeir.
        heir_death_age: 14,
        // Flags of one reign, cleared when the next ruler is crowned.
        reign_flags: ["church_regency"],
        ruler_health: 80,
        // Relation of the state a seceding vassal founds (Effect::Secede).
        secession_relation: -50,
        // Trait chance of a new ruler in percent: percent + ability * ability_k, plus
        // `studying` or `hostage` by the heir's status.
        // `axes`: shifts once, at the coronation; `told`: (of a king, of a queen), added to the
        // coronation entry for the trait with the largest shift.
        traits: [
            (id: "greedy", percent: 35, ability_k: -0.3, studying: 0, hostage: 10,
                axes: [("loyalty_people", -10)],
                told: ("Народ роптал: новый король слыл скупцом.", "Народ роптал: новая королева слыла скупой.")),
            (id: "cautious", percent: 10, ability_k: 0.3, studying: 10, hostage: 15,
                axes: [("stability", 5)],
                told: ("Страна вздохнула спокойно: новый король не любил поспешных решений.", "Страна вздохнула спокойно: новая королева не любила поспешных решений.")),
            (id: "warlike", percent: 30, ability_k: 0, studying: -15, hostage: 10,
                axes: [("loyalty_nobles", 10)],
                told: ("Знать ликовала: новый король рвался в поход.", "Знать ликовала: новая королева рвалась в поход.")),
            (id: "pious", percent: 10, ability_k: 0, studying: 35, hostage: -5,
                axes: [("loyalty_church", 10)],
                told: ("Церковь возрадовалась: новый король был набожен.", "Церковь возрадовалась: новая королева была набожна.")),
        ],
        // AutoChooser: an option scores sum(weight[key] * amount) over its effects, plus a
        // roll in 0..=noise. Keys: axis ids, flag ids (+1 set, -1 cleared; only a change
        // counts, so a law change weighs the new law's flag less the old one's) and effect kinds:
        // province_income, province_population, province_loyalty, health, relation,
        // crown_power, heir_ability, heir_claim (by the delta), army_upkeep (by the change in
        // yearly upkeep an army change brings, war.army_upkeep); build, grant, revoke, secede,
        // war, hostage, death, abdicate, marriage (+1 a wedding; a suit by its chance), recognize
        // (+1 a bastard recognized, plus heir with no heir left); overreach (+1 for a grant while the crown is over
        // crown_capacity); province (+1 gained, -1 given); heir (+1, -1).
        // Weights of the ruler's traits add to `base`.
        auto: (
            noise: 10,
            base: {
                "treasury": 0.3, "income": 2, "army": 0.3, "legitimacy": 1, "stability": 1,
                "bureaucracy": 0.5, "loyalty_nobles": 0.6, "loyalty_church": 0.4,
                "loyalty_people": 0.5, "prestige": 0.3,
                "province_income": 2, "province_population": 0.005, "province_loyalty": 0.2,
                "health": 0.5, "relation": 0.1, "crown_power": 0.5,
                "build": 3, "grant": -20, "revoke": -3, "secede": -10, "war": -10, "hostage": -10,
                "death": -500, "abdicate": -500, "province": 20, "heir": 60,
                "heir_ability": 0.3, "heir_claim": 0.2, "army_upkeep": -0.1, "marriage": 20, "married": 30,
                // A bastard recognized: the church frowns; with no heir left `heir` adds up.
                "recognize": -20,
                // Beyond the limit a grant is weighed like any other (grant, province); with
                // overreach 30 the heirs give the conquests away and warmonger dynasties fall
                // to usurpation (stage 15, docs/calibration.md).
                "overreach": 0,
                "usurped": -12, "plot": -20, "plague": -20,
                // Laws change rarely: `law` for any change, then per point of a law's anchor
                // shift or resistance on a pressing faction (laws.pressure).
                "law": -10, "pressure": 2,
            },
            traits: {
                "greedy": {"treasury": 0.3, "income": 2, "province_income": 2},
                "cautious": {"war": -20, "army": 0.3, "stability": 1, "health": 1, "law_primogeniture": 18},
                "warlike": {"war": 25, "army": 0.4, "prestige": 0.7, "province": 20, "law_male": 15},
                "pious": {"loyalty_church": 1.2, "law_salic": 20},
            },
        ),
        // (title, text) of the entries the simulation makes itself, told in the past. Names
        // take a case and words agree with sex (text.rs): `{ruler.род}`, `{ruler:взошёл|взошла}`.
        // `crowned`: {ruler} the new ruler, {prev} the last one with his epithet; the lands
        // entries: {province}, {neighbour}, {ruler}; `heir_died`: {heir}; the laws: {law},
        // {ruler}; `partition`: {lands}, {ruler}. The titles stay as they are: the UI and
        // `cli batch` find the entries by them.
        texts: (
            crowned: ("Новое правление", "После {prev.род} на престол {ruler:взошёл|взошла} {ruler}."),
            province_lost: ("Потеря земли", "Земля {province} отошла под руку {neighbour.род}."),
            province_gained: ("Земля возвращена", "При {ruler.пр} земля {province}, прежде принадлежавшая {neighbour.дат}, вновь отошла к короне."),
            // The heir first in line died of age risk (heirs.death); see heir_death_age.
            heir_died: ("Смерть наследника", "{heir:Умер|Умерла} {heir}, {heir:первый|первая} в очереди на престол."),
            // The law in force changed (an action done or a choice); {law} is its name.
            law_changed: ("Новый закон о престоле", "{ruler} {ruler:переменил|переменила} порядок наследования: отныне престол переходил по закону «{law}»."),
            // Any other law of `laws` brought in, or repealed with none of its group instead.
            law_enacted: ("Новый закон", "{ruler} {ruler:ввёл|ввела} закон «{law}», и его огласили на площадях всех земель."),
            law_repealed: ("Отмена закона", "{ruler} {ruler:отменил|отменила} закон «{law}», и о нём скоро забыли."),
            partition: ("Земли поделены между братьями", "По закону о разделе младшие братья {ruler.род} получили уделы: {lands}."),
            // More texts of the entries above, picked by seed apart from the main rng.
            variants: {
                "crowned": [
                    "Престол {prev.род} {ruler:унаследовал|унаследовала} {ruler}.",
                    "Корону {prev.род} возложили на {ruler.вин}.",
                ],
                "province_lost": [
                    "Корона лишилась земли {province}: её {neighbour:забрал|забрала} {neighbour}.",
                    "{ruler} не {ruler:удержал|удержала} землю {province}, и над её замками поднялись знамёна {neighbour.род}.",
                ],
                "province_gained": [
                    "Земля {province} вернулась под руку короны, и {neighbour} {neighbour:лишился|лишилась} её.",
                    "Над замками земли {province} снова подняли королевское знамя, и {neighbour} {neighbour:смирился|смирилась} с потерей.",
                ],
                "heir_died": [
                    "Двор облачился в траур: {heir:скончался|скончалась} {heir}, {heir:наследник|наследница} престола.",
                    "Смерть унесла {heir.вин}, на {heir:котором|которой} держались надежды династии.",
                ],
                "law_changed": [
                    "По воле {ruler.род} престол с той поры наследовали по закону «{law}».",
                ],
                "law_enacted": [
                    "При {ruler.пр} в силу вошёл закон «{law}».",
                    "Глашатаи разнесли по королевству новый закон «{law}», скреплённый печатью {ruler.род}.",
                ],
                "law_repealed": [
                    "При {ruler.пр} закон «{law}» утратил силу.",
                    "Уступив знати и клиру, {ruler} {ruler:отменил|отменила} закон «{law}».",
                ],
                "partition": [
                    "Земли короны поделили между сыновьями покойного государя: {lands}.",
                ],
            },
            // What ended a reign (a RulerDies cause or the abdication event id) and the dynasty,
            // as shown to the player.
            reign_ends: {
                "illness": "болезнь",
                "old_age": "старость",
                "assassination": "убийство",
                "war_wound": "рана на войне",
                "abdication": "отречение",
                "monastery": "уход в монастырь",
            },
            // The subject is the dynasty (feminine): «89 лет на троне · пала от узурпации».
            falls: [
                (NoHeir, "пресеклась без наследника"),
                (CapitalLost, "пала с потерей столицы"),
                (Usurped, "пала от узурпации"),
                (NoCrownLand, "распалась на уделы"),
                (Alive, "правит до сих пор"),
            ],
            // How the dynasty ended, told after its last entry: {ruler} the last ruler, {year}.
            fall_told: [
                (NoHeir, [
                    "Со смертью {ruler.род} род пресёкся: некому было принять корону.",
                    "{ruler} {ruler:умер|умерла}, не оставив наследника, и династия угасла.",
                ]),
                (CapitalLost, [
                    "Враг вошёл в столицу, и династия, лишившись престольного града, пала.",
                    "С падением столицы рухнула и власть рода: {ruler} {ruler:бежал|бежала}, и корона досталась чужим.",
                ]),
                (Usurped, [
                    "Узурпатор сверг {ruler.вин} и прервал династию.",
                    "Трон захватил узурпатор, и {ruler} {ruler:стал|стала} {ruler:последним|последней} в роду, кто носил корону.",
                ]),
                (NoCrownLand, [
                    "Уделы один за другим ушли из-под руки короны, и у {ruler.род} не осталось своей земли: королевство распалось.",
                ]),
                (Alive, [
                    "Династия правит и поныне: на троне {ruler}, и летопись ещё не дописана.",
                ]),
            ],
            // Epithets by the deeds of a reign (data.rs `Epithet`): cause tags of the choices
            // and actions, `trait:<id>`, `law`, `province_gained`, `province_lost`,
            // `heir_died`. The most deeds per `min` wins, the first on a tie; `told` is the
            // sentence of the life, {epithet.тв} the epithet in a case.
            epithets: [
                (name: ("Собиратель земель", "Собирательница земель"), min: 3,
                    deeds: ["province_gained", "war_won_land", "war_siege_won"],
                    told: ["{ruler} {ruler:приумножил|приумножила} владения короны, и {ruler:его|её} прозвали {epithet.тв}.",
                        "Земли, присоединённые {ruler.тв}, надолго остались за короной, и в летописи {ruler:он вошёл|она вошла} как {ruler} {epithet}."]),
                (name: ("Несчастный", "Несчастная"), min: 3,
                    deeds: ["province_lost", "heir_died", "war_lost_hostage", "invasion_yielded", "revolt_conceded"],
                    told: ["Беды не оставляли {ruler.вин} всё правление, и летописец назвал {ruler:его|её} {epithet.тв}.",
                        "Судьба не щадила {ruler.род}: потери шли одна за другой, и {ruler:его|её} помнили как {epithet.вин}."]),
                (name: ("Воитель", "Воительница"), min: 3,
                    deeds: ["trait:warlike", "war_declared_by_crown", "war_accepted", "invasion_met", "war_attack", "war_storm", "war_last_stand", "war_battle", "nomads_fought", "incident_raid"],
                    told: ["Почти всё правление {ruler} {ruler:провёл|провела} в седле, и в летописи {ruler:он остался|она осталась} {epithet.тв}.",
