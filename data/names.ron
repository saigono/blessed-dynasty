        "Анно||||||", "Дитрих||а|у|а|ом|е", "Эккехард||а|у|а|ом|е",
        "Болеслав||а|у|а|ом|е", "Оттокар||а|у|а|ом|е", "Фридрих||а|у|а|ом|е",
        "Вильгельм||а|у|а|ом|е", "Арнульф||а|у|а|ом|е", "Гуго||||||",
