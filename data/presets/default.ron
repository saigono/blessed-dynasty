// «Наследник угасшего дома»: корона по праву, но без поддержки. Средняя сложность.
// The map lives in data/maps/default.ron: load with `Preset::load_with_map`.
// Weir holds holm and weir, Arden holds arden and mar (see the map).
(
    start_year: 1187,
    // Overrides of rules.ron defaults; unlisted axes start at their default.
    axes: {
        "legitimacy": 45,
        "stability": 55,
        "loyalty_nobles": 40,
        "loyalty_church": 60,
        "loyalty_people": 50,
        "bureaucracy": 20,
        "treasury": 150,
    },
    capital: (province: "capital", crown_bonus: 20),
    vassals: [
        (id: "weir", name: "Вейр", loyalty: 55, strength: 20),
        (id: "arden", name: "Арден", loyalty: 50, strength: 20),
    ],
    ruler: (
        name: "Ульрих",
        age: 32,
        health: 80,
        traits: ["pious"],
        reign_start: 0,
    ),
    heirs: [
        (name: "Конрад", age: 6, ability: 50, claim: 70, status: Home),
    ],
    // Nordmark hostile, Purpur neutral, Vestrum friendly (rules.ron neighbour_ai thresholds).
    neighbours: [
        (id: "nordmark", name: "Нордмарк", relation: -40, strength: 40, stance: Defend),
        (id: "purpur", name: "Пурпуляндия", relation: 0, strength: 50, stance: Wait),
        (id: "vestrum", name: "Веструм", relation: 40, strength: 30, stance: Trade),
    ],
    // The succession law and the ruler's marriage.
    flags: ["law_primogeniture", "married"],
)
