// Reign events of the vertical slice: 30 in the random pool plus chain steps (weight 0).
// Prefixes: cap_ capital, prov_ provinces, fac_ factions, heir_ heirs, nb_ neighbours,
// dis_ disasters. Chain steps are spawned by the middle choice, so the neutral strategy
// reaches them. Flags `plot`, `plague`, `guard` are read by the death risk of stage 5.
[
    // ---------------------------------------------------------------- capital
    (
        id: "cap_court_intrigue",
        title: "Интриги при дворе",
        text: "Во дворце две партии: старые роды с гербами на плащах и новые писцы с чернильными пальцами. Каждая нашёптывает у трона о кознях другой, и обе ждут, на чью сторону встанет {ruler}.",
        texts: [
            "За обедом барон нарочно опрокинул чернильницу на счётные книги, а наутро писцы донесли, что тот утаил подать с трёх деревень. Двор ждёт, кого накажут.",
            "Канцлер жалуется на спесь баронов, бароны на наглость канцлера. В коридорах дворца перестали здороваться, и даже слуги разделились на два лагеря.",
        ],
        when: All([]),
        weight: 4,
        once: false,
        cooldown_years: 6,
        importance: 2,
        sign: Bad,
        target: None,
        choices: [
            (
                text: "Приблизить писцов и счётчиков",
                effects: [Axis("bureaucracy", 4), Axis("loyalty_nobles", -5)],
                cause_tag: "court_clerks",
                hint: "Перо служит короне вернее меча, но знать этого не простит.",
                told: "{ruler} {ruler:приблизил|приблизила} к трону писцов и счётчиков, и старые роды затаили обиду на выскочек с чернильницами.",
                retold: [
                    "Счётные книги взяли верх над гербами: писцы получили места в совете, а бароны стали ездить ко двору реже.",
                    "При {ruler.пр} в совете заскрипели перья: должности отдали грамотеям, и знать ворчала, что корону теперь носят в чернильнице.",
                ],
            ),
            (
                text: "Дать партиям грызться между собой",
                effects: [Axis("stability", -3), Axis("legitimacy", 2)],
                cause_tag: "court_divide",
                hint: "Пока слуги спорят, господин над ними.",
                told: "При дворе схлестнулись старые роды и новые писцы, а {ruler} не {ruler:вмешался|вмешалась}: пока слуги грызлись, господин стоял над ними.",
                retold: [
                    "{ruler} {ruler:слушал|слушала} доносы обеих партий и ни одной не {ruler:давал|давала} верх, и при дворе долго тлела глухая война.",
                    "Писцы и бароны годами строчили друг на друга жалобы, а {ruler} {ruler:читал|читала} их по вечерам и {ruler:складывал|складывала} в сундук.",
                ],
            ),
            (
                text: "Опереться на старые роды",
                effects: [Axis("loyalty_nobles", 5), Axis("bureaucracy", -3)],
                cause_tag: "court_nobles",
                hint: "Старые роды помнят тех, кто их возвысил.",
                told: "{ruler} {ruler:опёрся|оперлась} на старые роды, и писцов оттеснили от трона.",
                retold: [
                    "Гербы победили чернильницы: бароны вернули себе места в совете, а писцам велели знать своё место за конторкой.",
                    "{ruler} {ruler:встал|встала} на сторону знати, и в счётной палате остались только переписчики да мыши.",
                ],
            ),
        ],
    ),
    (
        id: "cap_guild_charter",
        title: "Гильдии просят хартию",
        text: "Старшины столичных цехов принесли к трону хартию вольностей: свой суд, свои весы и право не пускать на рынок чужаков. Они просят скрепить её королевской печатью.",
        texts: [
            "Суконщики, кожевники и золотых дел мастера пришли ко двору в праздничных кафтанах. В руках у старшего свиток с цеховыми вольностями, а за его спиной полгорода.",
            "Цеха столицы устали платить мытарям за каждый чих. Они просят хартию, по которой город сам будет судить своих и сам собирать пошлины.",
        ],
        // Granted or sold, the charter stays with the guilds (stage 25).
        when: NotFlag("guild_charter"),
        weight: 4,
        once: false,
        cooldown_years: 10,
        importance: 2,
        sign: Good,
        target: None,
        choices: [
            (
                text: "Даровать хартию вольностей",
                effects: [Province(Capital, Income, 2), Axis("liberties", 5), Axis("loyalty_people", 4), Axis("loyalty_nobles", -3), SetFlag("guild_charter")],
                cause_tag: "guild_charter_granted",
                hint: "Вольный город богатеет, а знать косится на купцов.",
                told: "{ruler} {ruler:скрепил|скрепила} печатью хартию столичных цехов. Город зажил вольнее и богаче, а знать косилась на разбогатевших купцов.",
                retold: [
                    "Хартию цехов прочли на рыночной площади, и в тот вечер в каждой мастерской пили за здоровье {ruler.род}.",
                    "Столица получила свои вольности, цеховой суд и печать с ключом и молотом, и бароны впервые позавидовали горожанам.",
                ],
            ),
            (
                text: "Продать хартию за серебро",
                effects: [Axis("treasury", 40), Axis("loyalty_people", -2), SetFlag("guild_charter")],
                cause_tag: "guild_charter_sold",
                hint: "Серебро сейчас, обида потом.",
                told: "Старшины цехов выкупили у короны хартию вольностей за серебро. Казна пополнилась, но в цехах ворчали, что свободу им продали втридорога.",
                retold: [
                    "Хартию цехам отдали не даром: за каждую вольность старшины заплатили серебром, и казначей потирал руки.",
                    "Цеха получили свою хартию, но за такую цену, что старшины потом годами собирали долги с подмастерьев.",
                ],
            ),
            (
                text: "Отказать старшинам цехов",
                effects: [Axis("loyalty_nobles", 2), Axis("loyalty_people", -4)],
                cause_tag: "guild_charter_refused",
                hint: "Цеха запомнят отказ.",
                told: "Цеха столицы просили хартию вольностей, но {ruler} им {ruler:отказал|отказала}, и старшины ушли от трона с затаённой обидой.",
                retold: [
                    "Хартию вернули старшинам без печати, и на ближайшей ярмарке цеховые мастера торговали неохотно и дорого.",
                    "{ruler} не {ruler:дал|дала} цехам вольностей, и в мастерских долго поминали этот день недобрым словом.",
                ],
            ),
        ],
    ),
    (
        id: "cap_cathedral",
        title: "Собор на холме",
        text: "Епископ развернул перед троном чертёж собора: пять глав, колокольня выше городских стен, витражи из заморского стекла. Он просит корону заложить его на холме над рекой.",
        texts: [
            "Старая столичная церковь тесна, своды в трещинах, и в праздник люди стоят на паперти под дождём. Епископ просит новый собор, какого не видели на сто вёрст окрест.",
            "Каменщики из-за гор уже ждут подряда, а епископ ждёт ответа. Собор на холме прославил бы и город, и тех, кто его поставит.",
        ],
        when: All([NotFlag("cathedral_building"), NotFlag("cathedral")]),
        weight: 3,
        once: true,
        cooldown_years: 0,
        importance: 3,
        sign: Good,
        target: None,
        choices: [
            (
                text: "Строить собор за счёт казны",
                effects: [Axis("treasury", -60), Axis("loyalty_church", 8), SetFlag("cathedral_building"), SpawnEvent("cap_cathedral_consecrated", 4)],
                cause_tag: "cathedral_crown",
                hint: "Камень переживёт того, кто его заложил.",
                told: "{ruler} {ruler:велел|велела} заложить в столице собор на казённые деньги, и епископ благословил первый камень.",
                retold: [
                    "На холме над рекой вбили первые сваи, и казна стала платить каменщикам, резчикам и стекольщикам.",
                    "Собор начали строить на королевское серебро, и {ruler} сам{ruler:|а} {ruler:положил|положила} в основание первый камень с гербом рода.",
                ],
            ),
            (
                text: "Строить на пожертвования прихожан",
                effects: [Axis("treasury", -15), Axis("loyalty_people", -3), Axis("loyalty_church", 4), SetFlag("cathedral_building"), SpawnEvent("cap_cathedral_consecrated", 7)],
                cause_tag: "cathedral_alms",
                hint: "Строить будут долго и с ропотом.",
                told: "В столице заложили собор на пожертвования прихожан. Строили его медленно и с ропотом, но церковь была довольна.",
                retold: [
                    "По приходам пустили кружку на собор, и каждый воскресный грош шёл на камень; стройка двигалась медленно, а ропот рос быстро.",
                    "Собор заложили на деньги прихожан, и в городе шутили, что каждая ступень его лестницы стоит одного голодного ужина.",
                ],
            ),
            (
                text: "Отложить до лучших времён",
                effects: [Axis("loyalty_church", -5)],
                cause_tag: "cathedral_delayed",
                hint: "Церковь не любит ждать.",
                told: "Епископ просил заложить в столице собор, но {ruler} {ruler:отложил|отложила} стройку до лучших времён, и клир долго поминал этот отказ.",
                retold: [
                    "Чертёж собора вернули епископу со словами «не ныне», и с амвонов стали чаще говорить о скупости земных владык.",
                    "Собор на холме остался на пергаменте: корона сослалась на пустую казну, а клир запомнил.",
                ],
            ),
        ],
    ),
    (
        // Chain step of cap_cathedral.
        id: "cap_cathedral_consecrated",
        title: "Освящение собора",
        text: "Собор достроен. Леса сняты, большой колокол подняли на звонницу, и его слышно за три версты от стен. Епископ ждёт двор на освящение.",
        texts: [
            "Над холмом сияют новые главы, витражи горят на солнце, и паломники уже стоят у дверей. Остаётся решить, чем станет собор для королевского дома.",
            "Последний камень положен, и мастера получили расчёт. Епископ готовит освящение и спрашивает, будет ли двор венчаться под новыми сводами.",
        ],
        when: Flag("cathedral_building"),
        weight: 0,
        once: true,
        cooldown_years: 0,
        importance: 3,
        sign: Good,
        target: None,
        choices: [
            (
                text: "Венчаться в соборе заново",
                effects: [ClearFlag("cathedral_building"), SetFlag("cathedral"), Axis("legitimacy", 6), Axis("prestige", 15)],
                cause_tag: "cathedral_crowning",
                hint: "Корона, освящённая заново, сидит крепче.",
                told: "Собор на холме освятили, и {ruler} {ruler:венчался|венчалась} в нём на царство заново. Корона, освящённая под новыми сводами, села крепче.",
                retold: [
                    "В день освящения собора {ruler} второй раз {ruler:принял|приняла} миропомазание, и толпа на холме кричала так, что заглушала колокола.",
                    "Под новыми сводами епископ вновь возложил корону на голову {ruler.род}, и летописец записал, что в тот день плакали даже бароны.",
                ],
            ),
            (
                text: "Отдать собор под усыпальницу рода",
                effects: [ClearFlag("cathedral_building"), SetFlag("cathedral"), Axis("loyalty_church", 5), Axis("prestige", 10)],
                cause_tag: "cathedral_crypt",
                hint: "Род, у которого есть усыпальница, думает о веках.",
                told: "Собор на холме освятили и отдали под усыпальницу царствующего рода, чтобы потомки покоились рядом с предками.",
                retold: [
                    "В подклете нового собора выбили ниши для гробниц, и над первой из них вырезали герб рода и слова «до скончания века».",
                    "Собор стал домом мёртвых королей: под его плитами отвели место для всей династии, и епископ служил там поминальные службы.",
                ],
            ),
        ],
    ),
    (
        id: "cap_fire",
        title: "Пожар: {province}",
        text: "Ночью в {province.пр} загорелись склады с паклей у реки. Ветер погнал огонь по крышам, и к рассвету от посада остались трубы да колодцы.",
        texts: [
            "Пожар в {province.пр}: искра из кузни попала в сено, и через час полыхала вся улица. Погорельцы ночуют на площади, а дым виден за десять вёрст.",
            "Над {province.тв} второй день стоит дым. Деревянный посад сгорел дотла вместе с лавками и амбарами, и люди роются в золе, ища уцелевшее.",
        ],
        texts_when: [
            (Flag("plague"), "В {province.пр} пожар, и в городе шепчут, что дома подожгли нарочно, чтобы выжечь мор. Посад выгорел дотла, и погорельцы боятся теперь и огня, и заразы."),
        ],
        recalled: "пожар",
        // In a crown province, the capital among them. A town rebuilt in stone (the mark
        // "stone") does not burn again; the others still may (stage 25).
        when: All([]),
        weight: 3,
        once: false,
        cooldown_years: 12,
        importance: 3,
        sign: Bad,
        target: RandomProvince((holder: Crown)),
        unmarked: Some("stone"),
        choices: [
            (
                text: "Отстроить посад из казны",
                effects: [Axis("treasury", -50), Axis("loyalty_people", 4), Province(EventTarget, Population, -500)],
                cause_tag: "fire_rebuilt",
                hint: "Погорельцы помнят, кто дал им кров.",
                told: "Ночной пожар выжег целый посад в {province.пр}, и {ruler} {ruler:отстроил|отстроила} его на казённые деньги. Погорельцы долго благословляли {ruler:его|её} имя.",
                retold: [
                    "На пепелище в {province.пр} привезли казённый лес и плотников, и к зиме погорельцы справляли новоселье.",
                    "После пожара в {province.пр} корона заплатила за каждую сгоревшую избу, и на новых воротах ещё долго вырезали королевский герб.",
                ],
            ),
            (
                text: "Пусть отстраиваются сами",
                effects: [Province(EventTarget, Income, -2), Province(EventTarget, Population, -1500), Axis("loyalty_people", -4)],
                cause_tag: "fire_ignored",
                hint: "Пепелище долго не зарастает.",
                told: "Ночной пожар выжег посад в {province.пр}, и погорельцы отстраивались сами, как могли. Пепелище ещё долго чернело посреди города.",
                retold: [
                    "Погорельцы из {province.род} просили помощи, но получили только совет молиться, и многие ушли искать хлеба в другие края.",
                    "Посад в {province.пр} сгорел, и корона не дала на него ни гроша; землянки на пепелище стояли там ещё несколько лет.",
                ],
            ),
            (
                text: "Строить заново только из камня",
                effects: [Axis("treasury", -80), Province(EventTarget, Population, -500), Axis("prestige", 8), Axis("loyalty_people", -2), Mark("stone")],
                cause_tag: "fire_stone",
                hint: "Каменный город не горит, но дорог.",
                told: "Ночной пожар выжег посад в {province.пр}, и {ruler} {ruler:велел|велела} строить там заново только из камня. Город стал краше, но казна опустела.",
                retold: [
                    "На месте сгоревшего посада в {province.пр} поднялись каменные дома под черепицей, и с тех пор там больше не боялись огня.",
                    "Указом {ruler.род} в {province.пр} запретили рубить избы, только камень и черепица, и каменотёсы съезжались туда со всего королевства.",
                ],
            ),
        ],
    ),
    (
        id: "cap_plot",
        title: "Заговор",
        text: "Верный слуга донёс: несколько знатных господ собираются по ночам в охотничьем доме за рекой. Пьют за здоровье покойных королей и поминают имя {ruler.род} недобро.",
        texts: [
            "Перехвачено письмо без подписи: «Когда зазвонят к заутрене, будьте у западных ворот». Почерк знакомый, и канцлер бледнеет, читая его вслух.",
            "В тавернах столицы слишком много баронских слуг, а в оружейных лавках раскупили все кинжалы. Соглядатаи шепчут слово «заговор».",
        ],
        recalled: "заговор",
        when: All([NotFlag("plot"), AxisBelow("loyalty_nobles", 55)]),
        weight: 3,
        once: false,
        cooldown_years: 8,
        importance: 4,
        sign: Bad,
        target: None,
        choices: [
            (
                text: "Схватить всех подозреваемых",
                effects: [Axis("loyalty_nobles", -8), Axis("legitimacy", -2), Axis("stability", 2)],
                cause_tag: "plot_arrests",
                hint: "Хватать без суда значит плодить новых заговорщиков.",
                told: "До {ruler.род} дошли слухи о заговоре знатных господ, и стража схватила всех подозреваемых без разбора и суда.",
                retold: [
                    "Ночью по городу прошла стража с факелами, и к утру в темнице сидели двенадцать господ с их слугами, виновные и невиновные вперемешку.",
                    "Подозреваемых в заговоре хватали прямо на пирах, и знать ещё долго опасалась пить за чужое здоровье.",
                    "По первому доносу стража схватила всех, на кого указали, и в тюремных подвалах в ту осень не хватало соломы.",
                    "Заговор задушили арестами: двенадцать знатных домов лишились глав, и кто из них был виновен, так и не узнали.",
                ],
            ),
            (
                text: "Следить и ждать, пока раскроются",
                effects: [SetFlag("plot"), SpawnEvent("cap_plot_unmasked", 2)],
                cause_tag: "plot_watched",
                hint: "Змея, за которой следят, всё ещё змея.",
                told: "{ruler} {ruler:узнал|узнала} о ночных сборищах заговорщиков, но не {ruler:спешил|спешила} хватать их: соглядатаи следили за каждым их шагом.",
                retold: [
                    "За охотничьим домом у реки установили слежку, и каждое утро на столе у {ruler.род} лежал список тех, кто приходил туда ночью.",
                    "Заговорщиков не тронули: им дали время назвать друг друга, а соглядатаи тем временем переписывали их письма.",
                    "Соглядатаи сидели за каждым столом, где собирались заговорщики, и {ruler} {ruler:знал|знала} их замыслы раньше, чем они сами.",
                    "Заговорщиков не стали хватать сразу: их водили на длинном поводке, пока они не выдали всех, кто стоял за ними.",
                ],
            ),
            (
                text: "Удвоить стражу у покоев",
                effects: [Axis("treasury", -30), SetFlag("guard"), Axis("loyalty_nobles", -2)],
                cause_tag: "plot_guard",
                hint: "Верная стража бережёт жизнь государя.",
                told: "Прослышав о заговоре, {ruler} {ruler:удвоил|удвоила} стражу у своих покоев.",
                retold: [
                    "С того дня у дверей королевской спальни стояли не двое, а четверо, и каждого из новых {ruler} {ruler:выбирал|выбирала} сам{ruler:|а}.",
