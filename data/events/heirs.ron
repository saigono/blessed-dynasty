// Heirs: upbringing, marriage, disputes, death. Upbringing, marriage and death target a
// random heir of the right age (`{heir}`); disputes address heirs by index: heirs[0] is the
// first heir (the eldest, newborns are appended), heirs[1] the second.
[
    (
        id: "heir_tutor",
        title: "Воспитатель наследника",
        text: "{heir} подрастает. При дворе спорят, кому доверить воспитание.",
        when: All([]),
        weight: 6,
        once: false,
        cooldown_years: 4,
        importance: 3,
        sign: Good,
        target: Heir(6, 12),
        choices: [
            (
                text: "Отдать в монастырскую школу",
                effects: [HeirOp(TargetStatus(Studying("Монастырь"))), Axis("loyalty_church", 5)],
                cause_tag: "tutor_church",
                hint: "Монахи вырастят книжника, а не воина.",
            ),
            (
                text: "Поручить старому рыцарю",
                effects: [HeirOp(TargetAbility(5)), Axis("loyalty_nobles", 5)],
                cause_tag: "tutor_knight",
                hint: "Знать увидит в наследнике своего.",
            ),
            (
                text: "Пригласить учёного из-за моря",
                effects: [HeirOp(TargetAbility(10)), Axis("treasury", -40), Axis("loyalty_church", -3)],
                cause_tag: "tutor_scholar",
                hint: "Учёный из-за моря научит многому, но не любви к своим.",
            ),
        ],
    ),
    (
        id: "heir_marriage",
        title: "Брак наследника",
        text: "{heir}: пора подумать о браке. Соседние дворы присылают сватов.",
        when: All([]),
        weight: 15,
        once: false,
        cooldown_years: 3,
        importance: 3,
        sign: Good,
        target: UnmarriedHeir(16, 30),
        choices: [
            (
                text: "Искать пару при чужеземном дворе",
                effects: [HeirOp(TargetMarry), Axis("prestige", 10), Axis("loyalty_nobles", -3)],
                cause_tag: "heir_married_foreign",
                hint: "Чужеземный брак приводит ко двору чужих советников.",
            ),
            (
                text: "Искать пару среди своих баронов",
                effects: [HeirOp(TargetMarry), Axis("loyalty_nobles", 5), HeirOp(TargetClaim(5))],
                cause_tag: "heir_married_noble",
                hint: "Род, породнившийся с короной, захочет большего.",
            ),
            (
                text: "Повременить со свадьбой",
                effects: [Axis("prestige", -2)],
                cause_tag: "heir_marriage_delayed",
                hint: "Свадьба, отложенная надолго, может не состояться вовсе.",
            ),
        ],
    ),
    (
        // An unmarried ruler (no heirs.married_flag): mostly a ruler crowned before his
        // heir_marriage came. Without it births are rare (heirs.unmarried).
        id: "ruler_marriage",
        title: "Брак на троне",
        text: "У престола нет супруга, а у короны мало наследников. Двор ждёт свадьбы, {neighbour} присылает сватов.",
        when: NotFlag("married"),
        weight: 40,
        once: false,
        cooldown_years: 2,
        importance: 3,
        sign: Good,
        target: Neighbour,
        choices: [
            (
                text: "Принять сватов из-за границы",
                effects: [Marry(
                    then: [Relation(EventTarget, 20), Axis("prestige", 5)],
                    otherwise: [Relation(EventTarget, -5), Axis("prestige", -5), SpawnEvent("marriage_refused", 0)],
                )],
                cause_tag: "ruler_married_foreign",
                hint: "Брак с чужим двором роднит корону с соседом, пока жив супруг и нет войны.",
            ),
            (
                text: "Породниться с домом своего барона",
                effects: [SetFlag("married"), Axis("loyalty_nobles", 5), Axis("prestige", -3)],
                cause_tag: "ruler_married_noble",
                hint: "Барон, ставший роднёй короны, ждёт милостей.",
            ),
            (
                text: "Повременить со свадьбой",
                effects: [Axis("prestige", -2)],
                cause_tag: "ruler_marriage_delayed",
                hint: "Без свадьбы у престола мало наследников.",
            ),
        ],
    ),
    (
        // After a suit turned down (marry_neighbour, Effect::Marry); its costs are the
        // suit's `otherwise`.
        id: "marriage_refused",
        title: "{neighbour} отверг сватовство",
        text: "Сваты вернулись ни с чем: {neighbour} не отдаёт руки за наш дом. При соседних дворах об этом судачат.",
        when: All([]),
        weight: 0,
        once: false,
        cooldown_years: 0,
        importance: 4,
        sign: Bad,
        target: None,
        choices: [
            (
                text: "Стерпеть обиду",
                effects: [],
                cause_tag: "marriage_refused",
                hint: "Отказ запоминают при всех дворах.",
            ),
        ],
    ),
    (
        // Fires when the claims of the first two heirs are close: rare under primogeniture,
        // frequent without a law.
        id: "heir_dispute",
        title: "Спор наследников",
        text: "Двое королевских детей не уступают друг другу, у каждого свои сторонники при дворе.",
        when: All([HeirAge(1, 14, 99), ClaimGapBelow(30)]),
        weight: 8,
        once: false,
        cooldown_years: 5,
        importance: 4,
        target: None,
        choices: [
            (
                text: "Назначить старшего",
                effects: [HeirOp(Claim(0, 20)), HeirOp(Claim(1, -15)), Axis("loyalty_nobles", 3)],
                cause_tag: "dispute_elder",
                hint: "Обойдённый не забывает обиды.",
            ),
            (
                text: "Назначить младшего",
                effects: [
                    HeirOp(Claim(1, 25)),
                    HeirOp(Claim(0, -20)),
                    Axis("legitimacy", -5),
                    Axis("loyalty_nobles", -5),
                ],
                cause_tag: "dispute_younger",
                hint: "Нарушенный обычай отзывается смутой.",
            ),
            (
                text: "Созвать собор",
                effects: [
                    Axis("treasury", -30),
                    Axis("loyalty_church", 5),
                    Axis("stability", -3),
                    HeirOp(Claim(0, 10)),
                ],
                cause_tag: "dispute_council",
                hint: "Решение собора крепче воли одного человека.",
            ),
        ],
    ),
    (
        id: "heir_death",
        title: "Беда с наследником",
        text: "{heir}: падение с коня на охоте, потом горячка. Лекари не ручаются за жизнь.",
        when: All([]),
        weight: 3,
        once: false,
        cooldown_years: 5,
        importance: 4,
        target: Heir(0, 99),
        choices: [
            (
                text: "Позвать лучших лекарей",
                effects: [
                    Axis("treasury", -40),
                    Chance((percent: 80, then: [HeirOp(TargetAbility(-3))], otherwise: [HeirOp(TargetRemove)])),
                ],
                cause_tag: "heir_doctors",
                hint: "Хорошие лекари дороги, но жизнь наследника дороже.",
            ),
            (
                text: "Молиться",
                effects: [
                    Axis("loyalty_church", 3),
                    Chance((percent: 65, then: [HeirOp(TargetAbility(-3))], otherwise: [HeirOp(TargetRemove)])),
                ],
                cause_tag: "heir_prayer",
                hint: "Церковь запомнит смирение двора, исход в руках Божьих.",
            ),
            (
                text: "Положиться на крепость юности",
                effects: [
                    Chance((percent: 45, then: [HeirOp(TargetAbility(3))], otherwise: [HeirOp(TargetRemove)])),
                ],
                cause_tag: "heir_left_alone",
                hint: "Наследник, выживший сам, не будет обязан ни лекарям, ни монахам.",
            ),
        ],
    ),
    (
        // After a contested abdication (rules.ron `abdication`); fires in the simulation.
        id: "succession_dispute",
        title: "Спор о короне",
        text: "Корона сложена до срока. Бароны не признают наследника и называют своих претендентов.",
        when: Flag("succession_contested"),
        weight: 100,
        once: true,
        cooldown_years: 0,
        importance: 5,
        target: None,
        choices: [
            (
                text: "Купить верность баронов",
                effects: [Axis("treasury", -100), Axis("loyalty_nobles", 5), HeirOp(Claim(0, 10))],
                cause_tag: "succession_bought",
                hint: "Купленная верность длится, пока есть чем платить.",
            ),
            (
                text: "Опереться на церковь",
                effects: [Axis("loyalty_church", 5), Axis("loyalty_nobles", -10), HeirOp(Claim(0, 5))],
                cause_tag: "succession_church",
                hint: "Церковь освятит наследника, но знать сочтёт себя обойдённой.",
            ),
            (
                text: "Уступить совету баронов",
                effects: [Axis("legitimacy", -10), Axis("loyalty_nobles", 10), ClearFlag("law_primogeniture"), ClearFlag("law_male"), ClearFlag("law_salic"), ClearFlag("law_seniority"), ClearFlag("law_partition"), SetFlag("law_elective")],
                cause_tag: "succession_yielded",
                hint: "Однажды уступив выбор знати, корона его не вернёт.",
            ),
        ],
    ),
]
