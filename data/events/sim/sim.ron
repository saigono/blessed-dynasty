// Simulation events: only sim::run draws them (Data::add_sim_events), the reign never does.
// Twelve, two per risk of DESIGN 7.1 (stage 20 adds the schism): revolt (vassal_revolt, peasant_war), invasion
// (invasion, nomad_raid), succession crisis (succession_crisis, regency_council), disaster
// (disaster, great_famine), decline (unrest -> decline), rise (prosperity -> golden_age);
// plus monastery_vows and monastery_late: a king takes the vows and the reign ends.
// Stage 30: faith_persecution, the price of the law of one faith.
// The long ones start an outcome with SpawnEvent; it fires only if its `when` still holds.
// `weight_bonus` raises the weight while its predicate holds: risks grow with a bad state.
// Thresholds follow what the simulation reaches (stage 9 probe over 200 dynasties):
// stability stays within 30..70, people's loyalty within 35..65, legitimacy goes up to 100.
// Choices are made by sim::AutoChooser and mark nothing, so they carry no `hint`; their
// cause_tags still have one in hints.ron (data_lint). Texts never name the ruler's sex and
// keep `{ruler}` and `{neighbour}` in the nominative: names do not decline.
[
    // ------------------------------------------------------------------ revolt
    (
        // A vassal nearing the crown's strength in his land: ratio = strength times provinces
        // held over the crown power there (World::vassal_ratio). From a quarter of the crown's
        // strength on, the weight grows along vassal_weight (ratio, weight), linear between points.
        id: "vassal_revolt",
        title: "Мятеж дома {vassal}",
        text: "Дом {vassal} поднимает мятеж в {province.пр}. Королевских сборщиков выставили за ворота, герб короны сбили с башни, и вассал больше не присягает трону.",
        texts: [
            "В {province.пр} мятеж: дом {vassal} запер замки, созвал своих рыцарей и объявил, что отныне сам себе господин.",
            "Гонец из {province.род} загнал двух коней. Дом {vassal} отказался присягать короне, а его люди уже жгут королевские житницы.",
        ],
        texts_when: [
            (AtWar, "Пока королевское войско воюет на рубеже, дом {vassal} поднимает мятеж в {province.пр}: удар в спину, рассчитанный до дня."),
        ],
        recalled: "мятеж вассала",
        when: ProvinceWhere((holder: Vassal, vassal_ratio_above: 0.25)),
        weight: 1,
        vassal_weight: [(0.25, 0), (0.5, 12), (1, 28), (2, 60), (4, 120)],
        weight_bonus: [
            (AxisBelow("loyalty_nobles", 40), 4),
            (AxisBelow("stability", 35), 3),
            (AxisBelow("legitimacy", 35), 3),
            (ProvinceWhere((holder: Vassal, loyalty_below: 40)), 3),
        ],
        once: false,
        cooldown_years: 8,
        importance: 5,
        target: RandomProvince((holder: Vassal, vassal_ratio_above: 0.25)),
        choices: [
            (
                text: "Подавить мятеж силой оружия",
                effects: [
                    Chance((
                        percent: 15,
                        axes: [("army", 0.4)],
                        then: [Axis("army", -15), Province(EventTarget, Loyalty, -10), Axis("loyalty_nobles", -5)],
                        otherwise: [Axis("army", -20), Secede(EventTarget), SetFlag("vassal_seceded")],
                    )),
                ],
                cause_tag: "revolt_crushed",
                told: "Дом {vassal} поднял мятеж в {province.пр} и отказался присягать короне, и {ruler} {ruler:двинул|двинула} на мятежников войско.",
                retold: [
                    "На мятежный {province.вин} пошло королевское войско с осадными машинами, и над замками дома {vassal} снова поднимали знамёна, только уже не их.",
                    "Мятеж дома {vassal} решали мечом: {ruler} сам{ruler:|а} {ruler:повёл|повела} рать в {province.вин}, и по дороге горели баронские усадьбы.",
                    "Против дома {vassal} выступила королевская рать, и весь тот год в {province.пр} не утихали стычки у бродов и стен.",
                    "Мятежный дом {vassal} осадили в собственном замке, и к зиме его глава сам вышел к воротам с верёвкой на шее.",
                ],
            ),
            (
                text: "Признать независимость мятежного дома",
                effects: [Secede(EventTarget), SetFlag("vassal_seceded"), Axis("prestige", -10), Axis("legitimacy", -5)],
                cause_tag: "revolt_conceded",
                told: "Дом {vassal} поднял мятеж в {province.пр}, и {ruler} {ruler:признал|признала} его независимость.",
                retold: [
                    "Мятежному дому {vassal} оставили его землю без присяги, и на картах королевства у {province.род} появилась новая граница.",
                    "Корона отпустила мятежный дом {vassal} вместе с его землёй, не обнажив меча, и при дворе это называли то мудростью, то позором.",
                    "С мятежным домом {vassal} не стали воевать: его замки отпустили из-под руки короны, и гербы дома скоро встали на межевых столбах вместо королевских.",
                    "{ruler} не {ruler:стал|стала} проливать кровь из-за {province.род} и {ruler:отпустил|отпустила} дом {vassal} с миром; летописец записал это без похвалы.",
                ],
            ),
            (
                text: "Откупиться золотом и титулами",
                effects: [Axis("treasury", -80), Axis("loyalty_nobles", 5), Province(EventTarget, Loyalty, 15)],
                cause_tag: "revolt_bought",
                told: "Дом {vassal} поднял мятеж в {province.пр}, но корона откупилась от него золотом и титулами.",
                retold: [
                    "Мятежному дому {vassal} привезли сундуки с монетой и грамоту на новый титул, и знамёна мятежа тихо сняли со стен.",
                    "Бунт дома {vassal} закончился пиром: вассал получил золото, звание и место у трона, а казна осталась с пустыми углами.",
                    "Мятеж дома {vassal} погасили серебром: вассалу дали новый титул и право чеканить свою монету, и он присягнул снова, глядя в сторону.",
                    "От дома {vassal} откупились, как от ростовщика, золотом, землёй и обещаниями, и прочие бароны поняли, что мятеж бывает выгоден.",
                ],
            ),
        ],
    ),
    (
        id: "peasant_war",
        title: "Мужицкая война",
        text: "Поднимаются сёла. Горят барские усадьбы, сборщиков подати вешают на воротах, и мужицкое войско с косами и цепами уже вошло в {province.вин}.",
        texts: [
            "Мужики больше не просят, они берут: в {province.пр} разграблены амбары, бароны бегут в города, а над лесом стоит дым от сожжённых усадеб.",
            "Из деревни в деревню скачут гонцы с горящей лучиной. Мужицкая война докатилась до {province.род}, и вожаки её зовут себя народными воеводами.",
        ],
        recalled: "мужицкая война",
        when: AxisBelow("loyalty_people", 45),
        weight: 1,
        // Stage 20: the catastrophe of П1 (oppression), more likely the more split the
        // estates; the peasants' victory or concessions ease it.
        weight_bonus: [
            (AxisBelow("loyalty_people", 35), 3),
            (AxisBelow("stability", 35), 2),
            (ProvinceWhere((holder: Crown, loyalty_below: 30)), 2),
            (AxisAbove("strata", 60), 3),
            (AxisAbove("strata", 70), 3),
        ],
        once: false,
        cooldown_years: 15,
        importance: 4,
        target: RandomProvince((holder: Crown, capital: false)),
        choices: [
            (
                text: "Бросить на мятежников королевское войско",
                effects: [
                    Chance((
                        percent: 50,
                        axes: [("army", 0.3)],
                        then: [Axis("army", -10), Province(EventTarget, Population, -1500), Province(EventTarget, Loyalty, -10), Axis("loyalty_people", -5)],
                        otherwise: [Axis("army", -20), Axis("stability", -10), Province(EventTarget, Income, -2), Axis("strata", -15), Axis("serfdom", -10)],
                    )),
                ],
                cause_tag: "peasants_crushed",
                told: "Поднялись сёла, запылали усадьбы, и мужицкая война докатилась до {province.род}. {ruler} {ruler:бросил|бросила} на мятежников войско.",
                retold: [
                    "Рыцарская конница прошла по {province.дат}, вытаптывая мужицкие таборы, и вдоль дорог потом долго стояли виселицы.",
                    "Против мужицкого войска выступили королевские латники, и косы против копий продержались недолго, а в деревнях ещё долго пели о павших.",
                    "Мужицкое войско у {province.род} рассеяли за один день: латники рубили бегущих до темноты, а вожаков колесовали на торгу.",
                    "{ruler} не {ruler:стал|стала} говорить с бунтовщиками: в {province.вин} вошли наёмные роты, и сожжённые усадьбы отстраивали руками тех, кто их жёг.",
                ],
            ),
            (
                text: "Простить недоимки и убавить подать",
                effects: [Axis("treasury", -60), Axis("income", -1), Axis("loyalty_people", 12), Province(EventTarget, Loyalty, 15), Axis("legitimacy", -3), Axis("strata", -5), Axis("serfdom", -5)],
                cause_tag: "peasants_appeased",
                told: "Мужицкая война докатилась до {province.род}, и {ruler} {ruler:простил|простила} недоимки и {ruler:убавил|убавила} подать.",
                retold: [
                    "Королевские глашатаи объехали мятежные сёла с грамотой о прощении недоимок, и мужики, поворчав, стали расходиться по домам.",
                    "Мужицкую войну потушили не войском, а милостью: старые долги сожгли на площади, подать убавили, и косы вернулись к сенокосу.",
                    "Мятежным сёлам {province.род} простили долги и сбавили подать, и вожаки бунта вернулись к сохе, а бароны ещё долго ворчали о потакании черни.",
                    "Корона уступила мужикам: недоимки списали, подать убавили, и в {province.пр} снова запахали брошенные поля.",
                ],
            ),
            (
                text: "Выдать мятежникам ненавистных мытарей",
                effects: [Axis("loyalty_people", 6), Axis("bureaucracy", -5), Axis("loyalty_nobles", -3), Axis("stability", -3)],
                cause_tag: "peasants_scapegoat",
                told: "Мужицкая война докатилась до {province.род}, и корона выдала мятежникам ненавистных мытарей.",
                retold: [
                    "Чтобы унять мужицкую войну, бунтовщикам отдали самых лютых сборщиков подати, и с ними расправились у ворот, как с собаками.",
                    "Мытарей, которых проклинали по всем деревням, вывели к мятежникам связанными, и мужицкое войско разошлось, а в казённой палате опустели столы.",
                    "Корона откупилась от мужицкой войны чужими головами: мытарей отдали толпе, и до самой зимы некому было собирать подать в {province.пр}.",
                    "Ненавистных сборщиков выдали мятежникам на расправу, и мужики разошлись, но с тех пор в мытари шли только самые отчаянные.",
                ],
            ),
        ],
    ),
    (
        // Stage 28: a crown land the crown cannot hold (beyond its room, rules.ron
        // crown_capacity, it loses loyalty every year) rises against it. The same rule for every
        // kingdom: the land is held by arms, given to a house of its own as a fief, or let go
        // with a house of its own (Grant, then Secede, as the schism does).
        id: "province_breakaway",
        title: "Отпадение края",
        text: "В {province.пр} не признают королевских наместников: подать не платят, гонцов из столицы гонят за ворота, а местная знать уже выбрала себе господина.",
        texts: [
            "Из {province.род} приходят дурные вести: тамошние бароны заперли замки, сборщиков подати держат в погребах, а на сходах кричат, что столица слишком далеко.",
            "В {province.пр} отложились от короны без единого выстрела: наместник бежал, ключи от ворот отдали местному роду, и люди присягают ему.",
        ],
        recalled: "отпадение края",
        when: ProvinceWhere((holder: Crown, loyalty_below: 20, capital: false)),
        weight: 4,
        weight_bonus: [
            (AxisBelow("stability", 30), 12),
            (AxisBelow("stability", 15), 20),
            (AxisBelow("army", 50), 8),
            (ProvinceWhere((holder: Crown, loyalty_below: 5, capital: false)), 40),
        ],
        once: false,
        cooldown_years: 3,
        importance: 5,
        target: RandomProvince((holder: Crown, loyalty_below: 20, capital: false)),
        choices: [
            (
                text: "Послать войско на усмирение",
                effects: [
                    Chance((
                        percent: 20,
                        axes: [("army", 0.4)],
                        then: [Axis("army", -15), Province(EventTarget, Loyalty, 25)],
                        otherwise: [Axis("army", -20), Grant(EventTarget), Secede(EventTarget), SetFlag("vassal_seceded")],
                    )),
                ],
                cause_tag: "breakaway_crushed",
                told: "В {province.пр} отложились от короны, и {ruler} {ruler:послал|послала} туда войско.",
                retold: [
                    "На отпавший край двинулись королевские полки, и до осени в {province.пр} горели баронские усадьбы.",
                    "В {province.вин} вошло королевское войско, и непокорных старост вешали на воротах их же сёл.",
                    "Мятежный край усмиряли огнём и железом: {ruler} не {ruler:стал|стала} слушать тамошних послов.",
                ],
            ),
            (
                text: "Отдать край местному роду в удел",
                effects: [Grant(EventTarget), Province(EventTarget, Loyalty, 30), Axis("prestige", -3)],
                cause_tag: "breakaway_granted",
                told: "В {province.пр} отложились от короны, и {ruler} {ruler:отдал|отдала} край местному роду в удел.",
                retold: [
                    "Отпавший край не стали брать мечом: местный род получил его в удел и присягнул короне, хотя и сквозь зубы.",
                    "{ruler} {ruler:признал|признала} над {province.тв} власть местного рода, и край вернулся под корону уделом.",
                    "Тамошним баронам выдали грамоту на удел, и в {province.пр} снова присягнули короне, но подать отныне собирали свои.",
                ],
            ),
            (
                text: "Отпустить край",
                effects: [Grant(EventTarget), Secede(EventTarget), SetFlag("vassal_seceded"), Axis("prestige", -10), Axis("legitimacy", -3)],
                cause_tag: "breakaway_released",
                told: "В {province.пр} отложились от короны, и {ruler} {ruler:отпустил|отпустила} край без боя.",
                retold: [
                    "За отпавший край не стали воевать: межевые столбы перенесли, и в {province.пр} зажили под своим государем.",
                    "{ruler} не {ruler:удержал|удержала} {province.вин} и не {ruler:стал|стала} пытаться, и при дворе об этом говорили шёпотом.",
                    "Отпавший край отпустили с миром, и вскоре над тамошними замками подняли чужой герб.",
                ],
            ),
        ],
    ),
    // ---------------------------------------------------------------- invasion
    (
        // Offered by a neighbour in the Expand stance (rules.ron neighbour_ai), never drawn
        // from the pool; leads into the war chain of events/war.ron.
        id: "invasion",
        title: "Вторжение",
        text: "Вражья рать переходит рубеж. Ведёт её {neighbour}, порубежные крепости зажигают сигнальные огни, и гонцы скачут к столице, загоняя коней.",
        texts: [
            "На рассвете за рекой показались чужие знамёна. {neighbour} идёт войной без объявления, сёла пустеют, а люди уходят в леса со скотом.",
            "Дозорные с порубежья доносят: рать {neighbour.род} уже на нашей земле, обозы её тянутся до горизонта, а впереди идут поджигатели.",
        ],
        recalled: "вторжение",
        when: Not(AtWar),
        weight: 0,
        weight_bonus: [(AxisBelow("army", 30), 30), (AxisBelow("stability", 30), 20)],
        once: false,
        cooldown_years: 5,
        importance: 5,
        target: Neighbour,
        choices: [
            (
                text: "Выйти навстречу врагу с войском",
                effects: [StartWar(EventTarget), Axis("prestige", 2)],
                cause_tag: "invasion_met",
                told: "Рать {neighbour.род} перешла рубеж, и {ruler} {ruler:вышел|вышла} ей навстречу.",
                retold: [
                    "Навстречу вторжению {neighbour.род} выступило королевское войско, и над порубежными полями снова запели трубы.",
                    "Враг перешёл рубеж, и {ruler} {ruler:поднял|подняла} знамя и {ruler:повёл|повела} рать навстречу, не дожидаясь, пока чужаки дойдут до столицы.",
                    "Рать {neighbour.род} не успела пройти и трёх переходов, как наткнулась на королевское войско, вставшее поперёк дороги.",
                    "Едва чужие знамёна показались за рекой, {ruler} {ruler:двинул|двинула} навстречу всех, кого успели собрать, и порубежье снова стало полем боя.",
                ],
            ),
            (
                text: "Откупиться от вторжения данью",
                effects: [Tribute(-80), Relation(EventTarget, 15), Axis("prestige", -5)],
                cause_tag: "invasion_bought_off",
                told: "Рать {neighbour.род} перешла рубеж, и корона откупилась от вторжения.",
                retold: [
                    "К шатру вражеского воеводы отвезли обоз с серебром, и рать {neighbour.род} ушла за рубеж, не дойдя до наших стен.",
                    "Вторжение кончилось данью: {neighbour} взял{neighbour:|а} серебро и увёл{neighbour:|а} войско, а при дворе стыдливо молчали о цене мира.",
                    "Вторжение {neighbour.род} остановили серебром: воеводам заплатили за каждый день, что они не пойдут дальше, и они ушли.",
                    "Корона не стала драться и выкупила мир; казначей отсчитывал монеты при послах {neighbour.род}, а знать смотрела в пол.",
                ],
            ),
            (
                text: "Уступить врагу порубежную землю",
                effects: [TransferProvince(OwnBorder, Foreign(EventTarget)), Relation(EventTarget, 20), Axis("legitimacy", -10)],
                cause_tag: "invasion_yielded",
                told: "Рать {neighbour.род} перешла рубеж, и {ruler} {ruler:уступил|уступила} врагу порубежную землю.",
                retold: [
                    "Чтобы остановить вторжение, {neighbour.дат} отдали порубежный край, и новые межевые столбы поставили уже без нас.",
                    "Порубежная земля ушла к врагу по договору, подписанному в чужом шатре, и тамошние люди проснулись подданными {neighbour.род}.",
                    "Порубежный край отдали {neighbour.дат} без боя, и тамошние церкви в то же воскресенье молились уже за чужого государя.",
                    "Вторжение кончилось уступкой: {ruler} {ruler:отписал|отписала} врагу порубежную землю, и межевые камни выкапывали и переносили всю осень.",
                ],
            ),
        ],
    ),
    (
        // Nomads from beyond the map: no neighbour, the army alone decides.
        id: "nomad_raid",
        title: "Набег из степи",
        text: "Из степи приходит конная орда. Кочевники жгут сёла в {province.пр}, угоняют скот и уводят людей в полон на арканах.",
        texts: [
            "Над степью встала пыль до неба: идёт орда. В {province.пр} горят хутора, и беглецы рассказывают о всадниках, которые стреляют на скаку.",
            "Степняки налетели на {province.вин} как буря. Ни одна деревня не успела запереться, и дороги усеяны брошенными телегами.",
        ],
        recalled: "набег степняков",
        when: All([]),
        weight: 1,
        weight_bonus: [(AxisBelow("army", 30), 3), (AxisBelow("stability", 30), 1)],
        once: false,
        cooldown_years: 20,
        importance: 4,
        target: RandomProvince((holder: Crown)),
        choices: [
            (
                text: "Встретить орду в открытом поле",
                effects: [
                    Chance((
                        percent: 35,
                        axes: [("army", 0.4)],
                        then: [Axis("army", -10), Axis("prestige", 10)],
                        otherwise: [Axis("army", -25), Province(EventTarget, Population, -2000), Axis("prestige", -5), Axis("loyalty_nobles", -10)],
                    )),
                ],
                cause_tag: "nomads_fought",
                told: "Конная орда из степи жгла сёла в {province.пр}, и {ruler} {ruler:вышел|вышла} навстречу кочевникам в поле.",
                retold: [
                    "Против степной конницы королевское войско вышло в чистое поле, и пыль той сечи видели за десять вёрст.",
                    "Орда, разорявшая {province.вин}, встретила королевскую рать у переправы, и долго потом в тех местах находили наконечники стрел.",
                    "{ruler} сам{ruler:|а} {ruler:повёл|повела} конницу на кочевников и {ruler:гнал|гнала} их до самой степи, и в {province.пр} ещё долго показывали курган над павшими.",
                    "Королевская рать перехватила орду с добычей у брода, отбила полон и скот, и люди из {province.род} вернулись домой на своих же телегах.",
                ],
            ),
            (
                text: "Откупиться от орды серебром",
                effects: [Axis("treasury", -100), Axis("prestige", -5)],
                cause_tag: "nomads_paid",
                told: "Конная орда из степи пришла в {province.вин}, и корона откупилась от неё серебром.",
                retold: [
                    "Степному хану отправили бочонки с серебром и дорогие шелка, и орда повернула коней обратно в степь.",
                    "От кочевников откупились, как откупаются от грозы: серебро ушло в степь, а сёла в {province.пр} уцелели.",
                    "Орде заплатили выкуп за {province.вин}, и кочевники ушли, а в казне потом не досчитались двух годовых сборов.",
                    "Хану послали серебро, соболей и коня под золотым седлом, и степь притихла, но все знали, что ненадолго.",
                ],
            ),
            (
                text: "Отсидеться за крепкими стенами",
                effects: [Province(EventTarget, Population, -2500), Province(EventTarget, Income, -2), Axis("loyalty_people", -4)],
                cause_tag: "nomads_waited",
                told: "Кочевники жгли сёла в {province.пр} и уводили людей в полон, а войско отсиживалось за стенами.",
                retold: [
                    "Пока орда хозяйничала в {province.пр}, королевские люди смотрели на зарево со стен и не открывали ворот.",
                    "Войско не вышло против степняков, и они ушли сами, когда грабить стало нечего, угнав с собой полкрая.",
                    "Кочевники три недели хозяйничали в {province.пр}, а королевские ворота так и не открылись; там потом говорили, что у короны нет ни войска, ни совести.",
                    "Орду пересидели за стенами, как пересиживают ливень, и когда она ушла, от сёл {province.род} остались печные трубы.",
                ],
            ),
        ],
    ),
    // ------------------------------------------------------- succession crisis
    (
        // A contested succession (claim below the law's crisis_claim, or an abdication), a child
        // on the throne (sim.regency_flag), or rival heirs under a weak crown or a house of
        // little fame (prestige: the founder's wars leave it for generations, stage 17b), or a
        // split society (strata above 65: the poor and the rich back rival heirs, stage 19).
        id: "succession_crisis",
        title: "Смута",
        text: "На престоле {ruler}, но присягнули не все. Претенденты собирают сторонников по замкам, знать выжидает, а в столице чеканят монету без имени государя.",
        texts: [
            "Корона досталась {ruler.дат}, но во дворце тесно от чужих гербов. Двое родичей заявили права на трон, и каждый клянётся, что истинный наследник он.",
            "Над столицей висит смута: на воротах собора кто-то прибил грамоту, где {ruler} назван{ruler:|а} самозванцем, а бароны не спешат её срывать.",
        ],
        recalled: "смута",
        when: Any([Flag("succession_contested"), Flag("regency"), All([HeirCount(2, 99), AxisBelow("legitimacy", 30)]), All([HeirCount(2, 99), AxisBelow("prestige", 50)]), All([HeirCount(2, 99), AxisAbove("strata", 65)])]),
        weight: 2,
        weight_bonus: [(Flag("succession_contested"), 30), (Flag("regency"), 60), (AxisBelow("legitimacy", 20), 5)],
        once: false,
        cooldown_years: 10,
        importance: 5,
        target: None,
        choices: [
            (
                text: "Подавить претендентов силой",
                effects: [
                    ClearFlag("succession_contested"),
                    Chance((
                        percent: 20,
                        axes: [("army", 1.2)],
                        then: [Axis("legitimacy", 10), Axis("army", -15)],
                        otherwise: [SetFlag("usurped")],
                    )),
                ],
                cause_tag: "crisis_crushed",
                told: "Не все присягнули {ruler.дат}, и {ruler:новый король взялся|новая королева взялась} подавлять претендентов силой.",
                retold: [
                    "Претендентов на трон ловили по замкам и монастырям, и одного из них привезли в столицу в цепях, а другой бежал за рубеж.",
                    "Смуту гасили мечом: {ruler} не {ruler:вёл|вела} переговоров с соперниками, и их сторонники быстро научились молчать.",
                    "Против соперников {ruler} {ruler:бросил|бросила} войско, и в тот год на плахе в столице сложили головы двое родичей короны и их советники.",
                    "Смута кончилась осадой последнего замка, где засел претендент; его постригли в монахи и увезли в дальнюю обитель, и больше о нём не слышали.",
                ],
            ),
            (
                text: "Созвать собор и венчаться заново",
                effects: [ClearFlag("succession_contested"), Axis("treasury", -60), Axis("legitimacy", 5), Axis("loyalty_church", 5)],
                cause_tag: "crisis_council",
                told: "Не все присягнули {ruler.дат}, и {ruler:король созвал|королева созвала} собор, чтобы венчаться на царство заново.",
                retold: [
                    "Чтобы унять смуту, в соборе отслужили второе венчание, и перед лицом епископов {ruler} вновь {ruler:принял|приняла} помазание.",
                    "Собор всех сословий подтвердил права {ruler.род} на корону, и претенденты лишились главного довода.",
                    "{ruler} {ruler:созвал|созвала} собор, и епископы вторично помазали {ruler:его|её} на царство при всех баронах; кто не приехал, тот сам назвал себя врагом.",
                    "Смуту утишили не мечом, а собором: под колокольный звон {ruler} второй раз {ruler:принёс|принесла} коронационную клятву, и знать целовала крест.",
                ],
            ),
            (
                text: "Купить верность знати уступками",
                effects: [ClearFlag("succession_contested"), Axis("loyalty_nobles", 10), Axis("legitimacy", -10), Axis("stability", -10)],
                cause_tag: "crisis_concessions",
                told: "Не все присягнули {ruler.дат}, и {ruler:король купил|королева купила} верность знати щедрыми уступками.",
                retold: [
                    "Верность сомневающихся баронов купили землями и вольностями, и смута стихла, а власть короны стала тоньше пергамента.",
                    "Присягу знати выторговали ценой коронных угодий, и бароны клялись охотно, пересчитывая полученное.",
                    "За присягу бароны взяли дорого: кто лес, кто мельницы, кто право суда, и смута рассосалась, оставив корону беднее.",
                    "{ruler} {ruler:раздавал|раздавала} грамоты на вольности, пока не кончились сомневающиеся, и смута улеглась на пергаменте.",
                ],
            ),
        ],
    ),
    (
        // A child on the throne (sim.regency_flag until sim.regency_age).
        id: "regency_council",
        title: "Регентство",
        text: "На престоле дитя, {ruler}. Именем ребёнка правит регентский совет, и каждый в нём тянет казну к себе, а печать государства лежит в шкатулке у того, кто встал раньше.",
        texts: [
            "{ruler} ещё играет в деревянных солдатиков, а за дверью детской решаются дела королевства. Регенты спорят, кто будет держать руку маленького государя на указах.",
            "Совет опекунов собирается каждый день и каждый день ссорится. Бароны требуют опеки себе, епископ себе, а казна худеет с каждой неделей.",
        ],
        when: Flag("regency"),
        weight: 20,
        weight_bonus: [(AxisBelow("legitimacy", 40), 3), (AxisBelow("loyalty_nobles", 40), 2)],
        once: false,
        cooldown_years: 8,
        importance: 4,
        target: None,
        choices: [
            (
                text: "Вручить всю власть одному регенту",
                effects: [
                    Chance((
                        percent: 50,
                        axes: [("legitimacy", 0.2)],
                        then: [Axis("bureaucracy", 5), Axis("stability", 3), ClearFlag("church_regency")],
                        otherwise: [SetFlag("usurped")],
                    )),
                ],
                cause_tag: "regency_single",
                told: "Именем {ruler:малолетнего короля|малолетней королевы} правил регентский совет, и всю власть вручили одному регенту.",
                retold: [
                    "Регентский совет распустили, и всю власть над малолетним государем взял один человек с тяжёлой рукой и долгой памятью.",
                    "Опеку над {ruler:маленьким королём|маленькой королевой} отдали одному регенту, и при дворе быстро поняли, кому теперь кланяться.",
                ],
            ),
            (
                text: "Поделить опеку между баронами",
                effects: [Axis("loyalty_nobles", 6), Axis("treasury", -50), Axis("bureaucracy", -4), ClearFlag("church_regency")],
                cause_tag: "regency_nobles",
                told: "Опеку над {ruler:малолетним королём|малолетней королевой} поделили между баронами, и каждый тянул казну к себе.",
                retold: [
                    "Регентство поделили по кускам: один барон взял войско, другой казну, третий печать, и всё королевство поделилось вслед за ними.",
                    "Бароны правили за {ruler:малолетнего короля|малолетнюю королеву} всем советом, и в годы опеки коронные земли таяли, как снег в марте.",
                ],
            ),
            (
                text: "Отдать опеку церкви",
                effects: [Axis("loyalty_church", 6), Axis("loyalty_nobles", -4), Axis("legitimacy", 3), SetFlag("church_regency")],
                cause_tag: "regency_church",
                told: "Опеку над {ruler:малолетним королём|малолетней королевой} отдали церкви.",
                retold: [
                    "Малолетний государь рос под присмотром епископа, учил псалтырь раньше, чем меч, и бароны ворчали, что корону воспитывают в рясе.",
                    "Регентство поручили клиру, и во дворце запахло ладаном, а в совете вместо баронов сидели аббаты.",
                ],
            ),
        ],
    ),
    (
        // The child king in the church's care (church_regency, set by regency_council, gone
        // with the reign: sim.reign_flags) may take the vows in his first years of age
        // (sim.regency_age 16 to 20): the reign ends, the next heir is crowned. Both choices
        // end it. Stage 15: child kings are rarer (children born before a coronation), so
        // the window is five years and the church's loyalty above 50, not one year above 60.
        id: "monastery_vows",
        title: "Король ушёл в монастырь",
        text: "Монахи-опекуны воспитали государя по себе: едва войдя в возраст, {ruler} слагает корону и уходит в обитель. Престол переходит к наследнику.",
        texts: [
            "{ruler} вырос{ruler:|ла} среди монахов и молитв, и мирская власть {ruler:ему|ей} в тягость. В день совершеннолетия {ruler} просит отпустить {ruler:его|её} в монастырь.",
            "Двор в смятении: {ruler:юный государь|юная государыня} отказывается от трона. {ruler} говорит, что {ruler:видел|видела} во сне свою келью и что место {ruler:его|её} там, а престол пусть примет наследник.",
        ],
        when: All([Flag("church_regency"), RulerAge(16, 20), AxisAbove("loyalty_church", 50), HeirCount(1, 99)]),
        weight: 10,
        once: false,
        cooldown_years: 0,
        importance: 5,
        target: None,
        choices: [
            (
                text: "Отпустить с почётом и вкладом в обитель",
                effects: [ClearFlag("church_regency"), Axis("treasury", -60), Axis("loyalty_church", 5), RulerDies("monastery")],
                cause_tag: "vows_endowed",
                told: "{ruler} {ruler:сложил|сложила} корону, едва войдя в возраст, и {ruler:ушёл|ушла} в обитель, куда корона сделала богатый вклад.",
                retold: [
                    "Юного государя проводили в монастырь крестным ходом, а обитель получила в дар серебро, земли и золотую чашу.",
                    "{ruler} {ruler:сменил|сменила} корону на клобук, и в монастырских книгах записали богатый вклад от королевского дома.",
                ],
            ),
            (
                text: "Отпустить тихо, без огласки",
                effects: [ClearFlag("church_regency"), Axis("legitimacy", -5), RulerDies("monastery")],
                cause_tag: "vows_quiet",
                told: "{ruler}, {ruler:воспитанный|воспитанная} монахами, {ruler:сложил|сложила} корону и тихо {ruler:ушёл|ушла} в обитель.",
                retold: [
                    "Ночью от дворца отъехала закрытая повозка, и наутро двор узнал, что престол пуст, а юный государь уже в монастыре.",
                    "Отречение не объявляли с колоколами: {ruler} просто исчез{ruler:|ла} из дворца, и {ruler:о нём|о ней} говорили вполголоса.",
                ],
            ),
        ],
    ),
    (
        // A grown king may take the vows too, rarer still, the more likely the more loyal the
        // church, regency or not.
        id: "monastery_late",
        title: "Король ушёл в монастырь",
        text: "{ruler} давно больше молится, чем правит, и наконец слагает корону и уходит в обитель. Престол переходит к наследнику.",
        texts: [
            "Совет ждёт государя третий день, а {ruler} стоит на коленях в часовне. Наконец объявлено: корона снята, впереди монастырская келья.",
            "{ruler} раздал{ruler:|а} перстни и шубы нищим и велел{ruler:|а} седлать коня в дальнюю обитель. Двор понимает, что это навсегда.",
        ],
