// Symptoms of the loops of the influence graph (stage 20, docs/design/hidden-state.html,
// section 4): events marked «Знамение» (`omen`) that come before a catastrophe. They fire in
// the reign and in the simulation, which tells them in the chronicle whatever their
// importance. rules.ron `symptoms` says which catastrophe each one foretells. Three more
// live in reign.ron: «Мятежный староста» (П1), «Ересь» and «Секта растёт» (П3).
[
    (
        // П1, oppression: the estates have split.
        id: "omen_runaways",
        title: "Беглые крестьяне",
        text: "Из сёл земли {province} бегут крестьяне: уходят в леса, в вольные города, за рубеж. Господа шлют ко двору жалобы.",
        when: AxisAbove("strata", 55),
        weight: 4,
        once: false,
        cooldown_years: 10,
        importance: 3,
        sign: Bad,
        omen: true,
        target: RandomProvince((holder: Crown)),
        choices: [
            (
                text: "Ловить беглых и возвращать господам",
                effects: [Axis("serfdom", 3), Axis("loyalty_nobles", 3), Axis("loyalty_people", -3)],
                cause_tag: "runaways_returned",
                hint: "Пойманный беглец бежит снова, и не один.",
            ),
            (
                text: "Посадить беглых на пустошах короны",
                effects: [Axis("treasury", -30), Axis("mobility", 3), Province(EventTarget, Loyalty, 3)],
                cause_tag: "runaways_settled",
                hint: "Вольный поселенец пашет за двоих.",
            ),
            (
                text: "Не мешать: пусть уходят",
                effects: [Axis("mobility", 2), Axis("loyalty_nobles", -3), Province(EventTarget, Population, -1000), Province(EventTarget, Income, -1)],
                cause_tag: "runaways_let_go",
                hint: "Ушедшие не платят податей, но и не бунтуют.",
            ),
        ],
    ),
    (
        // П1, oppression: no way out of one's estate. The villages empty, and the corvée
        // with them: the node drops off its bound (stage 20, the serfdom trap discharges).
        id: "omen_empty_villages",
        title: "Пустеют сёла",
        text: "В земле {province} пустеют сёла: молодым некуда податься, и они уходят кто куда. Пашни зарастают лесом.",
        when: AxisBelow("mobility", 25),
        weight: 4,
        once: false,
        cooldown_years: 10,
        importance: 3,
        sign: Bad,
        omen: true,
        target: RandomProvince((holder: Crown)),
        choices: [
            (
                text: "Простить барщину пустеющим сёлам",
                effects: [Axis("serfdom", -15), Axis("loyalty_nobles", -4), Province(EventTarget, Population, -500)],
                cause_tag: "villages_corvee_forgiven",
                hint: "Прощённая барщина вернула пахарей на землю.",
            ),
            (
                text: "Звать поселенцев из-за рубежа",
                effects: [Axis("treasury", -40), Axis("serfdom", -10), Axis("mobility", 3), Province(EventTarget, Population, -500)],
                cause_tag: "villages_settlers",
                hint: "Чужие поселенцы оживили пустые сёла.",
            ),
            (
                text: "Заставить оставшихся пахать за ушедших",
                effects: [Axis("serfdom", -10), Axis("loyalty_people", -5), Province(EventTarget, Population, -1500)],
                cause_tag: "villages_squeezed",
                hint: "Тех, кто остался, задавили чужой барщиной.",
            ),
        ],
    ),
    (
        // П2, the corvée: barons pleased and the peasants bound press for more.
        id: "omen_search_decree",
        title: "Указ о сыске",
        text: "Бароны бьют челом: крестьяне бегут от господ, и знать просит указ о бессрочном сыске беглых.",
        when: All([AxisAbove("loyalty_nobles", 65), AxisAbove("serfdom", 45)]),
        weight: 4,
        once: false,
        cooldown_years: 12,
        importance: 3,
        sign: Bad,
        omen: true,
        target: None,
        choices: [
            (
                text: "Издать указ о бессрочном сыске",
                effects: [Axis("serfdom", 6), Axis("loyalty_nobles", 6), Axis("loyalty_people", -5)],
                cause_tag: "search_decreed",
                hint: "Указ о сыске прикрепил крестьян крепче цепи.",
            ),
            (
                text: "Издать указ с урочными летами сыска",
                effects: [Axis("serfdom", 3), Axis("loyalty_nobles", 3), Axis("loyalty_people", -2)],
                cause_tag: "search_limited",
                hint: "Урочные лета оставили беглым надежду.",
            ),
            (
                text: "Отказать баронам",
                effects: [Axis("loyalty_nobles", -8), Axis("legitimacy", -2)],
                cause_tag: "search_refused",
                hint: "Отказ в сыске знать помнила долго.",
            ),
        ],
    ),
    (
        // С1 broken, bread and price: the barns low and no trade to fill them.
        id: "omen_dear_bread",
        title: "Дороговизна хлеба",
        text: "Хлеб на торгу подорожал втрое. Перекупщики придерживают зерно, у лавок ропщут бедняки.",
        when: AxisBelow("grain", 45),
        weight: 5,
        once: false,
        cooldown_years: 6,
        importance: 3,
        sign: Bad,
        omen: true,
        target: None,
        choices: [
            (
                text: "Запретить вывоз хлеба",
                effects: [Axis("grain", 5), Axis("trade", -6)],
                cause_tag: "bread_export_banned",
                hint: "Запрет удержал хлеб, но отпугнул купцов.",
            ),
            (
                text: "Продать зерно из казённых запасов",
                effects: [Axis("treasury", -40), Axis("grain", 10)],
                cause_tag: "bread_sold",
                hint: "Казённое зерно сбило цену.",
            ),
            (
                text: "Положиться на купцов",
                effects: [Axis("trade", 4), Axis("loyalty_people", -4)],
                cause_tag: "bread_merchants",
                hint: "Купцы привезли хлеб, но бедным он был не по карману.",
            ),
        ],
    ),
]
