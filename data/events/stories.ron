                retold: [
                    "Худые лета, когда пришли {prev_event} и {then_event}, научили корону запасливости: в каждом городе заложили казённую житницу и засыпали её до верху.",
                    "После того как прошли {prev_event} и {then_event}, королевство стало запасать хлеб впрок, и казна платила за амбары не торгуясь.",
                ],
            ),
            (
                text: "Взять хлебную торговлю под надзор",
                effects: [Axis("trade", -3), Axis("grain", 5), Axis("loyalty_people", 3)],
                cause_tag: "lean_trade_watched",
                hint: "Купцы прячут зерно хуже, когда на них смотрят.",
                told: "Худые лета, когда случились {prev_event} и {then_event}, заставили корону взять хлебную торговлю под надзор.",
                retold: [
                    "После того как прошли {prev_event} и {then_event}, королевские приставы стояли у каждого хлебного склада, и купцы, проклиная надзор, продавали зерно по совести.",
                    "Помня {prev_year} год, хлеботорговцам велели открыть амбары и продавать по казённой цене, и голодный год прошёл без голодных бунтов.",
                ],
            ),
            (
                text: "Терпеть и ждать урожая",
                effects: [Axis("loyalty_people", -5), Axis("grain", -5)],
                cause_tag: "lean_endured",
                hint: "Терпение народа тоже кончается.",
                told: "Пришли {prev_event} и {then_event}, а корона велела терпеть до урожая.",
                retold: [
                    "Худые лета, что начались в {prev_year} году, пережидали молча: корона не открыла амбаров, и мужики ели лебеду и кору до самого урожая.",
                    "Когда пришли {prev_event} и {then_event}, трон ничего не сделал, и в деревнях сложили горькую поговорку про короля и пустой котёл.",
                ],
            ),
