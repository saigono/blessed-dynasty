// Minimal start for stages 1-2: three provinces, one vassal, one neighbour.
// Stage 3 replaces the map with data/maps/default.ron.
(
    start_year: 1187,
    // Overrides of rules.ron defaults; unlisted axes start at their default.
    axes: {
        "legitimacy": 60,
        "treasury": 150,
    },
    map: (
        provinces: [
            (
                id: "capital",
                name: "Столица",
                income: 12,
                population: 20000,
                loyalty: 70,
                holder: Crown,
                buildings: ["fort"],
                neighbours: ["holm"],
            ),
            (
                id: "holm",
                name: "Хольм",
                income: 6,
                population: 9000,
                loyalty: 40,
                holder: Vassal("weir"),
                buildings: ["road"],
                neighbours: ["capital", "nordheim"],
            ),
            (
                id: "nordheim",
                name: "Нордхейм",
                income: 8,
                population: 11000,
                loyalty: 50,
                holder: Foreign("nordmark"),
                buildings: [],
                neighbours: ["holm"],
            ),
        ],
        // Points in 0..400 x 0..300; filled in by stage 3.
        polygons: {
            "capital": [],
            "holm": [],
            "nordheim": [],
        },
    ),
    capital: (province: "capital", crown_bonus: 20),
    vassals: [
        (id: "weir", name: "Вейр", provinces: ["holm"], loyalty: 55, strength: 20),
    ],
    factions: [
        (id: "nobles", loyalty: 50),
        (id: "church", loyalty: 55),
        (id: "people", loyalty: 45),
    ],
    ruler: (
        name: "Ульрих",
        age: 30,
        health: 80,
        traits: ["pious"],
        reign_start: 0,
    ),
    heirs: [
        (name: "Конрад", age: 8, ability: 50, claim: 70, status: Home),
        (name: "Агнесса", age: 5, ability: 55, claim: 40, status: Home),
    ],
    neighbours: [
        (id: "nordmark", name: "Нордмарк", relation: 0, strength: 40, stance: Wait),
    ],
)
