(
    // 1 = year, 4 = seasons, 12 = months. Durations in data are always in years.
    time_unit: (ticks_per_year: 1),

    // State axes: the world starts with `default`, a preset may override it. `name` is shown
    // in the UI.
    axes: [
        (id: "treasury", min: -1000, max: 10000, default: 100, name: "Казна"),
        (id: "income", min: -100, max: 1000, default: 10, name: "Доход"),
        (id: "army", min: 0, max: 1000, default: 50, name: "Армия"),
        (id: "legitimacy", min: 0, max: 100, default: 50, name: "Легитимность"),
        (id: "stability", min: 0, max: 100, default: 50, name: "Стабильность"),
        (id: "bureaucracy", min: 0, max: 100, default: 20, name: "Бюрократия"),
        (id: "loyalty_nobles", min: 0, max: 100, default: 50, name: "Знать"),
        (id: "loyalty_church", min: 0, max: 100, default: 50, name: "Церковь"),
        (id: "loyalty_people", min: 0, max: 100, default: 50, name: "Народ"),
        (id: "prestige", min: 0, max: 1000, default: 0, name: "Престиж"),
        // Derived from the faction axes, never written directly; the default is ignored.
        (id: "loyalty", min: 0, max: 100, default: 50, name: "Лояльность"),
    ],

    // Each faction's loyalty is its axis. `loyalty_axis` = weighted mean, rounded toward zero.
    factions: [
        (id: "nobles", axis: "loyalty_nobles", weight: 2),
        (id: "church", axis: "loyalty_church", weight: 1),
        (id: "people", axis: "loyalty_people", weight: 1),
    ],
    loyalty_axis: "loyalty",

    // Crown power of own provinces (foreign ones and those cut off from the capital get 0),
    // recomputed from scratch, never below 0:
    // base[holder] - (threshold - loyalty) * loyalty_penalty (only below threshold)
    // - path_cost * distance_penalty + buildings + capital.crown_bonus.
    // path_cost: cheapest path from the capital; a step into an own province costs 1, into
    // a neighbour's max(1, 1 + foreign_step_penalty - relation * foreign_step_relation).
    crown_power: (
        base: (crown: 60, vassal: 30),
        loyalty_threshold: 50,
        loyalty_penalty: 0.5,
        distance_penalty: 5,
        foreign_step_penalty: 1,
        foreign_step_relation: 0.02,
        buildings: {"fort": 10, "road": 5, "market": 2},
    ),

    // How many actions may run at once: the largest `slots` whose threshold the axis reached.
    action_slots: (axis: "bureaucracy", steps: [(0, 1), (40, 2), (70, 3)]),

    // Per year: treasury += income of crown provinces + sum(axis * coefficient).
    // Negative coefficients are upkeep.
    economy: (
        treasury: "treasury",
        flows: [("income", 1), ("army", -0.1)],
    ),

    // Per year: faction axes move by `step` toward their default, province loyalty toward
    // `province_loyalty`, crown power modifiers from effects toward 0.
    drift: (step: 1, province_loyalty: 50),

    // Weight of a quiet tick in the random event pick, next to the weights of the events.
    quiet_weight: 20,

    // Province loyalty below this shows as unrest on the map. Display only; below the
    // start loyalty of every own province (40 and up), between the sim triggers (30, 40).
    unrest_below: 35,

    // A newborn from HeirOp(Add).
    new_heir: (name: "Младенец", age: 0, ability: 50, claim: 50, status: Home),

    // Neighbour AI, once a year per neighbour. First its strength moves by `recover` toward
    // its start strength in the preset: losses to wars and tribute heal. Stance: relation
    // below `hostile_below` is Expand when strength >= the weakest crown power on the common
    // border + expand_margin, otherwise (or with no common border) Defend; above
    // `friendly_above` Trade; else Wait. Then relation moves by the stance's `relation` and
    // `drift` toward 0 (old grudges and friendships fade unless kept up), and one roll in
    // 0..100 picks at most one of its `events` (id, chance in percent per year; chances sum
    // to <= 100).
    // Events targeting a province hit the weakest border province and name the neighbour
    // as its second target; others target the neighbour.
    neighbour_ai: (
        hostile_below: -20,
        friendly_above: 30,
        expand_margin: 0,
        drift: 1,
        recover: 1,
        // `invasion` is a simulation event (events/sim/): the reign drops it as unknown.
        expand: (relation: -2, events: [
            ("neighbour_raid", 25), ("neighbour_ultimatum", 10), ("neighbour_war_declared", 5),
            ("invasion", 10),
        ]),
        defend: (relation: -1, events: [("neighbour_ultimatum", 10)]),
        trade: (relation: 1, events: [("neighbour_trade", 20)]),
        wait: (relation: 0, events: [("neighbour_trade", 5), ("neighbour_ultimatum", 3)]),
        // An event a neighbour starts joins the random pick with this weight, next to
        // quiet_weight and the weights of the pool events; not picked, it is dropped.
        weight: 50,
    ),

    // War, one at a time. StartWar queues `start_event` at the enemy at once.
    // Strength: ours = army * (1 + fort bonus per own fortified province on the enemy border
    // + sum(axis * k) of `bonus`) * treasury factor (treasury_poor at an empty treasury,
    // rising to 1 at treasury_full); theirs = the neighbour's strength.
    // Clash: each side's strength times a roll in `roll`; war_score += (ours - theirs) * score_k,
    // clamped to +-max_score. Tribute(v): treasury += v, the neighbour's strength -= v *
    // tribute_strength. EndWar(outcome): the enemy's strength changes by `end_strength`.
    war: (
        start_event: "war_declared",
        army: "army",
        fort: ("fort", 0.1),
        bonus: [("loyalty_nobles", 0.005)],
        treasury_full: 100,
        treasury_poor: 0.6,
        roll: (0.5, 1.5),
        score_k: 0.5,
        max_score: 100,
        tribute_strength: 0.1,
        end_strength: [(Victory, -10), (Draw, 0), (Defeat, 5)],
    ),

    // Effect Grant: the nearest vassal within `max_distance` border crossings gets the
    // province, otherwise a new house named by the next unused name of names.ron `vassals`,
    // with this loyalty and strength; when the names run out, the nearest vassal at any distance.
    grant: (max_distance: 1, new_loyalty: 60, new_strength: 10),

    // Yearly ruler death risk in per mille: the `base` row of the largest age_from <= age,
    // plus (100 - health) * health_k, plus every risk whose `when` holds. A hit spawns the
    // death event; the ruler dies only if the choice says so. While a death event is on
    // its cooldown, its risk does not count.
    death: (
        base: [(0, 4), (40, 8), (50, 30), (55, 60), (60, 90), (65, 130), (70, 180), (80, 300)],
        health_k: 0.2,
        event: "illness",
        risks: [
            (when: WarStage(Fighting), per_mille: 30, event: "war_wound"),
            (when: Flag("plot"), per_mille: 60, event: "assassination"),
            (when: Flag("plague"), per_mille: 40, event: "illness"),
        ],
    ),

    // Game::abdicate fires `event`; its Abdicate effect ends the reign. Unless the
    // institutions axis and the first heir's ability are above their thresholds, the first
    // heir loses `claim_drop` of claim and `contested_flag` is set (succession_dispute).
    abdication: (
        event: "abdication",
        institutions: ("bureaucracy", 60),
        heir_ability: 60,
        claim_drop: 40,
        contested_flag: "succession_contested",
    ),

    // Per year. Ability grows by status until adult_age. Claims move by claim_step toward
    // the target of the current law: eldest (heirs[0]) or others, plus ability * ability_k;
    // a hostage also loses hostage_claim. Birth chance in percent by ruler age, times
    // `unmarried` without the married flag. The ruler's children (World.line_from) stand
    // first, in birth order, then the collateral line; "eldest" is heirs[0].
    // `death`: yearly risk of every heir in per mille by age, like death.base.
    heirs: (
        adult_age: 16,
        growth_home: 2,
        growth_studying: 3.5,
        growth_hostage: 1,
        hostage_claim: -4,
        claim_step: 2,
        laws: [
            (flag: "law_primogeniture", eldest: 75, others: 35, ability_k: 0),
            (flag: "law_elective", eldest: 0, others: 0, ability_k: 0.9),
            (flag: "law_none", eldest: 50, others: 50, ability_k: 0),
        ],
        crisis_claim: 70,
        birth: [(0, 0), (16, 25), (35, 20), (45, 15), (55, 10), (65, 5)],
        married_flag: "married",
        unmarried: 0.2,
        death: [(0, 120), (1, 40), (5, 15), (16, 10), (30, 15), (40, 20), (50, 30), (55, 60), (60, 90), (65, 130), (70, 180), (80, 300)],
    ),

    // The dynasty after the founder (sim::run): the same rules year by year, the choices
    // made by sim::AutoChooser, until a fall or `max_years` from tick 0.
    // Falls: no heir, the capital not held by the crown, `usurped_flag`, no crown province.
    sim: (
        max_years: 300,
        // Events of this importance and above go to the chronicle; a new ruler and a
        // province lost or gained always do, with importance `notable`.
        threshold: 4,
        notable: 5,
        // Every player decision marks what it changed with weight 1; the weight is
        // multiplied by `decay` every year. Chronicle entries collect these marks as causes.
        decay: 0.97,
        // The hint of the main cause shows in the entry from this weight on: the founder's
        // decisions fade from the chronicle along with their marks.
        hint_weight: 0.3,
        usurped_flag: "usurped",
        // A ruler younger than regency_age reigns under the flag until he reaches it.
        regency_flag: "regency",
        regency_age: 16,
        ruler_health: 80,
        // Relation of the state a seceding vassal founds (Effect::Secede).
        secession_relation: -50,
        // Trait chance of a new ruler in percent: percent + ability * ability_k, plus
        // `studying` or `hostage` by the heir's status.
        traits: [
            (id: "greedy", percent: 35, ability_k: -0.3, studying: 0, hostage: 10),
            (id: "cautious", percent: 10, ability_k: 0.3, studying: 10, hostage: 15),
            (id: "warlike", percent: 30, ability_k: 0, studying: -15, hostage: 10),
            (id: "pious", percent: 10, ability_k: 0, studying: 35, hostage: -5),
        ],
        // AutoChooser: an option scores sum(weight[key] * amount) over its effects, plus a
        // roll in 0..=noise. Keys: axis ids, flag ids (+1 set, -1 cleared) and effect kinds:
        // province_income, province_population, province_loyalty, health, relation,
        // crown_power, heir_ability, heir_claim (by the delta); build, grant, revoke, secede,
        // war, hostage, death, abdicate (+1); province (+1 gained, -1 given); heir (+1, -1).
        // Weights of the ruler's traits add to `base`.
        auto: (
            noise: 10,
            base: {
                "treasury": 0.3, "income": 2, "army": 0.3, "legitimacy": 1, "stability": 1,
                "bureaucracy": 0.5, "loyalty_nobles": 0.6, "loyalty_church": 0.4,
                "loyalty_people": 0.5, "prestige": 0.3,
                "province_income": 2, "province_population": 0.005, "province_loyalty": 0.2,
                "health": 0.5, "relation": 0.1, "crown_power": 0.5,
                "build": 3, "grant": -20, "revoke": -3, "secede": -10, "war": -10, "hostage": -10,
                "death": -500, "abdicate": -500, "province": 20, "heir": 60,
                "heir_ability": 0.3, "heir_claim": 0.2,
                "usurped": -22, "plot": -20, "plague": -20,
            },
            traits: {
                "greedy": {"treasury": 0.3, "income": 2, "province_income": 2},
                "cautious": {"war": -20, "army": 0.3, "stability": 1, "health": 1},
                "warlike": {"war": 25, "army": 0.4, "prestige": 0.7, "province": 20},
                "pious": {"loyalty_church": 1.2},
            },
        ),
        // (title, text) of the entries the simulation makes itself. Rulers of either sex:
        // no gendered verb with {ruler}, and names stay in the nominative (they do not decline).
        texts: (
            crowned: ("Новое правление", "Престол наследует {ruler}."),
            province_lost: ("Потеря земли", "Земля {province} потеряна, ею владеет {neighbour}."),
            province_gained: ("Земля возвращена", "Земля {province} отошла к короне. Прежний владелец: {neighbour}."),
            // The heir first in line died of age risk (heirs.death).
            heir_died: ("Смерть наследника", "Не стало первого в очереди на престол: {heir}."),
            // What ended a reign (a RulerDies cause or the abdication event id) and the dynasty,
            // as shown to the player.
            reign_ends: {
                "illness": "болезнь",
                "assassination": "убийство",
                "war_wound": "рана на войне",
                "abdication": "отречение",
            },
            // The subject is the dynasty (feminine): «89 лет на троне · пала от узурпации».
            falls: [
                (NoHeir, "пресеклась без наследника"),
                (CapitalLost, "пала с потерей столицы"),
                (Usurped, "пала от узурпации"),
                (NoCrownLand, "распалась на уделы"),
                (Alive, "правит до сих пор"),
            ],
        ),
    ),
)
