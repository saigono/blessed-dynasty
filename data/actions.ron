// Map actions (stage 3), the war (stage 4) and the stage 2 test action. Stage 9 adds the rest,
// stage 14 the actions of a war going on.
[
    // The succession law is a flag of rules.ron `heirs.laws`; one action per law. While it
    // runs, `yearly` is the resistance of a faction; done, the flag of the law replaces the
    // others. Claims then follow the new law year by year. Not while the throne is contested.
    (
        id: "change_succession_law_primogeniture",
        description: "Ввести закон о престоле: престол старшему ребёнку, сыну или дочери. Знать противится, пока закон вводят.",
        name: "Ввести закон «Абсолютное первородство»",
        duration_years: 3,
        cost: 60,
        requires: All([NotFlag("law_primogeniture"), NotFlag("succession_contested")]),
        min_crown_power: 40,
        target: None,
        yearly: [Axis("loyalty_nobles", -2)],
        on_complete: [ClearFlag("law_male"), ClearFlag("law_salic"), ClearFlag("law_seniority"), ClearFlag("law_elective"), ClearFlag("law_partition"), SetFlag("law_primogeniture"), Axis("loyalty_church", 3), Axis("loyalty_nobles", -3)],
        cause_tag: "succession_law_primogeniture",
    ),
    (
        id: "change_succession_law_male",
        description: "Ввести закон о престоле: престол старшему сыну, дочери только без сыновей. Знать ворчит, пока закон вводят.",
        name: "Ввести закон «Мужское первородство»",
        duration_years: 2,
        cost: 45,
        requires: All([NotFlag("law_male"), NotFlag("succession_contested")]),
        min_crown_power: 40,
        target: None,
        yearly: [Axis("loyalty_nobles", -1)],
        on_complete: [ClearFlag("law_primogeniture"), ClearFlag("law_salic"), ClearFlag("law_seniority"), ClearFlag("law_elective"), ClearFlag("law_partition"), SetFlag("law_male"), Axis("loyalty_church", 2)],
        cause_tag: "succession_law_male",
    ),
    (
        id: "change_succession_law_salic",
        description: "Ввести закон о престоле: престол только мужчинам. Церковь противится, пока закон вводят.",
        name: "Ввести закон «Салический закон»",
        duration_years: 2,
        cost: 45,
        requires: All([NotFlag("law_salic"), NotFlag("succession_contested")]),
        min_crown_power: 40,
        target: None,
        yearly: [Axis("loyalty_church", -2)],
        on_complete: [ClearFlag("law_primogeniture"), ClearFlag("law_male"), ClearFlag("law_seniority"), ClearFlag("law_elective"), ClearFlag("law_partition"), SetFlag("law_salic"), Axis("loyalty_nobles", 3), Axis("loyalty_church", -2)],
        cause_tag: "succession_law_salic",
    ),
    (
        id: "change_succession_law_seniority",
        description: "Ввести закон о престоле: престол старшему в роду, братья прежде сыновей. Церковь противится, пока закон вводят.",
        name: "Ввести закон «Лествичное право»",
        duration_years: 3,
        cost: 60,
        requires: All([NotFlag("law_seniority"), NotFlag("succession_contested")]),
        min_crown_power: 40,
        target: None,
        yearly: [Axis("loyalty_church", -2)],
        on_complete: [ClearFlag("law_primogeniture"), ClearFlag("law_male"), ClearFlag("law_salic"), ClearFlag("law_elective"), ClearFlag("law_partition"), SetFlag("law_seniority"), Axis("loyalty_nobles", 3), Axis("stability", -3)],
        cause_tag: "succession_law_seniority",
    ),
    (
        id: "change_succession_law_elective",
        description: "Ввести закон о престоле: наследника избирает совет из самых способных. Церковь противится, пока закон вводят.",
        name: "Ввести закон «Выборный закон»",
        duration_years: 3,
        cost: 60,
        requires: All([NotFlag("law_elective"), NotFlag("succession_contested")]),
        min_crown_power: 40,
        target: None,
        yearly: [Axis("loyalty_church", -2)],
        on_complete: [ClearFlag("law_primogeniture"), ClearFlag("law_male"), ClearFlag("law_salic"), ClearFlag("law_seniority"), ClearFlag("law_partition"), SetFlag("law_elective"), Axis("loyalty_nobles", 5), Axis("legitimacy", -3)],
        cause_tag: "succession_law_elective",
    ),
    (
        id: "change_succession_law_partition",
        description: "Ввести закон о престоле: корона старшему сыну, младшим — уделы. Церковь противится, пока закон вводят.",
        name: "Ввести закон «Разделение»",
        duration_years: 2,
        cost: 45,
        requires: All([NotFlag("law_partition"), NotFlag("succession_contested")]),
        min_crown_power: 40,
        target: None,
        yearly: [Axis("loyalty_church", -2)],
        on_complete: [ClearFlag("law_primogeniture"), ClearFlag("law_male"), ClearFlag("law_salic"), ClearFlag("law_seniority"), ClearFlag("law_elective"), SetFlag("law_partition"), Axis("loyalty_nobles", 5), Axis("stability", -3)],
        cause_tag: "succession_law_partition",
    ),
    (
        id: "build_fort",
        description: "Крепость укрепляет власть короны в провинции и помогает в войне, если стоит на границе с врагом. Гарнизон съедает часть дохода.",
        name: "Построить крепость",
        duration_years: 4,
        cost: 120,
        requires: All([]),
        min_crown_power: 30,
        target: Province((holder: Crown, without_building: "fort")),
        on_complete: [Build(EventTarget, "fort"), Province(EventTarget, Income, -1)],
        cause_tag: "fort_built",
    ),
    (
        id: "build_road",
        description: "Дорога связывает провинцию со столицей: власть короны там крепнет, торговля приносит чуть больше дохода.",
        name: "Проложить дорогу",
        duration_years: 2,
        cost: 60,
        requires: All([]),
        min_crown_power: 20,
        target: Province((holder: Crown, without_building: "road")),
        on_complete: [Build(EventTarget, "road"), Province(EventTarget, Income, 1)],
        cause_tag: "road_built",
    ),
    (
        id: "build_market",
        description: "Рынок даёт провинции доход и радует народ.",
        name: "Открыть рынок",
        duration_years: 3,
        cost: 90,
        requires: All([]),
        min_crown_power: 20,
        target: Province((holder: Crown, without_building: "market")),
        on_complete: [
            Build(EventTarget, "market"),
            Province(EventTarget, Income, 2),
            Axis("loyalty_people", 2),
        ],
        cause_tag: "market_built",
    ),
    (
        // The crown power drop comes from the vassal base in the crown power formula.
        id: "grant_province",
        description: "Отдать провинцию ближайшему вассалу или новому дому. Знать довольна, но власть короны там слабеет, а окрепший вассал однажды может восстать.",
        name: "Пожаловать провинцию",
        duration_years: 1,
        cost: 0,
        requires: All([]),
        min_crown_power: 20,
        target: Province((holder: Crown, capital: false)),
        on_complete: [Grant(EventTarget), Axis("loyalty_nobles", 8)],
        cause_tag: "province_granted",
    ),
    (
        id: "revoke_province",
        description: "Вернуть провинцию вассала короне. Знать и сама провинция будут недовольны.",
        name: "Отобрать провинцию",
        duration_years: 1,
        cost: 30,
        requires: All([]),
        min_crown_power: 20,
        target: Province((holder: Vassal)),
        on_complete: [
            Revoke(EventTarget),
            Axis("loyalty_nobles", -15),
            Province(EventTarget, Loyalty, -10),
        ],
        cause_tag: "province_revoked",
    ),
    (
        id: "marry_neighbour",
        description: "Посвататься к соседнему двору: жених или невеста — неженатый правитель, а если он женат, первый неженатый наследник от 14 лет. Двор соглашается с шансом, который растёт с отношениями, престижем и силой короны; в войне и во вражде сватов не принимают. Согласие: отношения растут, двор становится роднёй, пока жив супруг и нет войны. Отказ стоит престижа.",
        bond: "брачный союз",
        name: "Заключить брачный союз",
        duration_years: 1,
        cost: 75,
        requires: All([]),
        min_crown_power: 0,
        target: Neighbour,
        on_complete: [Marry(
            then: [Relation(EventTarget, 30), Axis("prestige", 5)],
            otherwise: [Relation(EventTarget, -5), Axis("prestige", -5), SpawnEvent("marriage_refused", 0)],
        )],
        cause_tag: "neighbour_married",
    ),
    (
        // Open to an heir unwed and of marriage.age (Game::available_actions), only in war:
        // war events take the year's event, and heir_marriage with it. In peace heirs wed
        // through heir_marriage (stage 18: cheap, the action wed them all at 14 before it).
        id: "marry_heir",
        description: "Женить наследника или выдать наследницу замуж в дом своего барона. Дети от брака законны и наследуют престол.",
        name: "Женить наследника",
        duration_years: 0,
        cost: 20,
        requires: AtWar,
        min_crown_power: 0,
        target: Heir,
        on_complete: [HeirOp(TargetMarry)],
        cause_tag: "heir_wed",
    ),
    (
        // Over the law: heirs.designate_penalty, unless the heir named is the rightful one.
        id: "designate_heir",
        description: "Назвать наследника своей волей, а не по закону. Если закон ставит первым другого, легитимность, знать и церковь сразу недовольны, обойдённый сохраняет претензию, и при воцарении престол оспорят вероятнее.",
        name: "Назначить наследника",
        duration_years: 0,
        cost: 50,
        requires: All([]),
        min_crown_power: 0,
        target: Heir,
        on_complete: [HeirOp(TargetDesignate)],
        cause_tag: "heir_designated",
    ),
    (
        id: "recognize_bastard",
        description: "Признать старшего из бастардов своим: он встанет в очередь на престол после всех законных наследников, с низкой претензией. Церковь недовольна, а если он взойдёт на трон, легитимность будет низкой.",
        name: "Признать бастарда",
        duration_years: 0,
        cost: 30,
        requires: BastardCount(1, 99),
        min_crown_power: 0,
        target: None,
        on_complete: [HeirOp(Recognize), Axis("loyalty_church", -10)],
        cause_tag: "bastard_recognized",
    ),
    (
        id: "royal_progress",
        description: "Объехать владения: государя видят, легитимность и знать немного растут.",
        name: "Объехать владения",
        duration_years: 1,
        cost: 30,
        requires: AxisBelow("legitimacy", 90),
        min_crown_power: 0,
        target: None,
        on_complete: [Axis("legitimacy", 3), Axis("loyalty_nobles", 2)],
        cause_tag: "royal_progress",
    ),
    (
        // Starts the war chain of events/war.ron at once; one war at a time. The target is
        // the enemy province the war is fought for: victory takes it (ProvinceTarget WarTarget).
        id: "declare_war",
        description: "Начать войну за пограничную провинцию соседа: выберите её на карте или из списка, победа отдаст её короне. Пока идёт война, доход короны ниже. Война с другом ославит вас предателем.",
        name: "Объявить войну",
        duration_years: 0,
        cost: 20,
        requires: Not(AtWar),
        min_crown_power: 0,
        target: Province((holder: Foreign, borders_realm: true)),
        // War on a friend (relation above neighbour_ai.friendly_above) earns a name for
        // treachery: prestige and every other neighbour's trust drop.
        on_complete: [
            IfFriendly([Axis("prestige", -15), OtherRelations(-10)]),
            StartWar(EventTarget),
            Relation(EventTarget, -30),
            Axis("loyalty_people", -3),
        ],
        cause_tag: "war_declared_by_crown",
    ),
    // While a war goes on (not yet at its terms of peace), against its enemy.
    (
        id: "war_recruit",
        description: "Деньги превращаются в солдат: армия сразу растёт. Большую армию содержать дорого, и в мирные годы она тоже ест казну.",
        name: "Набрать войско",
        duration_years: 0,
        cost: 60,
        requires: All([AtWar, Not(WarStage(Peace))]),
        min_crown_power: 0,
        target: Enemy,
        on_complete: [Axis("army", 20)],
        cause_tag: "war_recruit",
    ),
    (
        id: "war_battle",
        description: "Битва вне очереди: счёт войны сдвинется в пользу сильнейшего. Войско несёт потери.",
        name: "Дать сражение",
        duration_years: 0,
        cost: 10,
        requires: All([AtWar, Not(WarStage(Peace))]),
        min_crown_power: 0,
        target: Enemy,
        on_complete: [Clash, Axis("army", -5)],
        cause_tag: "war_battle",
    ),
    (
        // The terms follow the war score now: the outcome event whose `when` fits fires.
        id: "war_peace_talks",
        description: "Мир на условиях нынешнего счёта войны: при перевесе враг уступит цель войны, при равенстве разойдутся на прежних границах, при неудаче условия диктует враг.",
        name: "Переговоры о мире",
        duration_years: 0,
        cost: 30,
        requires: All([AtWar, Not(WarStage(Peace))]),
        min_crown_power: 0,
        target: Enemy,
        on_complete: [SetWarStage(Peace), SpawnEvent("war_victory", 0), SpawnEvent("war_defeat", 0), SpawnEvent("war_draw", 0)],
        cause_tag: "war_peace_talks",
    ),
    (
        // Long but sure: no roll against the enemy, only the field army must hold the field.
        // Not the event war_siege («Осада крепости») of the chain: this is the crown's own
        // siege, ended by the card war_siege_won («{war_target} пала»), which signs the peace.
        // `{war_target}` in the name is the province the war is fought for (UI).
        id: "war_siege_target",
        description: "Обложить провинцию, за которую идёт война, и взять её измором: два года и серебро на припасы. Если к концу осады войско держит поле (счёт войны выше нуля), провинция сдаётся и враг подписывает мир.",
        name: "Обложить {war_target}",
        duration_years: 2,
        cost: 60,
        requires: All([AtWar, Not(WarStage(Peace))]),
        min_crown_power: 0,
        target: Enemy,
        on_complete: [Chance((
            percent: 0,
            bonus: [(WarScoreAbove(0), 100)],
            then: [TransferProvince(WarTarget, Crown), Axis("prestige", 10), Relation(EventTarget, -20), SetWarStage(Peace), SpawnEvent("war_siege_won", 0)],
        ))],
        cause_tag: "war_siege_target",
    ),
]
