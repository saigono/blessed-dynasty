// «Наследник угасшего дома»: корона по праву, но без поддержки. Средняя сложность.
// The map lives in data/maps/default.ron: load with `Preset::load_with_map`.
// Weir holds holm and weir, Arden holds arden and mar (see the map).
(
    start_year: 1187,
    // Overrides of rules.ron defaults; unlisted axes start at their default.
    axes: {
        "legitimacy": 45,
        "stability": 55,
        "loyalty_nobles": 40,
        "loyalty_church": 60,
        "loyalty_people": 50,
        "bureaucracy": 20,
        "treasury": 150,
        // Above the axis minimum, so a war on a friend can cost prestige from the start.
        "prestige": 20,
    },
    capital: (province: "capital", crown_bonus: 20),
    vassals: [
        (id: "weir", name: "Вейр", loyalty: 55, strength: 6),
        (id: "arden", name: "Арден", loyalty: 50, strength: 4),
    ],
    ruler: (
        name: "Ульрих",
        age: 32,
        health: 80,
        traits: ["pious"],
        reign_start: 0,
        sex: Male,
    ),
    heirs: [
        (name: "Конрад", age: 6, ability: 50, claim: 70, status: Home, sex: Male),
    ],
    // Nordmark hostile, Purpur neutral, Vestrum friendly (rules.ron neighbour_ai thresholds).
    neighbours: [
        (id: "nordmark", name: "Нордмарк", relation: -40, strength: 60, stance: Defend),
        (id: "purpur", name: "Пурпуляндия", relation: 0, strength: 70, stance: Wait),
        (id: "vestrum", name: "Веструм", relation: 40, strength: 45, stance: Trade),
        // Stage 28: the buffers to the south, the edge of the world in the north-east and the
        // empire beyond them, hostile and bent on conquest (its colour on the map is its own).
        (id: "zudmark", name: "Зюдмарк", relation: 20, strength: 40, stance: Trade),
        (id: "olkhovia", name: "Ольховия", relation: 10, strength: 40, stance: Wait),
        (id: "tavrika", name: "Таврика", relation: 0, strength: 40, stance: Wait),
        (id: "kadar", name: "Кадарская империя", relation: -30, strength: 150, stance: Expand, color: Some((150, 46, 52))),
    ],
    // The succession law and the ruler's marriage.
    flags: ["law_primogeniture", "married"],
    // Stage 26: every neighbour a kingdom of its own, played by our rules (realm.rs). Each starts
    // as we do but for what it sets: house, capital, ruler, heirs, flags (the succession law,
    // the ruler's marriage), axes over ours, vassals and their lands (`fiefs`). `us`: the
    // holder of our land in their worlds. Since stage 27 they know each other (`relations`: old feuds).
    realms: Some((
        us: "kingdom",
        // Stage 27: a kingdom founded later: a vassal that broke away (his house on the throne)
        // or a new house on a fallen throne (only the ruler and heirs; the kingdom keeps its
        // axes and laws). Names from names.ron; a new state is armed as an old one, but poorer.
        founded: Some((
            ruler: (name: "", age: 34, health: 75, traits: [], reign_start: 0, sex: Male),
            heirs: [
                (name: "", age: 12, ability: 50, claim: 70, status: Home, sex: Male),
                (name: "", age: 9, ability: 50, claim: 40, status: Home, sex: Female),
            ],
            flags: ["law_primogeniture", "married"],
            axes: {"army": 70, "treasury": 80, "legitimacy": 50, "stability": 55, "bureaucracy": 20},
        )),
        kingdoms: [
            // Warlike and old-fashioned: the eldest of the house inherits.
            (
                id: "nordmark",
                house: "Эрлинги",
                capital: "nordheim",
                ruler: (name: "Харальд", age: 48, health: 70, traits: ["warlike"], reign_start: 0, sex: Male),
                heirs: [
                    (name: "Сигурд", age: 24, ability: 55, claim: 70, status: Home, sex: Male),
                    (name: "Хельга", age: 19, ability: 50, claim: 40, status: Home, sex: Female),
                ],
                flags: ["law_seniority", "married"],
                // Old feuds over the northern marches (stage 27).
                relations: {"vestrum": -25, "purpur": -30},
                axes: {"army": 70, "legitimacy": 75, "stability": 65, "loyalty_nobles": 60, "loyalty_people": 55, "bureaucracy": 35, "treasury": 200, "prestige": 60},
            ),
            // Rich and orderly, a queen on the throne by absolute primogeniture.
            (
                id: "purpur",
                house: "Аргириды",
                capital: "amaran",
                ruler: (name: "Феофано", age: 39, health: 75, traits: ["pious"], reign_start: 0, sex: Female),
                heirs: [
                    (name: "Иоанн", age: 15, ability: 60, claim: 70, status: Home, sex: Male),
                    (name: "Ирина", age: 12, ability: 55, claim: 40, status: Home, sex: Female),
                ],
                flags: ["law_primogeniture", "married"],
                axes: {"treasury": 400, "bureaucracy": 50, "army": 55, "stability": 70, "loyalty_nobles": 60, "loyalty_church": 70, "loyalty_people": 55, "legitimacy": 80, "prestige": 80},
                vassals: [(id: "melissin", name: "Мелиссин", loyalty: 55, strength: 5)],
                fiefs: {"kirm": "melissin"},
                relations: {"nordmark": -25},
            ),
            // A merchant land whose council elects the ablest of the house.
            (
                id: "vestrum",
                house: "Вестинги",
                capital: "sundal",
                ruler: (name: "Годфрид", age: 55, health: 65, traits: ["cautious"], reign_start: 0, sex: Male),
                heirs: [
                    (name: "Арнульф", age: 30, ability: 50, claim: 60, status: Home, sex: Male),
                    (name: "Матильда", age: 26, ability: 65, claim: 60, status: Home, sex: Female),
                ],
                flags: ["law_elective", "married"],
                axes: {"treasury": 350, "bureaucracy": 45, "army": 60, "stability": 65, "loyalty_nobles": 60, "loyalty_people": 60, "legitimacy": 80, "prestige": 70},
                relations: {},
            ),
            // Stage 28. The western buffer: a march of knights on the old southern road.
            (
                id: "zudmark",
                house: "Ротбарты",
                capital: "zudgard",
                ruler: (name: "Бертольд", age: 41, health: 75, traits: ["cautious"], reign_start: 0, sex: Male),
                heirs: [
                    (name: "Генрих", age: 17, ability: 55, claim: 70, status: Home, sex: Male),
                    (name: "Агнесса", age: 13, ability: 50, claim: 40, status: Home, sex: Female),
                ],
                flags: ["law_male", "married"],
                relations: {"vestrum": 20},
                axes: {"army": 55, "legitimacy": 75, "stability": 65, "loyalty_nobles": 60, "loyalty_people": 55, "bureaucracy": 30, "treasury": 200, "prestige": 40},
            ),
            // The eastern buffer: forest princes between the river and the hills.
            (
                id: "olkhovia",
                house: "Ольговичи",
                capital: "olkhov",
                ruler: (name: "Ростислав", age: 36, health: 80, traits: ["pious"], reign_start: 0, sex: Male),
                heirs: [
                    (name: "Мстислав", age: 12, ability: 50, claim: 70, status: Home, sex: Male),
                    (name: "Людмила", age: 9, ability: 55, claim: 40, status: Home, sex: Female),
                ],
                flags: ["law_primogeniture", "married"],
                relations: {},
                axes: {"army": 55, "legitimacy": 75, "stability": 65, "loyalty_nobles": 60, "loyalty_church": 65, "bureaucracy": 30, "treasury": 200, "prestige": 40},
            ),
            // The edge of the world: merchant towns on the north-eastern coast.
            (
                id: "tavrika",
                house: "Гаврасы",
                capital: "surozh",
                ruler: (name: "Евстафий", age: 44, health: 75, traits: ["greedy"], reign_start: 0, sex: Male),
                heirs: [
                    (name: "Елена", age: 22, ability: 60, claim: 70, status: Home, sex: Female),
                    (name: "Бальдуин", age: 18, ability: 50, claim: 40, status: Home, sex: Male),
                ],
                flags: ["law_primogeniture", "married"],
                relations: {},
                axes: {"army": 55, "legitimacy": 75, "stability": 65, "loyalty_nobles": 55, "loyalty_people": 60, "bureaucracy": 35, "treasury": 300, "prestige": 50},
            ),
            // The empire: vast and warlike, its land beyond the crown's reach, its marches held
            // by strong governors on the brink of breaking away, an old emperor whose brother
            // and sons will dispute the throne by the law of seniority. `auto`: the weights its
            // every ruler adds to the automaton's (rules.ron sim.auto): war is its custom.
            (
                id: "kadar",
                house: "Аскариды",
                capital: "kadar_city",
                ruler: (name: "Тигран", age: 54, health: 65, traits: ["warlike"], reign_start: 0, sex: Male),
                heirs: [
                    (name: "Ашот", age: 47, ability: 55, claim: 65, status: Home, sex: Male),
                    (name: "Смбат", age: 26, ability: 50, claim: 60, status: Home, sex: Male),
                    (name: "Гагик", age: 19, ability: 60, claim: 45, status: Home, sex: Male),
                ],
                flags: ["law_seniority", "married"],
                axes: {"army": 150, "treasury": 250, "legitimacy": 50, "stability": 35, "loyalty_nobles": 35, "loyalty_people": 40, "bureaucracy": 15, "prestige": 120},
                vassals: [
                    (id: "sklir", name: "Склир", loyalty: 30, strength: 25),
                    (id: "bardan", name: "Бардан", loyalty: 35, strength: 20),
                ],
                fiefs: {"zeitun": "sklir", "samosa": "sklir", "merv": "bardan"},
                relations: {"zudmark": -40, "olkhovia": -40, "tavrika": -40, "purpur": -30, "vestrum": -20},
                auto: {"war": 15},
            ),
        ],
    )),
    intro: "1187 год. Старый королевский дом угас, и корона по праву крови перешла к Ульриху, дальнему родичу последнего короля. Право на его стороне, поддержки почти нет: знать держится настороже, а бароны Вейр и Арден правят своими землями сами. С севера грозит враждебный Нордмарк, на востоке выжидает сильная Пурпуляндия, на западе дружбы ищет Веструм. За южными рубежами лежат малые Зюдмарк и Ольховия, а за ними, за горами, раскинулась Кадарская империя: земель у неё больше, чем её наместники способны удержать, войско огромно, а старый император Тигран снова точит меч. Купцы с юга говорят, что братья и сыновья императора уже делят его престол. У Ульриха пока один наследник, шестилетний сын Конрад.",
)
