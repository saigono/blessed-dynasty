// End of the reign. Death events are spawned by the death roll (rules.ron `death`), never
// from the random pool (weight 0). A failed rescue applies RulerDies; a rescue gives part
// of the health back, and the event's cooldown keeps its risk off for a while.
[
    (
        id: "illness",
        image: "sickbed",
        title: "Тяжёлый недуг",
        text: "{ruler} третий день в жару и не встаёт с постели. Лекари шепчутся у дверей, монахи служат молебны в дворцовой часовне, а в приёмной ждут гонцы, которых некому принять.",
        texts: [
            "Ночью у {ruler.род} открылся жар, и к утру {ruler:он|она} уже никого не {ruler:узнавал|узнавала}. Лекарь пускает кровь, духовник не отходит от изголовья, и двор говорит вполголоса.",
            "Болезнь пришла с осенней сыростью: кашель, озноб, тяжёлое дыхание. {ruler} лежит за задёрнутым пологом, а по коридорам дворца уже ходят слухи о наследнике.",
        ],
        texts_when: [
            (RulerAge(60, 200), "Старое тело сдаёт. {ruler} {ruler:слёг|слегла} с горячкой, и лекари, пряча глаза, говорят, что в такие годы эта хворь редко отпускает."),
        ],
        when: All([]),
        weight: 0,
        once: false,
        cooldown_years: 3,
        importance: 3,
        target: None,
        choices: [
            (
                text: "Позвать лучших лекарей, не считая денег",
                effects: [
                    RulerHealth(-25),
                    Axis("treasury", -60),
                    Chance((
                        percent: 60,
                        then: [RulerHealth(15)],
                        otherwise: [RulerDies("illness")],
                    )),
                ],
                cause_tag: "illness_doctors",
                hint: "Золото покупает время, но не всегда.",
                told: "Когда {ruler} {ruler:слёг|слегла} в горячке, к постели созвали всех лекарей королевства и ещё двоих из-за моря, а казначей только вздыхал, подписывая счета.",
                retold: [
                    "Лекари сменяли друг друга у королевского ложа днём и ночью: пускали кровь, жгли травы, поили {ruler.вин} отварами на вине, и за каждый день платили золотом.",
                    "Хворь свалила {ruler.вин} с первыми холодами, и казна не скупилась: при дворе поселились три лекаря, аптекарь и знаменитый врач из южных земель.",
                ],
            ),
            (
                text: "Молиться и уповать на Божью волю",
                effects: [
                    RulerHealth(-25),
                    Axis("loyalty_church", 5),
                    Chance((
                        percent: 40,
                        then: [RulerHealth(15)],
                        otherwise: [RulerDies("illness")],
                    )),
                ],
                cause_tag: "illness_prayer",
                hint: "Церковь не забудет смирения государя.",
                told: "Над постелью {ruler.род} читали псалтирь, в соборе не гасли свечи, и весь двор, от канцлера до поварят, ходил к вечерне.",
                retold: [
                    "Лекарей отослали: {ruler} {ruler:велел|велела} звать к себе только духовника и молиться, а там уж как Бог рассудит.",
                    "Пока {ruler} {ruler:лежал|лежала} в горячке, епископ служил молебны о здравии, и в каждом приходе королевства звонили к молитве.",
                ],
            ),
            (
                text: "Править из постели, не показывая слабости",
                effects: [
                    RulerHealth(-25),
                    Chance((
                        percent: 20,
                        then: [RulerHealth(10), Axis("prestige", 5)],
                        otherwise: [RulerDies("illness")],
                    )),
                ],
                cause_tag: "illness_ignored",
                hint: "Государь, правящий с одра, держит двор и в страхе, и в надежде.",
                told: "Даже в горячке {ruler} не {ruler:выпускал|выпускала} печати из рук: советников принимали у постели, указы подписывали дрожащей рукой.",
                retold: [
                    "{ruler} {ruler:запретил|запретила} говорить о болезни. Совет собирался в спальне, и голос из-за задёрнутого полога звучал так же твёрдо, как прежде.",
                    "Хворь {ruler} {ruler:назвал|назвала} пустяком и {ruler:правил|правила} с одра: послов принимали в полутёмной спальне, где пахло уксусом и травами.",
                ],
            ),
        ],
    ),
    (
        id: "assassination",
        image: "assassin",
        title: "Покушение",
        text: "Ночью в королевские покои пробрались люди с ножами. Стража подняла тревогу, но в коридорах темно, и не разобрать, кто здесь друг.",
        texts: [
            "Звон стали в галерее, крик часового, топот сапог. Кто-то открыл убийцам калитку в саду, и теперь они уже у дверей королевской спальни.",
            "Факел погас, и в темноте блеснули ножи. Убийцы пришли тихо, в ливреях дворцовых слуг, и стража поняла это слишком поздно.",
        ],
        texts_when: [
            (Flag("plot"), "Соглядатаи предупреждали о заговоре, и вот он пришёл сам. У дверей спальни {ruler.род} режут часовых, и голоса нападающих кажутся знакомыми."),
        ],
        when: All([]),
        weight: 0,
        once: false,
        cooldown_years: 2,
        importance: 5,
        target: None,
        choices: [
            (
                text: "Положиться на верных баронов",
                effects: [
                    Chance((
                        percent: 20,
                        axes: [("loyalty_nobles", 0.6)],
                        bonus: [(Flag("guard"), 25)],
                        then: [RulerHealth(-15), ClearFlag("plot"), Axis("loyalty_nobles", 3)],
                        otherwise: [RulerDies("assassination")],
                    )),
                ],
                cause_tag: "plot_nobles",
                hint: "Кто спас государя, тот потребует награды.",
                told: "В ночь покушения {ruler} {ruler:положился|положилась} на верных баронов: те подняли своих людей и встали стеной у дверей спальни.",
                retold: [
                    "Когда убийцы ворвались в покои, {ruler} {ruler:кликнул|кликнула} баронов, ночевавших во дворце, и те выбежали на шум в одних рубахах, но с мечами.",
                    "Ночные убийцы наткнулись в галерее на дружину барона, гостившего при дворе: его люди спали вполглаза и не выпускали оружия из рук.",
                ],
            ),
            (
                text: "Бежать потайным ходом",
                effects: [
                    Chance((
                        percent: 30,
                        axes: [("loyalty_nobles", 0.3)],
                        bonus: [(Flag("guard"), 25)],
                        then: [RulerHealth(-5), Axis("prestige", -10), Axis("legitimacy", -3)],
                        otherwise: [RulerDies("assassination")],
                    )),
                ],
                cause_tag: "plot_fled",
                hint: "Бегство спасает жизнь, но не честь.",
                told: "Ночью в покои пробрались убийцы, и {ruler} {ruler:бежал|бежала} потайным ходом, оставив корону на столике у кровати.",
                retold: [
                    "Услышав шаги в галерее, {ruler} {ruler:ушёл|ушла} через потайную дверь за гобеленом и до рассвета {ruler:просидел|просидела} в подвале среди винных бочек.",
                    "Убийцы нашли спальню пустой: {ruler} {ruler:бежал|бежала} подземным ходом к реке, и наутро при дворе шептались, что спасали шкуру, а не честь.",
                ],
            ),
            (
                text: "Встретить убийц с мечом в руке",
                effects: [
                    Chance((
                        percent: 15,
                        bonus: [(Flag("guard"), 25)],
                        then: [RulerHealth(-25), ClearFlag("plot"), Axis("prestige", 15)],
                        otherwise: [RulerDies("assassination")],
                    )),
                ],
                cause_tag: "plot_fought",
                hint: "Отвага у трона рождает легенды, если хватит удачи.",
                told: "Ночью в покои пробрались убийцы, и {ruler} {ruler:встретил|встретила} их на пороге с мечом в руке.",
                retold: [
                    "{ruler} не {ruler:стал|стала} звать стражу: {ruler:схватил|схватила} со стены старый меч и {ruler:вышел|вышла} к убийцам в одной рубахе.",
                    "В ту ночь {ruler} {ruler:бился|билась} с убийцами сам, при свете опрокинутой лампы, и кровь потом долго не могли отмыть с половиц.",
                ],
            ),
        ],
    ),
    (
        id: "war_wound",
        image: "wounded-king",
        title: "Рана в бою",
        text: "Сеча была жаркой: копьё вошло {ruler.дат} в бок, и {ruler} едва держится в седле. Оруженосцы выносят {ruler:его|её} с поля на щитах.",
        texts: [
            "Стрела пробила кольчугу у самого плеча. Рана горячая и чёрная по краям, полевой лекарь качает головой, а войско у шатра ждёт вестей.",
            "Под {ruler.тв} убили коня, и в свалке {ruler:его|её} задели мечом. В шатре душно от людей, и все смотрят на бледное лицо на походной постели.",
        ],
        when: AtWar,
        weight: 0,
        once: false,
        cooldown_years: 2,
        importance: 5,
        target: None,
        choices: [
            (
                text: "Везти в столицу к лекарям",
                effects: [
                    RulerHealth(-30),
                    Axis("treasury", -40),
                    Chance((
                        percent: 55,
                        then: [RulerHealth(15)],
                        otherwise: [RulerDies("war_wound")],
                    )),
                ],
                cause_tag: "wound_doctors",
                hint: "Войско без государя воюет осторожнее.",
                told: "{ruler} {ruler:получил|получила} тяжёлую рану в сече, и {ruler:его|её} повезли в столицу к лекарям на телеге, устланной соломой.",
                retold: [
                    "Раненого вождя трое суток везли в столицу по разбитым дорогам, и войско осталось стоять лагерем без {ruler.род}.",
                    "Столичные лекари вынимали из раны {ruler.род} обломок наконечника, а полки тем временем ждали вестей и не смели трогаться с места.",
                ],
            ),
            (
                text: "Остаться при войске, несмотря на рану",
                effects: [
                    RulerHealth(-30),
                    Axis("army", 10),
                    Chance((
                        percent: 35,
                        then: [RulerHealth(10), Axis("prestige", 10)],
                        otherwise: [RulerDies("war_wound")],
                    )),
                ],
                cause_tag: "wound_stayed",
                hint: "Войско помнит государя, что проливал кровь вместе с ним.",
                told: "{ruler} {ruler:получил|получила} тяжёлую рану в сече, но не {ruler:покинул|покинула} войска.",
                retold: [
                    "С перевязанным боком {ruler} каждое утро {ruler:выходил|выходила} к кострам, и солдаты, видя это, держались крепче.",
                    "Рану {ruler} {ruler:велел|велела} перевязать прямо в шатре и наотрез {ruler:отказался|отказалась} уезжать: войско должно видеть своего вождя.",
                ],
            ),
        ],
    ),
    (
        // Old age (rules.ron death.risks, from 70): its own cooldown, so it adds to illness
        // instead of waiting for it, and few rulers live past 80.
        id: "old_age",
        image: "old-king",
        title: "Старость",
        text: "{ruler} слабеет с каждой зимой. Днём подолгу дремлет у камина, путает имена советников и всё чаще зовёт к себе духовника.",
        texts: [
            "Руки у {ruler.род} дрожат так, что печать теперь ставит канцлер. Старые раны ноют к непогоде, а лекари советуют меньше вина и больше покоя.",
            "Зима выдалась долгой, и {ruler} почти не выходит из покоев. При дворе уже считают, сколько лет наследнику, и гадают, что будет весной.",
        ],
        when: All([]),
        weight: 0,
        once: false,
        cooldown_years: 2,
        importance: 3,
        target: None,
        choices: [
            (
                text: "Не жалеть денег на лекарей и травников",
                effects: [
                    Axis("treasury", -40),
                    Chance((
                        percent: 50,
                        then: [RulerHealth(-10)],
                        otherwise: [RulerDies("old_age")],
                    )),
                ],
                cause_tag: "old_age_doctors",
                hint: "Лекари выигрывают зиму, но не годы.",
                told: "Старость брала своё, и ко двору звали лекарей и травников, не жалея денег; всю зиму в покоях {ruler.род} пахло шалфеем и воском.",
                retold: [
                    "Для {ruler.род} выписали из-за моря лекаря, который пользовал трёх королей, и тот по часам поил {ruler:его|её} отварами из корней.",
                    "Казна платила за каждую лишнюю зиму {ruler.род}: травники, пиявки, нагретые камни к ногам и молебны о долгоденствии.",
                ],
            ),
            (
                text: "Готовить душу и наследника к концу",
                effects: [
                    Axis("loyalty_church", 3),
                    Axis("legitimacy", 3),
                    Chance((
                        percent: 35,
                        then: [RulerHealth(-10)],
                        otherwise: [RulerDies("old_age")],
                    )),
                ],
                cause_tag: "old_age_prepared",
                hint: "Государь, заранее назвавший преемника, оставил двору меньше споров.",
                told: "{ruler} {ruler:слабел|слабела} с каждой зимой и {ruler:готовил|готовила} душу к смерти, а наследника к престолу.",
                retold: [
                    "Чувствуя, что дни сочтены, {ruler} {ruler:исповедался|исповедалась} и {ruler:стал|стала} брать наследника в совет, чтобы бароны привыкали к новому лицу.",
                    "В последние зимы {ruler} {ruler:раздал|раздала} долги, {ruler:помирился|помирилась} со старыми врагами и подолгу {ruler:говорил|говорила} с наследником о делах королевства.",
                ],
            ),
            (
                text: "Держать двор, как прежде",
                effects: [
                    Chance((
                        percent: 25,
                        then: [RulerHealth(-15), Axis("prestige", 3)],
                        otherwise: [RulerDies("old_age")],
                    )),
                ],
                cause_tag: "old_age_ignored",
                hint: "Старый государь не дал двору увидеть свою слабость.",
                told: "{ruler} {ruler:слабел|слабела} с каждой зимой, но {ruler:держал|держала} двор, как прежде: пиры, охоты, приёмы послов.",
                retold: [
                    "Наперекор лекарям {ruler} и в старости {ruler:выезжал|выезжала} на соколиную охоту и {ruler:сидел|сидела} на пирах до полуночи.",
                    "О старости при {ruler.пр} говорить не смели: двор жил по-прежнему, и только лекари знали, чего стоит {ruler.дат} каждый выход к гостям.",
                ],
            ),
        ],
    ),
    (
        // Fired by Game::abdicate only.
        id: "abdication",
        image: "abdication",
        title: "Отречение",
        text: "{ruler} объявляет совету, что слагает корону. Бароны переглядываются, канцлер роняет перо, и в зале так тихо, что слышно, как трещат свечи.",
        texts: [
            "{ruler} снимает с пальца перстень с печатью и кладёт его на стол совета. Корона тяжела, говорят эти руки, пусть её несёт кто помоложе.",
            "Слух опередил указ: {ruler} хочет оставить престол. Наследник бледен, бароны прикидывают, кто выиграет от перемены, а епископ ждёт, когда спросят его.",
        ],
        when: All([]),
        weight: 0,
        once: false,
        cooldown_years: 0,
        importance: 5,
        target: None,
        choices: [
            (
                text: "Сложить корону и отречься",
                effects: [SetFlag("abdicated"), Axis("loyalty_nobles", -5), Abdicate],
                cause_tag: "abdication",
                hint: "Корона, снятая при жизни, ложится на голову наследника тяжелее.",
                told: "{ruler} {ruler:объявил|объявила} совету, что слагает корону, и {ruler:отрёкся|отреклась} от престола.",
                retold: [
                    "При всём дворе {ruler} {ruler:снял|сняла} корону и {ruler:положил|положила} её на подушку перед наследником, а наутро {ruler:уехал|уехала} из столицы.",
                    "Отречение {ruler.род} скрепили печатью и огласили на площадях, и бароны впервые за много лет не знали, кому теперь кланяться.",
                ],
            ),
            (
                text: "Передумать и остаться на престоле",
                effects: [Axis("legitimacy", -2)],
                cause_tag: "abdication_cancelled",
                hint: "Слух о несостоявшемся отречении долго ходит по двору.",
                told: "{ruler} {ruler:объявил|объявила} было совету об отречении, но {ruler:передумал|передумала}, и бароны запомнили эти колебания.",
                retold: [
                    "Указ об отречении так и не подписали: {ruler} {ruler:порвал|порвала} его у всех на глазах, но слово уже было сказано.",
                    "Три дня двор жил в ожидании нового государя, а на четвёртый {ruler} {ruler:вышел|вышла} к совету в короне, будто ничего и не было.",
                ],
            ),
        ],
    ),
]
