// Stage 26c: compound events. Two events of a kind within a window of years (`FiredWithin`)
// open a third that recalls them: {prev_event} and {prev_year} the earlier cause (its
// `recalled` phrase and year), {then_event} and {then_year} the later one. At most one event
// fires a tick, so a story comes after both its causes. The cooldown outlasts the window, so
// one pair of causes tells one story. The last two draw on simulation events only.
[
    (
        id: "story_year_of_sorrow",
        image: "mourning",
        title: "Год скорби",
        text: "Город не успел оправиться: сначала {prev_event}, а следом {then_event}. Вдов на улицах больше, чем торговок, колокола звонят по мёртвым каждое утро, и люди уже зовут это время годом скорби.",
        texts: [
            "Беды идут по столице одна за другой: {prev_event} в {prev_year} году, {then_event} в {then_year}. На воротах половины домов чёрные ленты, а горожане спрашивают у трона, за что им такое.",
            "Горожане считают свои беды по пальцам и сбиваются со счёта. {prev_event} и {then_event} прошли по столице почти подряд, и теперь в соборе служат заупокойные обедни без перерыва.",
        ],
        when: All([FiredWithin("cap_fire", 5), Any([FiredWithin("cap_plague", 5), FiredWithin("dis_pestilence", 5)])]),
        weight: 30,
        once: false,
        cooldown_years: 10,
        importance: 3,
        sign: Bad,
        target: None,
        choices: [
            (
                text: "Объявить по всей стране траур",
                effects: [Axis("loyalty_people", 4), Axis("loyalty_church", 3), Axis("treasury", -10)],
                cause_tag: "sorrow_mourning",
                hint: "Общее горе сплачивает, если его разделить.",
                told: "После того как {prev_event} и {then_event} одна беда за другой прошли по столице, {ruler} {ruler:объявил|объявила} траур по всей стране.",
                retold: [
                    "Год скорби королевство встретило в чёрном: по слову {ruler.род} смолкли пиры и турниры, и всюду служили панихиды по жертвам, что унесли {prev_event} и {then_event}.",
                    "{ruler} {ruler:вышел|вышла} к народу в трауре и {ruler:стоял|стояла} с горожанами на панихиде, и столица, где только что прошли {prev_event} и {then_event}, это запомнила.",
                ],
            ),
            (
                text: "Простить столице подати на год",
                effects: [Province(Capital, Loyalty, 8), Axis("treasury", -25)],
                cause_tag: "sorrow_tax_relief",
                hint: "Казна похудеет, зато город поднимется быстрее.",
                told: "По столице подряд прошли {prev_event} и {then_event}, и {ruler} {ruler:простил|простила} ей подати на год.",
                retold: [
                    "В год скорби мытари не появлялись в столице: корона простила подати городу, где только что прошли {prev_event} и {then_event}.",
                    "Горожанам, у которых едва миновали {prev_event} и {then_event}, дали год без податей, и на эти деньги они хоронили мёртвых и отстраивали дома.",
                ],
            ),
            (
                text: "Не прерывать дел и праздников двора",
                effects: [Axis("loyalty_people", -5), Axis("prestige", 2)],
                cause_tag: "sorrow_ignored",
                hint: "Двор, пирующий среди могил, запоминают надолго.",
                told: "По столице прошли {prev_event} и {then_event}, а двор пировал как ни в чём не бывало, и горожане этого не простили.",
                retold: [
                    "В год скорби во дворце не погасили ни одной свечи: двор жил, будто {prev_event} и {then_event} случились в чужой стране.",
                    "Пока город хоронил тех, кого унесли {prev_event} и {then_event}, во дворце давали бал, и музыка была слышна на кладбище.",
                ],
            ),
        ],
    ),
    (
        id: "story_army_murmur",
        image: "defeat",
        title: "Ропот в войске",
        text: "Сперва {prev_event}, потом {then_event}, и войско не выдержало. В лагерях урезали пайку, жалованье задерживают, и у костров всё громче говорят, что воевать за пустой котёл никто не нанимался.",
        texts: [
            "Войско вернулось с войны битым, а дома его встретил голод: {prev_event}, потом {then_event}. Сотники доносят, что солдаты продают оружие за хлеб и поют дерзкие песни о короне.",
            "В казармах неспокойно. За плечами у солдат {prev_event}, перед глазами {then_event}, и ветераны вслух спрашивают, за что они проливали кровь.",
        ],
        when: All([FiredWithin("war_defeat", 6), Any([FiredWithin("dis_drought", 6), FiredWithin("prov_crop_failure", 6), FiredWithin("great_famine", 6)])]),
        weight: 30,
        once: false,
        cooldown_years: 12,
        importance: 3,
        sign: Bad,
        target: None,
        choices: [
            (
                text: "Выплатить войску жалованье из казны",
                effects: [Axis("treasury", -35), Axis("army", 5), Axis("loyalty_nobles", 2)],
                cause_tag: "murmur_paid",
                hint: "Сытый солдат верен, но кормить его дорого.",
                told: "После того как случились {prev_event} и {then_event}, войско роптало, и {ruler} {ruler:выплатил|выплатила} солдатам жалованье из казны.",
                retold: [
                    "Ропот в войске затих, когда казначей выкатил к лагерю бочонки с серебром: солдаты простили короне всё, что принесли {prev_event} и {then_event}.",
                    "Солдатам, хлебнувшим горя, когда пришли {prev_event} и {then_event}, выдали жалованье за полгода вперёд, и в лагерях снова пели не дерзкие песни, а походные.",
                ],
            ),
            (
                text: "Повесить зачинщиков ропота",
                effects: [Axis("army", -5), CrownPower(Capital, 2), Axis("loyalty_people", -3)],
                cause_tag: "murmur_hanged",
                hint: "Страх заменяет жалованье ненадолго.",
                told: "Войско роптало после того, как случились {prev_event} и {then_event}, и {ruler} {ruler:велел|велела} повесить зачинщиков перед строем.",
                retold: [
                    "Ропот в лагерях, где не могли забыть, как прошли {prev_event} и {then_event}, оборвали петлёй: зачинщиков повесили перед строем, и солдаты замолчали, но смотрели исподлобья.",
                    "Самых громких крикунов из войска вздёрнули на воротах казарм, и до новой войны о {prev_year} годе вслух больше не вспоминали.",
                ],
            ),
            (
                text: "Распустить часть войска по домам",
                effects: [Axis("army", -15), Axis("loyalty_people", 3), Axis("treasury", 10)],
                cause_tag: "murmur_disbanded",
                hint: "Распущенный солдат пашет, но меч не забывает.",
                told: "Войско роптало после того, как случились {prev_event} и {then_event}, и часть солдат распустили по домам, к плугу.",
                retold: [
                    "Половину полков отпустили по деревням, и вчерашние солдаты вернулись к пашне, унося с собой память о том, как прошли {prev_event} и {then_event}.",
                    "Когда после того, что принесли {prev_event} и {then_event}, войско зароптало, корона унимала его роспуском: лишние рты отправили домой, и в лагерях стало тише и просторнее.",
                ],
            ),
        ],
    ),
    (
        id: "story_heavenly_wrath",
        image: "heaven-wrath",
        title: "Кара небесная",
        text: "Проповедники на площадях связывают одно с другим: сперва {prev_event}, а следом {then_event}, и значит, небо карает королевство. Толпы слушают их с ужасом, а епископ требует от трона ответа.",
        texts: [
            "В церквях и на рынках говорят одно: {prev_event} в {prev_year} году и {then_event} в {then_year} пришли друг за другом не случайно. Люди постятся, бичуют себя и ищут виноватых.",
            "Королевство охватил страх божьего гнева. Старухи шепчут, что {prev_event} и {then_event} связаны, как кнут и рука, и по дорогам уже ходят толпы кающихся в рубищах.",
        ],
        when: All([Any([FiredWithin("fac_heresy", 8), FiredWithin("fac_heresy_spreads", 8), FiredWithin("schism", 8)]), Any([FiredWithin("cap_plague", 8), FiredWithin("dis_pestilence", 8), FiredWithin("disaster", 8)])]),
        weight: 30,
        once: false,
        cooldown_years: 12,
        importance: 3,
        sign: Bad,
        target: None,
        choices: [
            (
                text: "Повести страну покаянным крестным ходом",
                effects: [Axis("loyalty_church", 5), Axis("faith", 3), Axis("treasury", -15)],
                cause_tag: "wrath_penance",
                hint: "Покаяние утешает и сближает трон с алтарём.",
                told: "Народ увидел в том, что случились {prev_event} и {then_event}, божью кару, и {ruler} {ruler:повёл|повела} страну покаянным крестным ходом.",
                retold: [
                    "Босиком, с непокрытой головой {ruler} {ruler:шёл|шла} впереди крестного хода, и вся страна каялась вместе с троном в грехах, за которые, как верили, пришли {prev_event} и {then_event}.",
                    "Сорок дней по королевству шли покаянные ходы с хоругвями, отмаливая {prev_year} год и всё, что пришло за ним, и клир славил трон, взявший на себя грехи народа.",
                ],
            ),
            (
                text: "Объявить еретиков виновниками мора",
                effects: [Axis("faith", 4), Axis("loyalty_people", -4), Axis("legitimacy", -1)],
                cause_tag: "wrath_heretics_blamed",
                hint: "Названный виновник отводит гнев, но не гасит его.",
                told: "Корона назвала виновниками божьей кары еретиков: это из-за них, говорили с амвона, пришли {prev_event} и {then_event}, и гнев народа обрушился на их дома.",
                retold: [
                    "Виновных в божьей каре назвали с амвона: еретики, и толпы громили их дома, словно тем можно было отменить всё, что принесли {prev_event} и {then_event}.",
                    "{ruler} {ruler:позволил|позволила} проповедникам винить еретиков во всём, что принесли {prev_event} и {then_event}, и по городам запылали их дома.",
                ],
            ),
            (
                text: "Запретить проповеди о божьей каре",
                effects: [Axis("loyalty_church", -5), Axis("loyalty_people", 2)],
                cause_tag: "wrath_sermons_banned",
                hint: "Запрет успокаивает улицы и злит клир.",
                told: "Проповедникам запретили говорить, будто {prev_event} и {then_event} посланы небом в кару, и страх на улицах понемногу улёгся.",
                retold: [
                    "Указом короны смолкли проповеди о божьем гневе, хотя {prev_event} и {then_event} были ещё у всех на памяти, и клир ворчал, что трону важнее покой на улицах, чем спасение душ.",
                    "Бродячих пророков, кричавших, что {prev_event} и {then_event} суть знаки конца света, выслали из городов, и народ понемногу перестал ждать светопреставления.",
                ],
            ),
        ],
    ),
    (
        id: "story_lean_years",
        image: "famine",
        title: "Худые лета",
        text: "Земля не отдыхает от бед: {prev_event} в {prev_year} году, {then_event} в {then_year}. Амбары пусты второй год подряд, и старики говорят, что таких худых лет не помнят и их деды.",
        texts: [
            "Мужики считают худые лета: сперва {prev_event}, потом {then_event}. Семенное зерно съедено, скот продан, а весной сеять будет нечем.",
            "Беда пришла на поля дважды: {prev_event} и {then_event}. Хлеб на рынках втрое дороже прежнего, и хлеботорговцы придерживают зерно в ожидании новой цены.",
        ],
        when: All([FiredWithin("dis_drought", 5), Any([FiredWithin("dis_flood", 5), FiredWithin("prov_crop_failure", 5)])]),
